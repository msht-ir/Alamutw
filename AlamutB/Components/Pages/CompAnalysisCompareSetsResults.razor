@using System.Globalization
@using System.Threading.Tasks
@using AlamutB.Service
@using Microsoft.VisualBasic
@inject FeService feService
@inject NavigationManager Navman
@inject AppState appState
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using System.Text;

@if (!_hasFetched)
    {
    <_ScanSheets />
    }
else
    {
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-2 px-0">
            <MudCard Class="mx-0">
                <MudCardContent Style="background-color:rgba(245,245,245);">
                <h6 style="text-align:center;color:royalblue">Compare Sets</h6>
                <h6 style="text-align:center;"><span style="font-size:x-small;color:indianred">@appState.SetName </span></h6>
                <hr style="color:lightslategrey" />
                    <div class="d-flex justify-content-center align-items-center" style="margin-left:20px; width:300px;">
                        <table class="table table-borderless">
                            <tr>
                            <td> <span style="color:dimgray;font-weight:normal;"> set A </span></td>
                            <td> <span style="color:darkslategrey;font-weight:bold;"> @lstNetSpeciesListA.Count() </span></td>
                            </tr>
                            <tr>
                            <td> <span style="color:dimgray;font-weight:normal;"> set B </span></td>
                            <td> <span style="color:darkslategrey;font-weight:bold;"> @lstNetSpeciesListB.Count() </span></td>
                            </tr>
                            <tr>
                            <td> <span style="color:dimgray;font-weight:normal;"> set C </span></td>
                            <td> <span style="color:darkslategrey;font-weight:bold;"> @lstNetSpeciesListC.Count() </span></td>
                            </tr>
                        </table>
                    </div>
                <hr />
                    <div class="d-flex justify-content-center align-items-center" style="margin-left:20px; width:300px;">
                        <table class="table table-borderless">
                            <tr>
                            <td> <span style="color:dimgray;font-weight:normal;"> AuBuC </span></td>
                            <td> <span style="color:darkslategrey;font-weight:bold;"> @AuBuC </span></td>
                            </tr>
                            <tr>
                            <td> <span style="color:dimgray;font-weight:normal;"> AuB </span></td>
                            <td> <span style="color:darkslategrey;font-weight:bold;"> @AuB </span></td>
                            </tr>
                            <tr>
                            <td> <span style="color:dimgray;font-weight:normal;"> AuC </span></td>
                            <td> <span style="color:darkslategrey;font-weight:bold;"> @AuC </span></td>
                            </tr>
                            <tr>
                            <td> <span style="color:dimgray;font-weight:normal;"> BuC </span></td>
                            <td> <span style="color:darkslategrey;font-weight:bold;"> @BuC </span></td>
                            </tr>
                        </table>
                    </div>
                <hr />
                    <div class="d-flex justify-content-center align-items-center" style="margin-left:20px; width:300px;">
                        <table class="table table-borderless">
                            <tr>
                            <td> <span style="color:dimgray;font-weight:normal;"> AnBnC </span></td>
                            <td> <span style="color:darkslategrey;font-weight:bold;"> @AnBnC </span></td>
                            </tr>
                            <tr>
                            <td> <span style="color:dimgray;font-weight:normal;"> AnB </span></td>
                            <td> <span style="color:darkslategrey;font-weight:bold;"> @AnB </span></td>
                            </tr>
                            <tr>
                            <td> <span style="color:dimgray;font-weight:normal;"> AnC </span></td>
                            <td> <span style="color:darkslategrey;font-weight:bold;"> @AnC </span></td>
                            </tr>
                            <tr>
                            <td> <span style="color:dimgray;font-weight:normal;"> BnC </span></td>
                            <td> <span style="color:darkslategrey;font-weight:bold;"> @BnC </span></td>
                            </tr>
                        </table>
                    </div>

                @* FOOTER *@
                <hr style="color:royalblue;margin-top:40px" />
                @* ScrollToTop *@
                    <div class="d-flex justify-content-center">
                        <button class="btn btn-link pulse-hover" @onclick="OnClose">
                        <img src="/img/icoCancel.png" width="26" />
                        </button>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudContainer>
    }
<br />
<br />
@* <script>window.scrollToTop = () => { window.scrollTo({ top: 0, behavior: 'smooth' }); };</script> *@

@code {
    [Parameter]
    public List<wfoSpeciesId>? lstNetSpeciesListA
        {
        get; set;
        }
    [Parameter]
    public List<wfoSpeciesId>? lstNetSpeciesListB
        {
        get; set;
        }
    [Parameter]
    public List<wfoSpeciesId>? lstNetSpeciesListC
        {
        get; set;
        }
    [Parameter]
    public EventCallback<bool> OnAnalysisCompareSetsResultsClosed
        {
        get; set;
        }
    User user = new User();
    public bool _hasFetched = false;
    string _cmd = "";
    public int AuBuC = 0;  //count all species in A+B+C
    public int AnBnC = 0;  //count sharaed species by A,B,C
    public int AuB = 0;    //count all species in A+B
    public int AuC = 0;    //count all species in A+C
    public int BuC = 0;    //count all species in B+C
    public int AnB = 0;    //count shared species by A,B
    public int AnC = 0;    //count shared species by A,C
    public int BnC = 0;    //count shared species by B,C

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        appState.SetCmd("");
        user.UserId = Convert.ToInt32(appState.UserId);
        user.Username = appState.Username ?? "";
        await CalcSets ();
        _hasFetched = true;
        }
    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }
    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }
    //calcs
    public async Task CalcSets ()
        {
        // Null-safe locals
        var A = lstNetSpeciesListA ?? new List<wfoSpeciesId>();
        var B = lstNetSpeciesListB ?? new List<wfoSpeciesId>();
        var C = lstNetSpeciesListC ?? new List<wfoSpeciesId>();

        AuBuC = A.Concat(B).Concat(C).Select(x => x.AcceptedId).Distinct().Count();
        AuB = A.Concat(B).Select(x => x.AcceptedId).Distinct().Count();
        AuC = A.Concat(C).Select(x => x.AcceptedId).Distinct().Count();
        BuC = B.Concat(C).Select(x => x.AcceptedId).Distinct().Count();

        AnBnC = A.Select(x => x.AcceptedId).Distinct()
                 .Intersect(B.Select(x => x.AcceptedId).Distinct())
                 .Intersect(C.Select(x => x.AcceptedId).Distinct()).Count();
        AnB = A.Select(x => x.AcceptedId).Distinct()
                 .Intersect(B.Select(x => x.AcceptedId).Distinct()).Count();
        AnC = A.Select(x => x.AcceptedId).Distinct()
                 .Intersect(C.Select(x => x.AcceptedId).Distinct()).Count();
        BnC = B.Select(x => x.AcceptedId).Distinct()
                 .Intersect(C.Select(x => x.AcceptedId).Distinct()).Count();
        }
    //methods
    public string PersianDate (DateTimeOffset? dt)
        {
        if ((Convert.ToInt32(appState.UserTags) & 2) == 2)
            {
            return feService.ToPersianDate(dt.ToString());
            }
        else
            {
            return dt?.ToString("yyyy-MM-dd HH:mm");
            }
        }
    private async Task HandleModalClose ()
        {
        _hasFetched = false;
        _hasFetched = true;
        StateHasChanged();
        }
    private async Task OnClose ()
        {
        await OnAnalysisCompareSetsResultsClosed.InvokeAsync(true);
        }


    }
