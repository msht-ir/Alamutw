@using System.Globalization
@using System.Threading.Tasks
@using AlamutB.Service
@using Microsoft.VisualBasic
@inject FeService feService
@inject NavigationManager Navman
@inject AppState appState
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using System.Text;

@if (!_hasFetched)
    {
    <_ScanSheets />
    }
else
    {
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-2 px-0">
            <MudCard Class="mx-0">
                <MudCardContent Style="background-color:rgba(245,245,245);">
                <h6 style="text-align:center;color:royalblue">Compare Sets</h6>
                <h6 style="text-align:center;"><span style="font-size:x-small;color:indianred">@appState.SetName </span></h6>
                    <div class="d-flex justify-content-left">
                        <button class="btn btn-link pulse-hover" @onclick="OnClose">
                        <img src="/img/icoBack3.png" width="24" />
                        </button>
                    </div>
                <hr style="color:lightslategrey" />
                    <div class="d-flex justify-content-center align-items-center" style="margin-left:30px; width:90%;">
                        <table class="table table-borderless w-100">
                            <tr>
                            <th class="text-start"> <span style="color:darkslategrey;font-weight:bold;"> Species A x B </span></th>
                            <th class="text-start"> <span style="color:darkslategrey;font-weight:bold;"> a          </span></th>
                            <th class="text-start"> <span style="color:darkslategrey;font-weight:bold;"> b          </span></th>
                            <th class="text-start"> <span style="color:darkslategrey;font-weight:bold;"> c          </span></th>
                            <th class="text-start"> <span style="color:darkslategrey;font-weight:bold;"> d          </span></th>
                            <th class="text-start"> <span style="color:darkslategrey;font-weight:bold;"> chi2       </span></th>
                            <th class="text-start"> <span style="color:dimgray;font-weight:bold;">       result     </span></th>
                            </tr>
                        @foreach (AssociationResult rslt in lstAssociationResults)
                            {
                                <tr>
                                <td class="text-start"> <span style="color:darkslategrey;font-size:x-small;">@rslt.SpeciesAId x @rslt.SpeciesBId</span></td>
                                <td class="text-start"> <span style="color:darkslategrey;font-size:smaller;">@rslt.A</span></td>
                                <td class="text-start"> <span style="color:darkslategrey;font-size:smaller;">@rslt.B</span></td>
                                <td class="text-start"> <span style="color:darkslategrey;font-size:smaller;">@rslt.C</span></td>
                                <td class="text-start"> <span style="color:darkslategrey;font-size:smaller;">@rslt.D</span></td>
                                <td class="text-start"> <span style="color:darkslategrey;font-size:smaller;font-weight:bold;">@rslt.chi2 </span></td>
                                <td class="text-start"> <span style="color:indianred;font-size:smaller;">@rslt.result </span></td>
                                </tr>
                            }
                        </table>
                    </div>
                @* FOOTER *@
                <hr style="color:royalblue;margin-top:40px" />
                    <div class="d-flex justify-content-center">
                        <button class="btn btn-link pulse-hover" @onclick="OnClose">
                        <img src="/img/icoCancel.png" width="22" />
                        </button>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudContainer>
    }
<br />
<br />

@code {
    [Parameter]
    public List<Occurrence>? lstOccurrenceData
        {
        get; set;
        }
    [Parameter]
    public List<Dataset>? lstSelectedDatasets
        {
        get; set;
        }
    [Parameter]
    public List<wfoSpeciesId>? lstNetSpeciesListA
        {
        get; set;
        }
    [Parameter]
    public List<AssociationResult>? lstAssociationResults
        {
        get; set;
        }

    [Parameter]
    public EventCallback<bool> OnAnalysisAssociationResultsClosed
        {
        get; set;
        }
    User user = new User();
    public bool _hasFetched = false;
    int _cnt = 0;
    string _cmd = "";
    string _mode = "";
    public List<Species> lstSpecies = new List<Species>();
    public List<string> lstNetSpeciesListIds = new List<string>();
    public List<Dataset> lstDatasets = new List<Dataset>();
    public List<Occurrence> lstOccurenceData = new List<Occurrence>();

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        appState.SetCmd("");
        user.UserId = Convert.ToInt32(appState.UserId);
        user.Username = appState.Username ?? "";
        await ShowAssociationResults();
        _hasFetched = true;
        }
    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }
    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }
    //calcs
    private List<string> GetIds (List<wfoSpeciesId> list) =>
        list?.Select(x => x.AcceptedId).Distinct().ToList() ?? new List<string>();
    private async Task ShowAssociationResults ()
        {
        lstNetSpeciesListIds = GetIds(lstNetSpeciesListA);


        }
    //methods
    public string PersianDate (DateTimeOffset? dt)
        {
        if ((Convert.ToInt32(appState.UserTags) & 2) == 2)
            {
            return feService.ToPersianDate(dt.ToString());
            }
        else
            {
            return dt?.ToString("yyyy-MM-dd HH:mm");
            }
        }
    private async Task HandleModalClose ()
        {
        _hasFetched = false;
        _hasFetched = true;
        StateHasChanged();
        }
    private async Task OnClose ()
        {
        await OnAnalysisAssociationResultsClosed.InvokeAsync(true);
        }


    }
