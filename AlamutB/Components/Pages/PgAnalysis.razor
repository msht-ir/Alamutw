@page "/PgAnalysis"
@using System.Globalization
@using AlamutB.Service
@using System.Threading.Tasks
@inject FeService feService
@inject NavigationManager Navman
@inject AppState appState
@inject IJSRuntime JS
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<h5 style="text-align:center;padding-left:15px;">Analysis - <span style="font-size:smaller;text-align:center;color:indianred">@appState.UserNickname</span></h5>
<hr style="color:red" />
@if (!_hasFetched)
    {
    <_ScanSheets />
    }
else if (appState.Cmd == "cmdCreateNote")
    {
    <Modal_CreateNote />
    }
else
    {
        <div style="text-align: left; margin:10px;">
        <MudIconButton OnClick="BtnBack"
                       Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Title="Switchboard" />
        </div>
    <hr />
        <EditForm Model="user">
            <MudStack Row
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Start"
                  Style="width:980px;"
                  Breakpoint="Breakpoint.SmAndDown">
            @* Pannel Left *@
                <MudStack>
                <MudText Style="color:indianred;">Analyses</MudText>
                    <MudToggleGroup T="String"
                                SelectionMode="SelectionMode.SingleSelection"
                                @bind-Value="_analysis"
                                @bind-Value:after="() => BtnAnalysisSelected(_analysis)"
                                Color="Color.Primary"
                                CheckMark FixedContent Vertical>
                    <MudToggleItem Value=@("fvalue")
                                   Text="F-Value" />
                    <MudToggleItem Value=@("diversity")
                                   Text="Diversity" />
                    <MudToggleItem Value=@("floran")
                                   Text="FlorAn" />
                    <MudToggleItem Value=@("multivarfloran")
                                   Text="MultiFlorAn" />
                    <MudToggleItem Value=@("comparesets")
                                   Text="Compare Sets" />
                    <MudToggleItem Value=@("cooccurence")
                                   Text="Cooccurence" />
                    <MudToggleItem Value=@("climagraph")
                                   Text="ClimaGraph" />
                    <MudToggleItem Value=@("multivarcliman")
                                   Text="MultivarClimAn" />
                    <MudToggleItem Value=@("help")
                                   Text="Guid" />
                    </MudToggleGroup>
                </MudStack>
            @* Pannel Right *@
                <MudStack Style="width:740px;margin-top:30px">
                @if (_cmd == "help")
                    {
                    <CompInfoTech />
                    }
                else if ((_cmd == "fvalue") || (_cmd == "floran") || (_cmd == "diversity") || (_cmd == "comparesets") || (_cmd == "multivarfloran"))
                    {
                    <CompAnalysisSets OnSelectedSetsReceived="GetSelectedSetsFromComponent" />
                    }
                else if (_cmd == "cooccurence")
                    {
                    }
                else if ((_cmd == "climagraph") || (_cmd == "multivarcliman"))
                    {
                    }
                else if (_cmd == "")
                    {
                        <div class="d-flex justify-content-center">
                        <img src="/img/gifUserLogin.gif" width="52" />
                        </div>
                    }
                </MudStack>
            </MudStack>
        </EditForm>
    <br />
    <hr />
        <div class="gap-4" style="display: flex;  justify-content: center; align-items: center;">
        <MudIconButton OnClick="BtnBack"
                       Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Title="Switchboard" />
            <button class="btn btn-link pulse-hover" @onclick="ScrollToTop">
            <img src="/img/icoGotoTop2.png" width="32" />
            </button>
        </div>
    }
    <script>
    window.scrollToTop = () => { window.scrollTo({ top: 0, behavior: 'smooth' }); };
    </script>


@code {
    private string _analysis = "";
    User user = new User();

    public MudTextField<string> refFilterDatasets;
    List<Set> lstSelectedSets = new List<Set>();
    List<Dataset> lstSelectedDatasets = new List<Dataset>(); //is required? del it if not used in analyses
    List<Species> lstSelectedSpecies = new List<Species>();

    Set set = new Set();
    Dataset dataset = new Dataset();
    Species species = new Species();

    string _cmd = "";
    public bool _hasFetched = false;

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        if (Convert.ToInt32(appState.UserLoginStatus) != 1)
            {
            Navman.NavigateTo("/Login");
            }
        appState.SetCmd("");
        user.UserId = Convert.ToInt32(appState.UserId);
        user.Username = appState.Username;
        _hasFetched = true;
        }
    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }
    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }

    //btns
    public void BtnAnalysisSelected (string _analysisName)
        {
        _cmd = _analysisName;
        StateHasChanged();
        }

    //methods
    public string PersianDate (DateTimeOffset? dt)
        {
        if ((Convert.ToInt32(appState.UserTags) & 256) == 256)
            {
            return feService.ToPersianDate(dt.ToString());
            }
        else
            {
            return dt?.ToString("yyyy-MM-dd HH:mm");
            }
        }
    private async Task HandleModalClose ()
        {
        _hasFetched = false;
        //
        _hasFetched = true;
        StateHasChanged();
        }
    private void BtnCancel ()
        {
        _cmd = "";
        StateHasChanged();
        }
    public void BtnHelp ()
        {
        _cmd = _cmd == "help" ? "" : "help";
        StateHasChanged();
        }
    private async Task ScrollToTop ()
        {
        await JS.InvokeVoidAsync("scrollToTop");
        }
    public void BtnBack ()
        {
        Navman.NavigateTo("/Switchboard");
        }
    public async Task GetSelectedSetsFromComponent (List<Set> lstSelectedSets)
        {
        // foreach (Set set in lstSelectedSets)
        //     {
        //     Console.WriteLine($"- subset: {set.SelectedSubset} of SET: {set.SetName} ");
        //     }
        switch (_cmd)
            {
            case "fvalue":
                    {
                    Snackbar.Add($"selcted Sets received for fvalue!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            case "floran":
                    {
                    Snackbar.Add($"selcted Sets received for floran!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            case "diversity":
                    {
                    Snackbar.Add($"selcted Sets received for diversity!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            case "comparesets":
                    {
                    Snackbar.Add($"selcted Sets received for comparesets!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            case "multivarfloran":
                    {
                    Snackbar.Add($"selcted Sets received for multivarfloran!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            case "cooccurence":
                    {
                    Snackbar.Add($"selcted Sets received for cooccurence!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            case "climagraph":
                    {
                    Snackbar.Add($"selcted Sets received for climagraph!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            case "multivarcliman":
                    {
                    Snackbar.Add($"selcted Sets received for multivarcliman!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            default:
                    {
                    Snackbar.Add($"selcted Sets received for ??!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            }
        }
    }
