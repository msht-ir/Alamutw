@inherits LayoutComponentBase
@inject ProtectedSessionStorage sessionStorage
@inject AppState appState
@inject NavigationManager Navman

<div class="page">
        <div class="sidebar">
        @if (Navman.Uri.Contains("/Login"))
            {
            <NavMenuLogin />
            }
        else if (Navman.Uri.Contains("/Switchboard"))
            {
            <NavMenuSwitchboard />
            }
        else if (Navman.Uri.Contains("/PgTaxa"))
            {
            <NavMenuPgTaxa />
            }
        else if (Navman.Uri.Contains("/PgNotebooks"))
            {
            <NavMenuPgNotebooks />
            }
        else if (Navman.Uri.Contains("/PgStickyNotes"))
            {
            <NavMenuPgStickyNotes />
            }
        else if (Navman.Uri.Contains("/Pg"))
            {
            <NavMenuPgMisc />
            }
        else
            {
            <NavMenuDefault />
            }
        </div>
        <main>
        @* Required *@
        <MudThemeProvider />
        <MudPopoverProvider />
        @* Needed for dialogs *@
        <MudDialogProvider />
        @* Needed for snackbars *@
        <MudSnackbarProvider />

            <div class="top-row px-4">
            @if (appState.UserLoginStatus == 1)
                {
                <a href="/Login">Logout</a>
                }
            else
                {
                <a href="https://msht.ir">msht.ir</a>
                }
            </div>
            <article class="content px-4">
            @Body
            </article>
        </main>
    </div>
