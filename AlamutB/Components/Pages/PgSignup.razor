@page "/PgSignup"
@using AlamutB.Service
@using System.ComponentModel.DataAnnotations
@inject ProtectedSessionStorage sessionStorage
@inject NavigationManager Navman
@inject AppState appState
@inject FeService feService
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<br />
<div class="d-flex flex-column align-items-center justify-content-center text-center">
    <h4 style="color:royalblue">Signup your free Alamut account</h4>
        <EditForm Model="newUser" OnValidSubmit="BtnSignupNewUser" style="display: flex; flex-direction: column; justify-content: center; align-items: center;">
        <DataAnnotationsValidator></DataAnnotationsValidator>
        <ValidationSummary></ValidationSummary>
            <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                <MudCard Class="mx-auto">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                        <div style="text-align:left">
                        <br />
                        <span style="font-weight:bold;color:indianred">notice:</span><br />
                            <ul>
                                <li>
                                Your account will be created immediately.<br />
                                </li>
                                <li>
                                You can setup your own server, contact for guides if needed<br />
                                </li>
                                <li>
                                Use Alamut free for educational / personal purposes. <br />
                                </li>
                            </ul>
                            <div class="form-check form-check-inline" style="padding-top:8px;">
                            <input class="form-check-input"
                                   type="checkbox"
                                   checked="@checkAgree"
                                   @onchange="e => BtnAgree((bool) e.Value)" />
                                <label class="form-check-label"
                                   style="font-size: small; color: RoyalBlue;">
                                I agree
                                </label>
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        @if (_cmd == "agreed")
            {
            <h6 style="color:royalblue; margin-top:20px;">SIGN UP <span style="font-style:italic;color:gray"> (new user)</span></h6>
                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                    <MudCard Class="mx-auto">
                        <MudCardContent Style="background-color:rgba(249,249,249);">
                            <div class="mb-3">
                            <MudTextField @ref="refUsername"
                                          @bind-Value="newUser.Username"
                                          Label="username"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Class="my-textfield" />
                            </div>
                            <div class="mb-3">
                            <MudTextField @ref="refPassword"
                                          @bind-Value="newUser.Password"
                                          Label="password"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense" Autocomplete="off"
                                          Class="my-textfield"
                                          InputType="@PasswordInput"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@PasswordInputIcon"
                                          OnAdornmentClick="BtnShowPassword"
                                          AdornmentAriaLabel="Show Password" />
                            </div>
                            <div class="mb-3">
                            <MudTextField @ref="refRepeatPass"
                                          @bind-Value="newUser.RepeatPass"
                                          Label="repeat password"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense" Autocomplete="off"
                                          Class="my-textfield"
                                          InputType="@PasswordInput"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@PasswordInputIcon"
                                          OnAdornmentClick="BtnShowPassword"
                                          AdornmentAriaLabel="Show Password" />
                            </div>
                            <div style="color:indianred; text-align:left">
                            <ValidationSummary />
                            </div>
                        <hr />
                            <div class="mb-3">
                            <MudTextField @ref="refEmail"
                                          @bind-Value="newUser.Email"
                                          Label="email"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Class="my-textfield" />
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudContainer>
            }
            <div style="margin-top:40px;margin-bottom:25px;">
            @if (_cmd == "agreed")
                {
                <MudButton Variant="Variant.Filled"
                           EndIcon="@Icons.Material.Filled.CloudUpload"
                           Size="Size.Small"
                           OnClick="@(() => BtnSignupNewUser())"
                           Style="margin-right:20px">SIGN-UP </MudButton>
                }
            <MudButton Variant="Variant.Filled"
                       EndIcon="@Icons.Material.Filled.Help"
                       Size="Size.Small"
                       OnClick="@(() => BtnHelp())"
                       Style="margin-right:20px;color:forestgreen">Guide </MudButton>
            <MudButton Variant="Variant.Filled"
                       EndIcon="@Icons.Material.Filled.Cancel"
                       Size="Size.Small"
                       OnClick="@(() => BtnCancel())"
                       Style="color:indianred">Back </MudButton>
            </div>
        </EditForm>
    </div>
@if (_cmd == "guide")
    {
    <br />
    <CompInfoTech />
    <br />
        <div class="d-flex justify-content-center">
            <MudButton Variant="Variant.Filled"
                   EndIcon="@Icons.Material.Filled.CheckCircle"
                   Size="Size.Small"
                   OnClick="@(() => BtnAgree(true))"
                   Style="color:dimgray;">
            OK, Back
            </MudButton>
        </div>
    }

@code {
    bool isShow;
    bool checkAgree;
    string _cmd = "";
    InputType PasswordInput = InputType.Password;
    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
    private User user = new User();
    private bool _firstRender = true;
    private class NewUser
        {
        [Required(ErrorMessage = "enter username")]
        public string Username { get; set; } = "";
        [Required(ErrorMessage = "enter password")]
        public string Password { get; set; } = "";
        [Required(ErrorMessage = "repeat password")]
        public string RepeatPass { get; set; } = "";
        [Required(ErrorMessage = "enter email")]
        public string Email { get; set; } = "";
        }
    private NewUser newUser = new NewUser();
    int loginStatus = 0;
    private MudTextField<string>? refUsername;
    private MudTextField<string>? refPassword;
    private MudTextField<string>? refRepeatPass;
    private MudTextField<string>? refEmail;

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        newUser.Password = "";
        newUser.RepeatPass = "";
        newUser.Username = "";
        }
    protected override async Task OnAfterRenderAsync (bool firstRender)
        {
        if (_firstRender)
            {
            _firstRender = false;
            }
        }
    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }
    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }
    //btns
    public void BtnAgree (bool agree)
        {
        if (agree)
            {
            _cmd = "agreed";
            newUser.Username = "newuser";
            newUser.Password = "";
            newUser.RepeatPass = "";
            newUser.Email = "newUser@mail.com";
            checkAgree = true;
            }
        else
            {
            _cmd = "notagreed";
            checkAgree = false;
            }
        }
    void BtnShowPassword ()
        {
        @if (isShow)
            {
            isShow = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
            }
        else
            {
            isShow = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
            }
        }
    public async Task BtnSignupNewUser ()
        {
        if ((!checkAgree))
            {
            Snackbar.Add("read terms of use", Severity.Info);
            return;
            }
        if ((newUser.Password == newUser.RepeatPass) && (newUser.Password.Length > 3))
            {
            user.UserId = 1; //just to prevent errors
            user.Username = newUser.Username;
            user.Password = newUser.Password;
            user.UserNickname = newUser.Username;
            user.UserEmail = newUser.Email;
            user.UserTags = 1;
            bool result = await feService.Create_User(user);
            if (result)
                {
                var message = new MarkupString(@$"
                    <span style='color:indianred'>Your</span> account created! 
                    <br><br><ul>
                    <li>Please don't create repeatitive accounts. </li>
                    <li>Contact admin at mshtir@gmail.com for more info</li>
                    <br>
                    your email:<br>{user.UserEmail}<br><br><hr style=color:blue>
                    <span style='color:indianred'> You can login to </span> 
                    <strong>' {user.Username} '</strong> account now.
                    <hr style=color:blue>
                    ");
                bool? confirmResult = await DialogService.ShowMessageBoxAsync(title: "Alamut accounts", markupMessage: message, yesText: "OK");
                if (confirmResult == true)
                    {
                    Navman.NavigateTo("/Login");
                    Snackbar.Add("account created", Severity.Success);
                    BtnCancel();
                    }
                }
            else
                {
                Snackbar.Add($"failed to create account for: '{user.Username}'", Severity.Error, opt => { opt.VisibleStateDuration = 1500; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                }
            }
        else
            {
            Snackbar.Add("password error", Severity.Warning);
            }
        }
    public void BtnHelp ()
        {
        _cmd = (_cmd == "guide") ? "" : "guide";
        StateHasChanged();
        }
    public void BtnCancel ()
        {
        Navman.NavigateTo("/Login");
        }
    }
