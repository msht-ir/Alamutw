@code {
    [Parameter]
    public List<wfoSpeciesId>? lstNetSpeciesListA
        {
        get; set;
        }
    [Parameter]
    public List<wfoSpeciesId>? lstNetSpeciesListB
        {
        get; set;
        }
    [Parameter]
    public List<wfoSpeciesId>? lstNetSpeciesListC
        {
        get; set;
        }
    [Parameter]
    public EventCallback<bool> OnAnalysisCompareSetsResultsClosed
        {
        get; set;
        }
    User user = new User();
    public bool _hasFetched = false;
    int _cnt = 0;
    string _cmd = "";
    string _mode = "";
    public int AuBuC = 0;  //count all species in A+B+C
    public int AnBnC = 0;  //count sharaed species by A,B,C
    public int AuB = 0;    //count all species in A+B
    public int AuC = 0;    //count all species in A+C
    public int BuC = 0;    //count all species in B+C
    public int AnB = 0;    //count shared species by A,B
    public int AnC = 0;    //count shared species by A,C
    public int BnC = 0;    //count shared species by B,C
    public List<Species> lstSpecies = new List<Species>();

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        appState.SetCmd("");
        user.UserId = Convert.ToInt32(appState.UserId);
        user.Username = appState.Username ?? "";
        await CalcSets();
        _hasFetched = true;
        }
    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }
    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }
    //calcs
    public async Task CalcSets ()
        {
        // Null-safe locals
        var A = lstNetSpeciesListA ?? new List<wfoSpeciesId>();
        var B = lstNetSpeciesListB ?? new List<wfoSpeciesId>();
        var C = lstNetSpeciesListC ?? new List<wfoSpeciesId>();

        AuB = A.Concat(B).Select(x => x.AcceptedId).Distinct().Count();
        AuC = A.Concat(C).Select(x => x.AcceptedId).Distinct().Count();
        BuC = B.Concat(C).Select(x => x.AcceptedId).Distinct().Count();
        AuBuC = A.Concat(B).Concat(C).Select(x => x.AcceptedId).Distinct().Count();

        AnB = A.Select(x => x.AcceptedId).Distinct()
                 .Intersect(B.Select(x => x.AcceptedId).Distinct()).Count();
        AnC = A.Select(x => x.AcceptedId).Distinct()
                 .Intersect(C.Select(x => x.AcceptedId).Distinct()).Count();
        BnC = B.Select(x => x.AcceptedId).Distinct()
                 .Intersect(C.Select(x => x.AcceptedId).Distinct()).Count();
        AnBnC = A.Select(x => x.AcceptedId).Distinct()
                 .Intersect(B.Select(x => x.AcceptedId).Distinct())
                 .Intersect(C.Select(x => x.AcceptedId).Distinct()).Count();
        }
    public async Task ReportVannDiagram (string mode)
        {
        lstSpecies.Clear();
        List<string>? lstSpeciesIds = new();
        _mode = mode;
        _hasFetched = false;
        // Null-safe locals
        var A = lstNetSpeciesListA ?? new List<wfoSpeciesId>();
        var B = lstNetSpeciesListB ?? new List<wfoSpeciesId>();
        var C = lstNetSpeciesListC ?? new List<wfoSpeciesId>();
        switch (mode)
            {
            case "A":
                    {
                    lstSpeciesIds = A.Select(x => x.AcceptedId).Distinct().ToList();
                    lstSpecies = await feService.Read_SpeciesByListOfIds(lstSpeciesIds);
                    break;
                    }
            case "B":
                    {
                    lstSpeciesIds = B.Select(x => x.AcceptedId).Distinct().ToList();
                    lstSpecies = await feService.Read_SpeciesByListOfIds(lstSpeciesIds);
                    break;
                    }
            case "C":
                    {
                    lstSpeciesIds = C.Select(x => x.AcceptedId).Distinct().ToList();
                    lstSpecies = await feService.Read_SpeciesByListOfIds(lstSpeciesIds);
                    break;
                    }
            case "AuB":
                    {
                    lstSpeciesIds = A.Concat(B).Select(x => x.AcceptedId).Distinct().ToList();
                    lstSpecies = await feService.Read_SpeciesByListOfIds(lstSpeciesIds);
                    break;
                    }
            case "AuC":
                    {
                    lstSpeciesIds = A.Concat(C).Select(x => x.AcceptedId).Distinct().ToList();
                    lstSpecies = await feService.Read_SpeciesByListOfIds(lstSpeciesIds);
                    break;
                    }
            case "BuC":
                    {
                    lstSpeciesIds = B.Concat(C).Select(x => x.AcceptedId).Distinct().ToList();
                    lstSpecies = await feService.Read_SpeciesByListOfIds(lstSpeciesIds);
                    break;
                    }
            case "AuBuC":
                    {
                    lstSpeciesIds = A.Concat(B).Concat(C).Select(x => x.AcceptedId).Distinct().ToList();
                    lstSpecies = await feService.Read_SpeciesByListOfIds(lstSpeciesIds);
                    break;
                    }
            case "AnB":
                    {
                    lstSpeciesIds = A.Select(x => x.AcceptedId).Distinct()
                             .Intersect(B.Select(x => x.AcceptedId).Distinct()).ToList();
                    lstSpecies = await feService.Read_SpeciesByListOfIds(lstSpeciesIds);
                    break;
                    }
            case "AnC":
                    {
                    lstSpeciesIds = A.Select(x => x.AcceptedId).Distinct()
                             .Intersect(C.Select(x => x.AcceptedId).Distinct()).ToList();
                    lstSpecies = await feService.Read_SpeciesByListOfIds(lstSpeciesIds);
                    break;
                    }
            case "BnC":
                    {
                    lstSpeciesIds = B.Select(x => x.AcceptedId).Distinct()
                             .Intersect(C.Select(x => x.AcceptedId).Distinct()).ToList();
                    lstSpecies = await feService.Read_SpeciesByListOfIds(lstSpeciesIds);
                    break;
                    }
            case "AnBnC":
                    {
                    lstSpeciesIds = A.Select(x => x.AcceptedId).Distinct()
                             .Intersect(B.Select(x => x.AcceptedId).Distinct())
                             .Intersect(C.Select(x => x.AcceptedId).Distinct()).ToList();
                    lstSpecies = await feService.Read_SpeciesByListOfIds(lstSpeciesIds);
                    break;
                    }
            }
        lstSpecies = lstSpecies.OrderBy (x => x.SciName).ToList();
        _hasFetched = true;
        _cmd = "showvanndiagramspecieslist";
        }
    //methods
    public string PersianDate (DateTimeOffset? dt)
        {
        if ((Convert.ToInt32(appState.UserTags) & 2) == 2)
            {
            return feService.ToPersianDate(dt.ToString());
            }
        else
            {
            return dt?.ToString("yyyy-MM-dd HH:mm");
            }
        }
    private async Task HandleModalClose ()
        {
        _hasFetched = false;
        _hasFetched = true;
        StateHasChanged();
        }
    private async Task OnClose ()
        {
        await OnAnalysisCompareSetsResultsClosed.InvokeAsync(true);
        }


    }
