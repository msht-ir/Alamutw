@page "/PgSearch"
@using System.Globalization
@using AlamutB.Service
@using System.Threading.Tasks
@inject FeService feService
@inject NavigationManager Navman
@inject AppState appState
@inject IJSRuntime JS
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<style>
    .map-container {
        height: 700px; /* Leaflet needs a fixed height! */
        width: 100%;
        z-index: 0; /* Leaflet panes have high z-index; keep them below MudBlazor overlays */
    }
    </style>
@* HEADER *@
<h5 style="text-align:center;padding-left:15px;">Search</h5>
    <div class="d-flex" style="display: flex; flex-direction: column; justify-content: center; align-items: center;">
    @if (_accountType.Trim() == "admin account")
        {
        <p style="font-size:large;font-style:italic;color:royalblue">@appState.UserNickname <span style="font-style:normal;font-size:x-small;color:darkgoldenrod"> @_accountType</span></p>
        }
    else if (_accountType.Trim() == "gold account")
        {
        <p style="font-size:large;font-style:italic;color:royalblue">@appState.UserNickname <span style="font-style:normal;font-size:x-small;color:darkgoldenrod"> @_accountType</span></p>
        }
    else if (_accountType.Trim() == "silver account")
        {
        <p style="font-size:large;font-style:italic;color:royalblue">@appState.UserNickname <span style="font-style:normal;font-size:x-small;color:gray"> @_accountType</span></p>
        }
    else if (_accountType.Trim() == "demo account")
        {
        <p style="font-size:large;font-style:italic;color:royalblue">@appState.UserNickname <span style="font-style:normal;font-size:x-small;color:green"> @_accountType</span></p>
        }
    </div>
<hr style="color:red" />
@if (!_hasFetched)
    {
    <_Loading />
    }
else
    {
        <EditForm Model="lstNotes">
        @if (appState.Cmd == "ShowNoteInDialog")
            {
            <Modal_ShowNote OnClose="HandleModalClose" />
            }
        else
            {
            if (_cmd1 == "showCompAnalysisSetsToSelectOneSet")
                {
                @* SHOW COMPONENT TO SELECT A SETS *@
                <CompAnalysisSets AnalysisType="searchSpecies" OnSelectedSetsReceived="GetSelectedSetsFromComponent" />
                    <div class="d-flex gap-4 justify-content-center align-items-center" style="margin-top:5px;margin-bottom:15px;">
                    <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                   Color="Color.Dark"
                                   Size="Size.Medium"
                                   Style="margin-right:40px;"
                                   OnClick="BtnSearchInDatabase"
                                   Title="search species in all locations in database" />
                    </div>
                }
            else if (_cmd1 == "showCountriesListToSelectOneSet")
                {
                @* SHOW COUNTRIES TO SELECT ONE *@
                    <div class="d-flex gap-3">
                        <MudAutocomplete T="int"
                                     Label="country"
                                     SearchFunc="@SearchCountries"
                                     ToStringFunc="GetCountryName"
                                     ValueChanged="OnCountryChanged"
                                     Variant="Variant.Text"
                                     Margin="Margin.Dense"
                                     style="font-family:tahoma;font-size:small;color:royalblue;"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.List">
                            <ItemTemplate Context="countryId">
                                <span style="font-family:tahoma; font-size:small; display:block;">
                                @GetCountryName(countryId)
                                </span>
                            </ItemTemplate>
                        </MudAutocomplete>
                    <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                   Color="Color.Dark"
                                   Size="Size.Medium"
                                   Style="margin-right:40px;"
                                   OnClick="BtnSearchInDatabase"
                                   Title="search species in all locations in database" />

                    </div>
                }
            else
                {
                @* FILTER Btns*@
                    <div class="d-flex gap-4 justify-content-center align-items-center" style="margin-top:5px;margin-bottom:15px;">
                    <MudIconButton Icon="@Icons.Material.Filled.Rule"
                                   Color="Color.Primary"
                                   Size="Size.Medium"
                                   Style="margin-top:15px;"
                                   OnClick="BtnSelectOneSet"
                                   Title="select a set to search species in it" />
                    <MudIconButton Icon="@Icons.Material.Filled.PinDrop"
                                   Color="Color.Primary"
                                   Size="Size.Medium"
                                   Style="margin-top:15px;"
                                   OnClick="BtnSelectOneCountry"
                                   Title="select a country to search species in it" />
                    </div>
                <hr style="color:lightslategray" />
                <h6 style="color:indianred;text-align:center">@searchMode</h6>
                @* Species SEARCH BOX *@
                    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 px-0">
                        <MudCard Class="mx-auto">
                            <MudCardContent Style="background-color:rgba(249,249,249);">
                                <div class="d-flex align-content-center align-items-center">
                                <MudTextField T="string"
                                              @ref="refSearchSpecies"
                                              @bind-Value="_speciesSearchText"
                                              OnKeyDown="HandleKey_SearchboxSpecies"
                                              Label="search species"
                                              Variant="Variant.Text"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              OnAdornmentClick='()=>SearchSpecies(_speciesSearchText)'
                                              Style="font-family:Tahoma;"
                                              Class="my-textfield" />
                                @if (searchMode != "global search")
                                    {
                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                   Color="Color.Dark"
                                                   Size="Size.Medium"
                                                   Style="margin-top:15px;margin-right:30px;"
                                                   OnClick="BtnSearchInDatabase"
                                                   Title="Select all" />

                                    }
                                </div>
                            </MudCardContent>
                        </MudCard>
                    </MudContainer>
                @if (((user.UserTags & 128) == 128) || ((user.UserTags & 256) == 256)) //384=128+256(gold+su)
                    {
                    @* Characters SEARCH BOX *@
                        <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 px-0">
                            <MudCard Class="mx-auto">
                                <MudCardContent Style="background-color:rgba(249,249,249);">
                                    <div style="display:grid; grid-template-columns:1fr 1fr; column-gap:8px; row-gap:0;">
                                    <MudSwitch @bind-Value="_UPS10" Label="ME (medicinal)" Color="Color.Dark" Dense="true"
                                               Style="font-family:Tahoma;" title="گياهان دارويي" />
                                    <MudSwitch @bind-Value="_UPS09" Label="GS (gene source)" Color="Color.Dark" Dense="true"
                                               Style="font-family:Tahoma;" title="خويشاوندان وحشي گياهان زراعي" />
                                    <MudSwitch @bind-Value="_UPS08" Label="PO (poisons)" Color="Color.Dark" Dense="true"
                                               Style="font-family:Tahoma;" title="گياهان سمي" />
                                    <MudSwitch @bind-Value="_UPS07" Label="EU (environmental use)" Color="Color.Dark" Dense="true"
                                               Style="font-family:Tahoma;" title="کاربرد محيطي" />
                                    <MudSwitch @bind-Value="_UPS06" Label="MA (material)" Color="Color.Dark" Dense="true"
                                               Style="font-family:Tahoma;" title="مواد طبيعي" />
                                    <MudSwitch @bind-Value="_UPS05" Label="HF (human food)" Color="Color.Dark" Dense="true"
                                               Style="font-family:Tahoma;" title="غذاي انسان" />
                                    <MudSwitch @bind-Value="_UPS04" Label="AF (animal food)" Color="Color.Dark" Dense="true"
                                               Style="font-family:Tahoma;" title="غذاي دام" />
                                    <MudSwitch @bind-Value="_UPS03" Label="IF (invertebrate food)" Color="Color.Dark" Dense="true"
                                               Style="font-family:Tahoma;" title="غذاي بي مهرگان" />
                                    <MudSwitch @bind-Value="_UPS02" Label="FU (fuel)" Color="Color.Dark" Dense="true"
                                               Style="font-family:Tahoma;" title="سوخت" />
                                    <MudSwitch @bind-Value="_UPS01" Label="SU (social use)" Color="Color.Dark" Dense="true"
                                               Style="font-family:Tahoma;" title="کاربرد اجتماعي" />
                                    </div>                                    <MudButton Variant="Variant.Filled"
                                                                                 EndIcon="@Icons.Material.Filled.Search"
                                                                                 Size="Size.Small"
                                                                                 Style="margin:10px;width:200px;"
                                                                                 OnClick="@(() => SarchSpeciesByUPS())">
                                Search
                                </MudButton>
                            <br />
                            </MudCardContent>
                        </MudCard>
                    </MudContainer>
                }
            }
        @* SHOW MAP *@
        @if (_cmd1 == "showmap")
            {
            <br />
            <div id="mapup-container" class="map-container"></div>
            <hr style="color:red;margin-top:10px;" />
                <div style="text-align: center;margin-top:10px;">
                    <MudButton Variant="Variant.Filled"
                           EndIcon="@Icons.Material.Filled.Clear"
                           Size="Size.Small"
                           OnClick="@(() => BtnCancel())"
                           Style="color:indianred;padding-left:60px;padding-right:60px">
                    Close Map
                    </MudButton>
                </div>
            }
        else
            {
            @if ((lstSpecies.Count > 0) || (lstDatasetData.Count > 0))
                {
                    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-0">
                        <MudCard Class="mx-0">
                            <MudCardContent Style="background-color:rgb(245,245,245);">
                            @if (_SpeciesListType.StartsWith("Dataset"))
                                {
                                <h6 style="text-align:center;color:royalblue">@_SpeciesListType<span style="font-size:x-small;color:indianred"> ( Count @lstDatasetData.Count() )</span></h6>
                                }
                            else
                                {
                                <h6 style="text-align:center;color:royalblue">@_SpeciesListType<span style="font-size:x-small;color:indianred"> ( Count @lstSpecies.Count() )</span></h6>
                                }
                            <hr style="color:indianred" />
                            @* 4CMDs: Search, All, Invert, delete/add *@
                                <div class="d-flex gap-3 justify-content-center align-items-center" style="margin-top:15px;margin-bottom:15px;">
                                <MudIconButton Icon="@Icons.Material.Filled.Search"
                                               Color="Color.Secondary"
                                               Size="Size.Medium"
                                               OnClick="BtnFilterSpeciesList"
                                               Title="Filter Species List" />
                                <MudIconButton Icon="@Icons.Material.Filled.DoneAll"
                                               Color="Color.Primary"
                                               Size="Size.Medium"
                                               OnClick="BtnSelectAllSpecies"
                                               Title="Select all" />
                                <MudIconButton Icon="@Icons.Material.Filled.Rule"
                                               Color="Color.Primary"
                                               Size="Size.Medium"
                                               OnClick="BtnInvertSelection"
                                               Title="Invert Selection" />
                                </div>
                            @* FILTER TextBox for Species List *@
                            @if (_cmd1 == "cmdFilterSpeciesList")
                                {
                                    <div class="d-flex">
                                    <MudTextField @ref="refFilterSpeciesList"
                                                  @bind-Value="_speciesListFilter"
                                                  Label="search results"
                                                  Variant="Variant.Text"
                                                  Margin="Margin.Dense"
                                                  Immediate="true"
                                                  Adornment="Adornment.End"
                                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                                  OnAdornmentClick='@(() => FilterSpeciesList(_speciesListFilter))'
                                                  Class="my-textfield" />
                                    </div>
                                <br />
                                <br />
                                }
                            @foreach (Species species in lstSpecies)
                                {
                                    <div class="d-flex align-items-center mb-1">
                                    <input class="form-check-input"
                                           style="margin-left:1px;margin-right:1px;"
                                           type="checkbox"
                                           @bind="species.IsSelected" />
                                        <button type="button"
                                            class="btn btn-link"
                                            style="margin-left:1px"
                                            @onclick='() => BtnShowSubspecies(species)'
                                            Title="Show sub-Species">
                                        <img src="/img/icoListS.png" width="34" />
                                        </button>
                                        <button type="button"
                                            class="btn btn-link"
                                            style="margin-left:1px"
                                            @onclick='() => BtnReadDatasetsBySpeciesId(species)'
                                            Title="distribution (datasets)">
                                        <img src="/img/icoListD.png" width="34" />
                                        </button>
                                        <button type="button"
                                            class="btn btn-link"
                                            style="margin-left:1px"
                                            @onclick='() => BtnReportDatasetsAsPdf(species)'
                                            Title="distribution (datasets)">
                                        <img src="/img/icoFilePDF1.png" width="26" />
                                        </button>
                                        <button type="button"
                                            class="btn btn-link"
                                            style="margin-left:1px"
                                            @onclick='() => BtnShowDistributionMap(species)'
                                            Title="map distributions">
                                        <img src="/img/icoMap.png" width="26" />
                                        </button>
                                    <span style="font-size:smaller">@species.SciName </span>
                                    <span style="font-size:smaller;color:forestgreen">&nbsp; @((species.NomStatus == 1) ? " valid " : "") </span>
                                    <span style="font-size:smaller;color:darkgoldenrod">&nbsp; @((species.TaxStatus == 1) ? " accepted " : "") </span>
                                    </div>
                                @if ((_cmd1 == "ShowListOfDatasets") && (species.SpeciesId == _speciesId))
                                    {
                                        <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 mb-4 px-0">
                                            <MudCard Class="mx-0">
                                                <MudCardContent Style="background-color:rgb(254,254,254);">
                                                @if (lstDatasets.Count() == 0)
                                                    {
                                                    <h6 style="text-align:center;color:indianred">no data</h6>
                                                    }
                                                else
                                                    {
                                                    <h6 style="text-align:center;color:royalblue">in datasets: <span style="font-size:x-small;color:indianred"> ( Count @lstDatasets.Count() )</span></h6>
                                                    <hr style="color:indianred" />
                                                    @foreach (Dataset _ds in lstDatasets)
                                                        {
                                                            <div class="d-flex align-items-center mb-1">
                                                            <input class="form-check-input"
                                                                   style="margin-left:1px;margin-right:1px;"
                                                                   type="checkbox"
                                                                   @bind="_ds.IsSelected" />
                                                                <button type="button"
                                                                    class="btn btn-link"
                                                                    style="margin-left:1px"
                                                                    @onclick='() => BtnShowDatasetInfo(_ds)'
                                                                    Title="Dataset Info">
                                                                <img src="/img/icoFolderSearch.png" width="22" />
                                                                </button>
                                                            <span style="font-size:smaller">@_ds.DatasetName </span>
                                                            <span style="font-size:smaller;color:forestgreen">&nbsp; ( @_ds.DatasetAbbr - @_ds.ProvinceName)</span>
                                                            </div>
                                                        @if ((_cmd2 == "cmdEditDataset") && (_ds.DatasetId == _datasetId))
                                                            {
                                                            @* Edit Dataset *@
                                                            <br />
                                                                <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-1 mb-4 px-0">
                                                                    <MudCard Class="mx-0">
                                                                        <MudCardContent Style="background-color:rgba(240,240,240);">
                                                                        @* SHOW COMPONENT: CompDataset *@
                                                                        <CompDataset dataset="_ds" OnClose="CloseComponent" />
                                                                        </MudCardContent>
                                                                    </MudCard>
                                                                </MudContainer>
                                                            }
                                                        }
                                                    }
                                                <hr />
                                                    <div class="gap-4" style="display: flex;  justify-content: center; align-items: center;">
                                                        <button class="btn btn-link pulse-hover" @onclick="BtnCancel">
                                                        <img src="/img/icoCancel.png" width="22" />
                                                        </button>
                                                    </div>
                                                </MudCardContent>
                                            </MudCard>
                                        </MudContainer>
                                    }
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudContainer>
                }
            }

        @* LIST Species *@
        }
    </EditForm>
    }
<hr />
<br />
<div class="gap-4" style="display: flex;  justify-content: center; align-items: center;">
        <button class="btn btn-link pulse-hover" @onclick="ScrollToTop">
        <img src="/img/icoGotoTop2.png" width="32" />
        </button>
    </div>
<br />
@* <script>
    window.scrollToTop = () => { window.scrollTo({ top: 0, behavior: 'smooth' }); };
    </script> *@

@code {
    [Parameter]
    public int mode
        {
        get; set;
        }
    [Parameter]
    public int Id
        {
        get; set;
        }
    private MudSelect<int> refNotebooks;
    private MudSelect<int> refSections;
    int NotebookId = 0;
    int SectionId = 0;

    public MudSelect<int> refCountries;
    private List<Country> lstCountries = new List<Country>();
    Country country = new Country();
    public int _countryId = 0;
    private string _countryName = "";
    private string _selectedCountryName = "";

    private User user = new User();
    public MudTextField<string> reftxtSearch;
    public string strSearch = "";
    public MudNumericField<int> txtPageNumber;
    public int intPageNumber = 0;

    List<Note> lstNotes = new List<Note>();
    List<Notebook> lstNotebooks = new List<Notebook>();
    List<Section> lstSections = new List<Section>();
    string _ShowNotebooksMode = "active";
    //dataset
    public MudSelect<int> refDatasets;
    public MudTextField<string> refNewDataset;
    public MudTextField<string> refSearchDataset;
    public List<Dataset>? lstDatasets = new();
    public Dataset dataset = new Dataset();
    public int _datasetId = 0;
    public string _datasetName = "";
    public int _setId = 0;

    //species
    public MudTextField<string> refNewSpecies;
    public MudTextField<string> refSearchSpecies;
    public MudSelect<int> refSpecies;
    public string _speciesSearchText = "";
    //species
    public MudTextField<string> refFilterSpeciesList;
    List<Species> lstSpecies = new();
    Species species = new Species();
    List<DatasetData> lstDatasetData = new();
    DatasetData datasetdata = new DatasetData();
    List<MapPoint> lstMapPoints = new();
    private string _speciesId = "";
    private string _speciesName = "";
    private string _speciesListFilter = "";
    //UPS
    bool _UPS10; //ME
    bool _UPS09;  //GS
    bool _UPS08;  //PO
    bool _UPS07;  //EU
    bool _UPS06;  //MA
    bool _UPS05;  //HF
    bool _UPS04;  //AF
    bool _UPS03;  //IF
    bool _UPS02;  //FU
    bool _UPS01;  //SU
    //misc vars
    public int i = 0;
    public string _cmd1 = ""; //for
    public string _cmd2 = ""; //for
    public string _SpeciesListType = "-";
    public bool _hasFetched = false;
    public bool requestFeedback { get; set; } = false;
    string _accountType = "";
    private bool _isMapInitialized = false;
    private string searchMode = "global search";

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        if (Convert.ToInt32(appState.UserLoginStatus) != 1)
            {
            Navman.NavigateTo("/Login");
            }
        appState.SetCmd("");
        user.UserId = Convert.ToInt32(appState.UserId);
        user.UserTags = Convert.ToInt32(appState.UserTags);
        user.Username = appState.Username;
        await ReadCoutries();
        if (Convert.ToInt32(appState.UserTags) > 256)
            {
            _accountType = " admin account";
            }
        else if (Convert.ToInt32(appState.UserTags) > 128)
            {
            _accountType = " gold account";
            }
        else if (Convert.ToInt32(appState.UserTags) > 64)
            {
            _accountType = " silver account";
            }
        else
            {
            _accountType = " demo account";
            }
        _hasFetched = true;
        }
    protected override async Task OnAfterRenderAsync (bool firstRender)
        {
        //Initialize the Map ONLY when _cmd is "showmap" and it hasn't been initialized yet
        if (_cmd1 == "showmap" && !_isMapInitialized)
            {
            _isMapInitialized = true;
            try
                {
                // wait a tick so the div is fully in the DOM
                await Task.Yield();
                await JS.InvokeVoidAsync("leafletMap.init", "mapup-container", 35.6892, 51.3890, 6);
                await JS.InvokeVoidAsync("leafletMap.addMarkers", lstMapPoints);
                await JS.InvokeVoidAsync("leafletMap.drawPolygon");
                await JS.InvokeVoidAsync("leafletMap.zoomToFit");
                await JS.InvokeVoidAsync("leafletMap.addClickEvent");
                }
            catch (Exception ex)
                {
                Console.WriteLine($"Map Init Error: {ex.Message}");
                _isMapInitialized = false;
                }
            }
        }
    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }
    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }
    //filters
    public void BtnSelectOneCountry ()
        {
        lstSpecies.Clear();
        lstDatasetData.Clear();
        _cmd1 = "showCountriesListToSelectOneSet";
        StateHasChanged();
        }
    public void BtnSelectOneSet ()
        {
        lstSpecies.Clear();
        lstDatasetData.Clear();
        _cmd1 = "showCompAnalysisSetsToSelectOneSet";
        StateHasChanged();
        }
    public void BtnSearchInDatabase ()
        {
        lstSpecies.Clear();
        lstDatasetData.Clear();
        _cmd1 = "";
        searchMode = "global search";
        StateHasChanged();
        }
    //rollbacks
    public async Task GetSelectedSetsFromComponent (List<Set> lstSelectedSets)
        {
        _hasFetched = false;
        lstDatasets = await feService.Read_DatasetsBySubsetIndex(lstSelectedSets [0].SetId, lstSelectedSets [0].SelectedSubset);
        _setId = lstSelectedSets [0].SetId; //keep set id so method SearchSpecies can  use it
        appState.SetSetName(lstSelectedSets [0].SetName);
        _hasFetched = true;
        _cmd1 = "";
        searchMode = "search in datasets";
        }
    //search by country
    private string GetCountryName (int id)
        {
        if (id == 0)
            return "";
        var country = lstCountries.FirstOrDefault(a => a.CountryId == id);
        return country != null ? $"{country.CountryName}" : "";
        }
    private async Task<IEnumerable<int>> SearchCountries (string value, CancellationToken ct)
        {
        //if nothing is typed, return all authors or a subset
        if (string.IsNullOrEmpty(value))
            return lstCountries.Select(x => x.CountryId);
        //filter the list
        return lstCountries
            .Where(x => x.CountryName.Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => x.CountryId);
        }
    private async Task OnCountryChanged (int newValue)
        {
        var oldValue = _countryId;
        _countryId = newValue;
        if (_countryId != 0)
            {
            lstDatasets = await feService.Read_DatasetsByCountryId(_countryId);
            searchMode = "search in country";
            _cmd1 = "";
            }
        StateHasChanged();
        }
    private async Task ReadCoutries ()
        {
        lstCountries = await feService.Read_Countries();
        StateHasChanged();
        }
    private async Task SearchDatasetsByCountryId (int countryId)
        {
        lstCountries = await feService.Read_Countries();
        StateHasChanged();
        }
    //Species
    public async Task BtnSelectAllSpecies ()
        {
        if (_SpeciesListType.StartsWith("Dataset"))
            {
            foreach (DatasetData datasetData in lstDatasetData)
                {
                datasetData.IsSelected = true;
                }
            }
        else
            {
            foreach (Species species in lstSpecies)
                {
                species.IsSelected = true;
                }
            }
        StateHasChanged();
        }
    public async Task BtnInvertSelection ()
        {
        if (_SpeciesListType.StartsWith("Dataset"))
            {
            foreach (DatasetData datasetData in lstDatasetData)
                {
                datasetData.IsSelected = (datasetData.IsSelected) ? false : true;
                }
            }
        else
            {
            foreach (Species species in lstSpecies)
                {
                species.IsSelected = (species.IsSelected) ? false : true;
                }
            }
        StateHasChanged();
        }
    public async Task BtnFilterSpeciesList ()
        {
        _cmd1 = _cmd1 == "cmdFilterSpeciesList" ? "" : "cmdFilterSpeciesList";
        StateHasChanged();
        }
    public async Task FilterSpeciesList (string _speciesListFilter)
        {
        if (_SpeciesListType.StartsWith("Dataset"))
            {
            lstDatasetData = lstDatasetData.Where(s => s.SciName?.Contains(_speciesListFilter, StringComparison.OrdinalIgnoreCase) == true).ToList();
            _SpeciesListType = "Dataset Filtered"; //keep word 'Dataset' at start position, so List type can be recognized in the page-code above
            }
        else
            {
            lstSpecies = lstSpecies.Where(s => s.SciName?.Contains(_speciesListFilter, StringComparison.OrdinalIgnoreCase) == true).ToList();
            _SpeciesListType = "List Filtered";
            }
        StateHasChanged();
        }
    private async Task HandleKey_SearchboxSpecies (KeyboardEventArgs e)
        {
        if (e.Key == "Enter")
            {
            await SearchSpecies(_speciesSearchText);
            return;
            }
        if (e.Key == "Escape")
            {
            strSearch = "";
            await InvokeAsync(StateHasChanged);
            }
        }
    private async Task SearchSpecies (string speciesKeywords)
        {
        _speciesSearchText = speciesKeywords; //keep the search text
        var keywords = speciesKeywords.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (keywords.Length < 2)
            {
            return;
            }
        else if ((keywords [0].Length < 2) || (keywords [1].Length < 2))
            {
            Snackbar.Add($"short keywords!", Severity.Warning);
            return;
            }
        else
            {
            _hasFetched = false;
            StateHasChanged();
            //searchModes: global|countryId|setId
            string _searchMode = "";
            _searchMode = searchMode switch
                {
                    "search in datasets" => "setId",
                    "search in country" => "countryId",
                    "global search" => "global",
                    _ => ""
                    };
            if (_searchMode == "")
                {
                return;
                }
            _cmd1 = "";
            _cmd2 = "";
            _SpeciesListType = "Species search";
            lstSpecies = new();
            switch (_searchMode)
                {
                case "setId":
                        {
                        lstSpecies = await feService.Read_SpeciesBySearch(keywords [0], keywords [1], _searchMode, _setId);
                        break;
                        }
                case "countryId":
                        {
                        lstSpecies = await feService.Read_SpeciesBySearch(keywords [0], keywords [1], _searchMode, _countryId);
                        break;
                        }
                case "global":
                        {
                        lstSpecies = await feService.Read_SpeciesBySearch(keywords [0], keywords [1], _searchMode, 0);
                        break;
                        }

                }
            _hasFetched = true;
            StateHasChanged();
            }
        }
