@page "/PgTaxa"
@using ClosedXML.Excel
@using Microsoft.Extensions.Hosting
@using ClosedXML
@using AlamutB.Service
@using System.Threading.Tasks
@inject NavigationManager Navman
@inject AppState appState
@inject FeService feService
@inject IJSRuntime JS
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService


@if (!_hasFetched)
    {
    <_Loading />
    }
else if (appState.Cmd == "CreateNote")
    {
    <Modal_CreateNote />
    }
else
    {
        <div style="display: flex; flex-direction: column; justify-content: center; align-items: center;">
        <h2 style="color:royalblue; font-style:italic">Taxa</h2>
        @* ---------------------------------------------------------------------------------- 1 APG Groups *@
            <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                <MudCard Class="mx-auto">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                        <div class="d-flex align-content-center align-items-center">
                            <MudSelect T="int"
                                   @ref="refApgGroups"
                                   Label="APG Groups"
                                   Value="_apgGroupId"
                                   ValueChanged="OnApgGroupChanged"
                                   Class="w-auto my-select"
                                   Variant="Variant.Text"
                                   Margin="Margin.Dense"
                                   Adornment="Adornment.End"
                                   AdornmentIcon="@Icons.Material.Filled.List"
                                   Style="color:royalblue;width:140px;font-size:small;">
                            <MudSelectItem Value="0">select</MudSelectItem>
                            @foreach (var apgGroup in lstApgGroups)
                                {
                                <MudSelectItem Value="@apgGroup.ApgGroupId"><span style="font-size:small;font-family:Tahoma;">@apgGroup.ApgGroupName</span></MudSelectItem>
                                }
                            </MudSelect>
                        @* MENU *@
                            <MudMenu Label="Menu"
                                 Variant="Variant.Text"
                                 Color="Color.Tertiary"
                                 EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                 Size="Size.Small"
                                 Style="margin-top:15px;margin-left:15px;"
                                 Dense="true">
                                <MudMenuItem @onclick='() => BtnCreateNote(_apgGroupId, 14)'>
                                    <button class="btn btn-link" Title="add note about this group">
                                    <img src="/img/icoNoteStickyAdd.png" width="22" />
                                    </button>
                                new note
                                </MudMenuItem>
                                <MudMenuItem @onclick='() => BtnCreateNote(_apgGroupId, 14)'>
                                    <button class="btn btn-link" Title="add note about this group">
                                    <img src="/img/icoNoteSticky2.png" width="22" />
                                    </button>
                                show notes
                                </MudMenuItem>
                            </MudMenu>
                        </div>
                    </MudCardContent>
                </MudCard>

            </MudContainer>
        @* ---------------------------------------------------------------------------------- 2 Orders *@
            <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                <MudCard Class="mx-auto">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                        <div class="d-flex align-content-center align-items-center">
                        @if (_cmd == "cmdSearchOrders")
                            {
                            <br />
                            <MudTextField T="string"
                                          @ref="refSearchOrder"
                                          @bind-Value="_orderSearchText"
                                          OnKeyDown="HandleKey_SearchboxOrders"
                                          Label="Search Orders"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          OnAdornmentClick='()=>SearchOrders(_orderSearchText)'
                                          Style="font-family:Tahoma;"
                                          Class="my-textfield" />
                            }
                        else
                            {
                                <MudSelect T="int"
                                       @ref="refOrders"
                                       Label="orders"
                                       Value="_orderId"
                                       ValueChanged="OnOrderChanged"
                                       Class="w-auto my-select"
                                       Variant="Variant.Text"
                                       Margin="Margin.Dense"
                                       Adornment="Adornment.End"
                                       AdornmentIcon="@Icons.Material.Filled.Search"
                                       OnAdornmentClick='@(() => BtnSearch("order"))'
                                       Style="color:royalblue;width:140px;font-size:small;">
                                <MudSelectItem Value="0">select</MudSelectItem>
                                @foreach (Order order in lstOrders)
                                    {
                                    <MudSelectItem Value="@order.OrderId"><span style="font-size:small;font-family:Tahoma;">@order.OrderName</span></MudSelectItem>
                                    }
                                </MudSelect>
                            @* MENU *@
                                <MudMenu Label="Menu"
                                     Variant="Variant.Text"
                                     Color="Color.Tertiary"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Size="Size.Small"
                                     Style="margin-top:15px;margin-left:15px;"
                                     Dense="true">
                                    <MudMenuItem @onclick='() => BtnCreateNote(_apgGroupId, 14)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteStickyAdd.png" width="22" />
                                        </button>
                                    Add New Note
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnCreateNote(_apgGroupId, 14)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteSticky2.png" width="22" />
                                        </button>
                                    Show Notes
                                    </MudMenuItem>
                                </MudMenu>
                            }
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        @* ---------------------------------------------------------------------------------- 3 Families *@
            <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                <MudCard Class="mx-auto">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                    @if (_cmd == "cmdSearchFamilies")
                        {
                        <MudTextField T="string"
                                      @ref="refSearchFamily"
                                      @bind-Value="_familySearchText"
                                      OnKeyDown="HandleKey_SearchboxFamilies"
                                      Label="Search Families"
                                      Variant="Variant.Text"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      OnAdornmentClick='()=>SearchFamilies(_familySearchText)'
                                      Style="font-family:Tahoma;"
                                      Class="my-textfield" />
                        }
                    else if (_cmd == "EditFamily")
                        {
                            <div class="d-flex">
                            <MudTextField @ref="refNewFamily"
                                          @bind-Value="strFamilyName"
                                          Label="edit family"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Autocomplete="off"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Save"
                                          Class="my-textfield" />
                                <button class="btn btn-link" style="margin-left:20px;" Title="cancel" @onclick="BtnCancel">
                                <img src="/img/icoCancel.png" width="20" />
                                </button>
                            </div>
                        }
                    else
                        {
                            <div class="d-flex align-content-center align-items-center">
                                <MudSelect T="int"
                                       @ref="refFamilies"
                                       Label="Families"
                                       Value="_familyId"
                                       ValueChanged="OnFamilyChanged"
                                       Class="w-auto my-select"
                                       Variant="Variant.Text"
                                       Margin="Margin.Dense"
                                       Adornment="Adornment.End"
                                       AdornmentIcon="@Icons.Material.Filled.Search"
                                       OnAdornmentClick='@(() => BtnSearch("family"))'
                                       Style="color:royalblue;width:140px;font-size:small;">
                                <MudSelectItem Value="0">select</MudSelectItem>
                                @foreach (var family in lstFamilies)
                                    {
                                    <MudSelectItem Value="@family.FamilyId"><span style="font-size:small;font-family:Tahoma;">@family.FamilyName</span></MudSelectItem>
                                    }
                                </MudSelect>
                            @* MENU *@
                                <MudMenu Label="Menu"
                                     Variant="Variant.Text"
                                     Color="Color.Tertiary"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Size="Size.Small"
                                     Style="margin-top:15px;margin-left:15px;"
                                     Dense="true">
                                    <MudMenuItem @onclick='() => BtnEditFamily(_familyId)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoRename.png" width="26" />
                                        </button>
                                    Edit Family
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnCreateNote(_apgGroupId, 14)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteStickyAdd.png" width="22" />
                                        </button>
                                    Add New Note
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnCreateNote(_apgGroupId, 14)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteSticky2.png" width="22" />
                                        </button>
                                    Show Notes
                                    </MudMenuItem>
                                </MudMenu>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        @* ---------------------------------------------------------------------------------- 4 Genera *@
            <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                <MudCard Class="mx-auto">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                        <div class="d-flex align-content-center align-items-center">
                        @if (_cmd == "cmdSearchGenera")
                            {
                            <MudTextField T="string"
                                          @ref="refSearchGenus"
                                          @bind-Value="_genusSearchText"
                                          OnKeyDown="HandleKey_SearchboxGenera"
                                          Label="Search Genera"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          OnAdornmentClick='()=>SearchGenera(_genusSearchText)'
                                          Style="font-family:Tahoma;"
                                          Class="my-textfield" />
                            }
                        else
                            {
                                <MudSelect T="int"
                                       @ref="refGenera"
                                       Label="Genera"
                                       Value="_genusId"
                                       ValueChanged="OnGenusChanged"
                                       Class="w-auto my-select"
                                       Variant="Variant.Text"
                                       Margin="Margin.Dense"
                                       Adornment="Adornment.End"
                                       AdornmentIcon="@Icons.Material.Filled.Search"
                                       OnAdornmentClick="@(() => BtnSearchGenera())"
                                       Style="color:royalblue;width:140px;font-size:small;">
                                <MudSelectItem Value="0">select</MudSelectItem>
                                @foreach (var genus in lstGenera)
                                    {
                                    <MudSelectItem Value="@genus.GenusId"><span style="font-size:small;font-family:Tahoma;">@genus.GenusName</span></MudSelectItem>
                                    }
                                </MudSelect>
                            @* MENU *@
                                <MudMenu Label="Menu"
                                     Variant="Variant.Text"
                                     Color="Color.Tertiary"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Size="Size.Small"
                                     Style="margin-top:15px;margin-left:15px;"
                                     Dense="true">
                                    <MudMenuItem @onclick='() => BtnCreateNote(_genusId, 14)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteStickyAdd.png" width="22" />
                                        </button>
                                    Add New Note
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnShowNotes(_genusId)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteSticky2.png" width="22" />
                                        </button>
                                    Show Notes
                                    </MudMenuItem>
                                </MudMenu>
                            }
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudContainer>

        @* ---------------------------------------------------------------------------------- 5 Dataset ML *@
            <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                <MudCard Class="mx-auto">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                    @if (_cmd == "AddNewDatasetML")
                        {
                            <div class="d-flex">
                            <MudTextField @ref="refNewDatasetLM"
                                          @bind-Value="strDatasetLMName"
                                          Label="new group"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Autocomplete="off"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Save"
                                          Class="my-textfield" />
                                <button class="btn btn-link" style="margin-left:20px;" Title="cancel" @onclick="BtnCancel">
                                <img src="/img/icoCancel.png" width="20" />
                                </button>
                            </div>
                        }
                    else if (_cmd == "EditDatasetML")
                        {
                            <div class="d-flex">
                            <MudTextField @ref="refNewDatasetLM"
                                          @bind-Value="strDatasetLMName"
                                          Label="edit DatasetLM"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Autocomplete="off"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Save"
                                          Class="my-textfield" />
                                <button class="btn btn-link" style="margin-left:20px;" Title="cancel" @onclick="BtnCancel">
                                <img src="/img/icoCancel.png" width="20" />
                                </button>
                            </div>
                        }
                    else
                        {
                            <div class="d-flex align-content-center align-items-center">
                                <MudAutocomplete T="int"
                                             Label="Datasets"
                                             @bind-Value="_datasetLMId"
                                             @bind-Value:event="onValueChanged"
                                             ValueChanged="@OnDatasetLMChanged"
                                             SearchFunc="@SearchDatasetsLM"
                                             ToStringFunc="GetDatasetLMName"
                                             Variant="Variant.Text"
                                             Margin="Margin.Dense"
                                             style="font-family:tahoma;text-align:right;font-size:small;color:royalblue;"
                                             Adornment="Adornment.End"
                                             OnAdornmentClick="@(() => BtnEditDatasetLM(_datasetLMId))"
                                             AdornmentIcon="@Icons.Material.Filled.Add">
                                </MudAutocomplete>
                            @* MENU *@
                                <MudMenu Label="Menu"
                                     Variant="Variant.Text"
                                     Color="Color.Tertiary"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Size="Size.Small"
                                     Style="margin-top:15px;margin-left:15px;"
                                     Dense="true">
                                    <MudMenuItem @onclick="BtnAddNewDatasetLM">
                                        <button class="btn btn-link" Title="add new DatasetLM">
                                        <img src="/img/icoAdd0.png" width="20" />
                                        </button>
                                    New Dataset
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnEditDatasetLM(_datasetLMId)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoRename.png" width="26" />
                                        </button>
                                    Edit Dataset
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnCreateNote(_datasetLMId, 14)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteStickyAdd.png" width="22" />
                                        </button>
                                    Add New Note
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnShowNotes(_genusId)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteSticky2.png" width="22" />
                                        </button>
                                    Show Notes
                                    </MudMenuItem>
                                </MudMenu>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        @* ---------------------------------------------------------------------------------- 6 LIST Species *@
        @if (lstSpecies.Count > 0)
            {
                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                    <MudCard Class="mx-0">
                        <MudCardContent Style="background-color:rgba(249,249,249);">
                        <h6 style="text-align:center;color:royalblue">List of Species</h6>
                        <hr style="color:indianred" />
                            <div class="d-flex gap-2" style="margin-top:25px;margin-bottom:15px">
                            <MudIconButton Icon="@Icons.Material.Filled.DoneAll"
                                           Color="Color.Primary"
                                           Size="Size.Medium"
                                           OnClick="BtnSelectAllSpecies"
                                           Title="Select all" />
                            <MudIconButton Icon="@Icons.Material.Filled.Rule"
                                           Color="Color.Primary"
                                           Size="Size.Medium"
                                           OnClick="BtnInvertSelection"
                                           Title="Invert Selection" />
                            </div>
                        @foreach (Species species in lstSpecies)
                            {
                                <div class="d-flex align-items-center mb-1">
                                <input class="form-check-input"
                                       style="margin-left:1px;margin-right:1px;"
                                       type="checkbox"
                                       @bind="species.IsSelected" />
                                    <button type="button"
                                        class="btn btn-link"
                                        style="margin-left:1px"
                                        @onclick='() => BtnReportSpecies(species.SpeciesId)'
                                        Title="Edit Species">
                                    <img src="/img/icoFolderS.png" width="22" />
                                    </button>
                                    <button type="button"
                                        class="btn btn-link"
                                        style="margin-left:1px"
                                        @onclick='() => BtnShowSubspecies(species)'
                                        Title="Show sub-Species">
                                    <img src="/img/icoList.png" width="24" />
                                    </button>
                                    <button type="button"
                                        class="btn btn-link"
                                        style="margin-left:1px"
                                        @onclick='() => BtnCreateNoteForSpecies(species.SpeciesId)'
                                        Title="Note for Species">
                                    <img src="/img/icoNoteStickyAdd.png" width="20" />
                                    </button>
                                <span style="font-size:x-small">@species.SciName</span>
                                </div>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudContainer>
            }
        </div>
    @* ---------------------------------------------------------------------------------- FOOTER *@
    <br />
    <br />
    <hr />
    <br />
        <div class="gap-4" style="display: flex;  justify-content: center; align-items: center;">
        <MudIconButton OnClick="BtnBack"
                       Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Warning"
                       Size="Size.Large"
                       Title="Switchboard" />
        <MudIconButton OnClick='() => BtnGotoPage("N")'
                       Icon="@Icons.Material.Filled.StickyNote2"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Title="Notes" />
        <MudIconButton OnClick="BtnHelpSignupNewTeacher"
                       Icon="@Icons.Material.Filled.HelpCenter"
                       Color="Color.Tertiary"
                       Size="Size.Large"
                       Title="Help" />
        </div>
    }
    <script>
    window.addEventListener('load', () => { window.scrollTo({ top: 0, behavior: 'smooth' }); });
    </script>

@code {
    private MudTextField<string> reftxtSearch;
