@using System.Globalization
@using System.Threading.Tasks
@using AlamutB.Service
@using Microsoft.VisualBasic
@inject FeService feService
@inject NavigationManager Navman
@inject AppState appState
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService

    @if (!_hasFetched)
    {
    <_ScanSheets />
    }
else
    {
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-2 px-0">
            <MudCard Class="mx-0">
                <MudCardContent Style="background-color:rgba(245,245,245);">
                <h6 style="text-align:center;color:royalblue">Floristic Analysis (FlorAn) <span style="font-size:x-small;color:indianred"> ( Set: @appState.SetName )</span></h6>
                <hr style="color:lightslategrey" />
                    <table class="table table-borderless">
                        <tr>
                        <th>Id</th>
                        <th>Dataset name</th>
                        </tr>
                    @foreach (Dataset ds in lstSelectedDatasets)
                        {
                            <tr>
                            <td> <span style="color:dimgray;font-weight:bold;">@ds.DatasetId </span></td>
                            <td> <span style="color:darkslategrey">@ds.DatasetName </span></td>
                            </tr>
                        }
                    </table>
                <hr />
                <br />
                <!-- Section summary Data -->
                    <div class="variables-section">
                    @* Table TOP 10s *@
                    <h6 class="section-title" style="text-align:center;color:blueviolet">Top 10s</h6>
                    <hr />
                    @* Table1— Top 10 families: species count *@
                        <table class="table table-borderless" style="margin-left:50px;width:600px;">
                            <tr>
                            <th>Top 10 species-rich Families</th>
                            <th>species</th>
                            </tr>
                        @foreach (var a in FlorAnData1)
                            {
                                <tr>
                                <td style="width:440px;">@a.f</td>
                                <td>@a.c</td>
                                </tr>
                            }
                        </table>
                        <div class="d-flex justify-content-center">
                        <br />
                            <MudChart T="double"
                                  ChartType="ChartType.Donut"
                                  Width="90%"
                                  Height="300px"
                                  ChartSeries="@([_chartData1])"
                                  ChartLabels="@_chartLbls1">
                            </MudChart>
                        </div>
                    <hr />
                    @* Table2— Top 10 families: genus count *@
                        <table class="table table-borderless" style="margin-left:50px;width:600px;">
                            <tr>
                            <th>Top 10 genus-rich Families</th>
                            <th>Genera</th>
                            </tr>
                        @foreach (var a in FlorAnData2)
                            {
                                <tr>
                                <td style="width:440px;">@a.fam</td>
                                <td>@a.cnt</td>
                                </tr>
                            }
                        </table>
                        <div class="d-flex justify-content-center">
                        <br />
                            <MudChart T="double"
                                  ChartType="ChartType.Donut"
                                  Width="90%"
                                  Height="300px"
                                  ChartSeries="@([_chartData2])"
                                  ChartLabels="@_chartLbls2">
                            </MudChart>
                        </div>
                    <hr />
                    @* Table3— Top 10 genera: species count *@
                        <table class="table table-borderless" style="margin-left:50px;width:600px;">
                            <tr>
                            <th>Top 10 species-rich Genera</th>
                            <th>Species</th>
                            </tr>
                        @foreach (var a in FlorAnData3)
                            {
                                <tr>
                                <td style="width:440px;"><span style="color:darkblue;font-style:italic;">@a.gen </span><span style="color:indianred;font-size:smaller;"> (@a.fam)) </span></td>
                                <td>@a.c</td>
                                </tr>
                            }
                        </table>
                        <div class="d-flex justify-content-center">
                        <br />
                            <MudChart T="double"
                                  ChartType="ChartType.Donut"
                                  Width="90%"
                                  Height="300px"
                                  ChartSeries="@([_chartData3])"
                                  ChartLabels="@_chartLbls3">
                            </MudChart>
                        </div>
                    </div>
                <br />
                <hr />
                <!-- Section Complete List -->
                    <div style="margin-left:10px;margin-right:10px;">
                    <h6 style="text-align:center;color:royalblue">Species List <span style="font-size:x-small;color:indianred"> ( @lstSpeciesFlorAn.Count() )</span></h6>
                        <MudExpansionPanels>
                            <MudExpansionPanel Text="list" MaxHeight="150" Expanded="false">
                                <table class="table table-borderless">
                                    <tr>
                                    <th>Family</th>
                                    <th>Species</th>
                                    </tr>
                                @foreach (Species s in lstSpeciesFlorAn)
                                    {
                                        <tr>
                                        <td><span style="color:indianred;font-size:smaller;"> @s.FamilyName </span></td>
                                        <td><span style="color:darkblue;font-size:smaller;font-style:italic;">@s.GenusName @s.Epithet <span style="color:gray;font-style:normal;">@s.Author</span></span></td>
                                        </tr>
                                    }
                                </table>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </div>
                <br />
                @* Table STATS *@
                <h6 class="section-title" style="text-align:center;color:blueviolet">Stats</h6>
                <hr />
                    <div class="notes-section">
                        <table class="table table-borderless" style="margin-left:150px;width:400px;">
                            <tr>
                            <th>stat</th>
                            <th>value</th>
                            </tr>
                            <tr>
                            <td>Species count</td>
                            <td><span style="color:indianred">@nSp</span></td>
                            </tr>
                            <tr>
                            <td>Genus count</td>
                            <td><span style="color:indianred">@nGen</span></td>
                            </tr>
                            <tr>
                            <td>Family count</td>
                            <td><span style="color:indianred">@nFam</span></td>
                            </tr>
                            @* s/f g/f s/g *@
                            <tr>
                            <td>spc / fam</td>
                            <td><span style="color:royalblue">@(((float) nSp / nFam).ToString("F3"))  </span></td>
                            </tr>
                            <tr>
                            <td>gen / fam</td>
                            <td><span style="color:royalblue">@(((float) nGen / nFam).ToString("F3"))  </span></td>
                            </tr>
                            <tr>
                            <td>spc / gen</td>
                            <td><span style="color:royalblue">@(((float) nSp / nGen).ToString("F3"))  </span></td>
                            </tr>
                            @* f/g f/s g/s *@
                            <tr>
                            <td>fam / gen</td>
                            <td><span style="color:darkgreen">@((nFam / (float) nGen).ToString("F3"))  </span></td>
                            </tr>
                            <tr>
                            <td>fam / spc</td>
                            <td><span style="color:darkgreen">@((nFam / (float) nSp).ToString("F3"))  </span></td>
                            </tr>
                            <tr>
                            <td>gen / spc</td>
                            <td><span style="color:darkgreen">@((nGen / (float) nSp).ToString("F3"))  </span></td>
                            </tr>
                        </table>
                    </div>
                <br />
                @* Table LF , CT *@
                <hr style="color:royalblue;margin-top:50px" />
                <h6 class="section-title" style="text-align:center;color:blueviolet">Life Forms</h6>
                <hr />
                    <div class="notes-section">
                        <table class="table table-borderless" style="margin-left:150px;width:400px;">
                            <tr>
                            <th>Life form</th>
                            <th>count</th>
                            <th>percent</th>
                            </tr>
                            <tr>
                            <td>Ph</td>
                            <td><span style="color:indianred">@nPh</span></td>
                            <td><span style="color:royalblue">@(((float) nPh / nSp * 100).ToString("F2")) %</span></td>
                            </tr>
                            <tr>
                            <td>Ch</td>
                            <td><span style="color:indianred">@nCh</span></td>
                            <td><span style="color:royalblue">@(((float) nCh / nSp * 100).ToString("F2")) %</span></td>
                            </tr>
                            <tr>
                            <td>He</td>
                            <td><span style="color:indianred">@nHe</span></td>
                            <td><span style="color:royalblue">@(((float) nHe / nSp * 100).ToString("F2")) %</span></td>
                            </tr>
                            <tr>
                            <td>Cr</td>
                            <td><span style="color:indianred">@nCr</span></td>
                            <td><span style="color:royalblue">@(((float) nCr / nSp * 100).ToString("F2")) %</span></td>
                            </tr>
                            <tr>
                            <td>Th</td>
                            <td><span style="color:indianred">@nTh</span></td>
                            <td><span style="color:royalblue">@(((float) nTh / nSp * 100).ToString("F2")) %</span></td>
                            </tr>
                            <tr>
                            <td>Na</td>
                            <td><span style="color:indianred">@nNa</span></td>
                            <td><span style="color:royalblue">@(((float) nNa / nSp * 100).ToString("F2")) %</span></td>
                            </tr>
                        </table>
                        <div class="d-flex justify-content-center">
                        <br />
                            <MudChart T="double"
                                  ChartType="ChartType.Donut"
                                  Width="90%"
                                  Height="300px"
                                  ChartSeries="@([new double[]{nPh,nCh,nHe, nCr, nTh, nNa}])"
                                  ChartLabels='new []{"Ph","Ch","He", "Cr", "Th", "Na"}'>
                            </MudChart>
                        </div>
                    </div>
                @* Table Endem-Rare-Med *@
                <hr />
                <h6 class="section-title" style="text-align:center;color:blueviolet">Rare and Medicinal plants</h6>
                <hr />
                    <div class="d-flex justify-content-center">
                    <br />
                    @* Rare *@
                        <MudChart T="double"
                              ChartType="ChartType.Donut"
                              Width="90%"
                              Height="300px"
                              ChartSeries="@([new double[]{nRare ,nSp-nRare}])"
                              int nCR=0;
                              ChartLabels='new []{"Rare:" + ((float)nRare / nSp * 100).ToString("F2") + " %" ,"non-Rare"}'>
                        </MudChart>
                    @* Med *@
                        <MudChart T="double"
                              ChartType="ChartType.Donut"
                              Width="90%"
                              Height="300px"
                              ChartSeries="@([new double[]{nMed ,nSp-nMed}])"
                              int nCR=0;
                              ChartLabels='new []{"Med:" + ((float)nMed / nSp * 100).ToString("F2") + " %" ,"non-Med"}'>
                        </MudChart>
                    </div>
                <br />
                @* Table CONSERVATION *@
                <hr style="color:royalblue;margin-top:50px" />
                <h6 class="section-title" style="text-align:center;color:blueviolet">Conservation status</h6>
                <hr />
                    <div class="notes-section">
                        <table class="table table-borderless" style="margin-left:150px;width:400px;">
                            <tr>
                            <th>Category</th>
                            <th>count</th>
                            <th>percent</th>
                            </tr>
                            <tr>
                            <td>CR</td>
                            <td><span style="color:indianred">@nCR</span></td>
                            <td><span style="color:royalblue">@(((float) nCR / nSp * 100).ToString("F2")) %</span></td>
                            </tr>
                            <tr>
                            <td>EN</td>
                            <td><span style="color:indianred">@nEN</span></td>
                            <td><span style="color:royalblue">@(((float) nEN / nSp * 100).ToString("F2")) %</span></td>
                            </tr>
                            <tr>
                            <td>VU</td>
                            <td><span style="color:indianred">@nVU</span></td>
                            <td><span style="color:royalblue">@(((float) nVU / nSp * 100).ToString("F2")) %</span></td>
                            </tr>
                            <tr>
                            <td>NT</td>
                            <td><span style="color:indianred">@nNT</span></td>
                            <td><span style="color:royalblue">@(((float) nNT / nSp * 100).ToString("F2")) %</span></td>
                            </tr>
                            <tr>
                            <td>LC</td>
                            <td><span style="color:indianred">@nLC</span></td>
                            <td><span style="color:royalblue">@(((float) nLC / nSp * 100).ToString("F2")) %</span></td>
                            </tr>
                            <tr>
                            <td>LR</td>
                            <td><span style="color:indianred">@nLR</span></td>
                            <td><span style="color:royalblue">@(((float) nLR / nSp * 100).ToString("F2")) %</span></td>
                            </tr>
                            <tr>
                            <td>DD</td>
                            <td><span style="color:indianred">@nDD</span></td>
                            <td><span style="color:royalblue">@(((float) nDD / nSp * 100).ToString("F2")) %</span></td>
                            </tr>
                            <tr>
                            <td>NE</td>
                            <td><span style="color:indianred">@nNE</span></td>
                            <td><span style="color:royalblue">@(((float) nNE / nSp * 100).ToString("F2")) %</span></td>
                            </tr>
                        </table>
                        <div class="d-flex justify-content-center">
                        <br />
                            <MudChart T="double"
                                  ChartType="ChartType.Donut"
                                  Width="90%"
                                  Height="300px"
                                  ChartSeries="@([new double[]{nEN ,nVU ,nNT ,nLC ,nLR ,nDD ,nNE}])"
                                  int nCR=0;
                                  ChartLabels='new []{"EN" ,"VU" ,"NT" ,"LC" ,"LR" ,"DD" ,"NE"}'>
                            </MudChart>
                        </div>
                    </div>
                @* FOOTER *@
                <hr style="color:royalblue;margin-top:50px" />
                @* ScrollToTop *@
                    <div class="d-flex justify-content-center">
                        <button class="btn btn-link pulse-hover" @onclick="OnClose">
                        <img src="/img/icoCancel.png" width="26" />
                        </button>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudContainer>
    }
<br />
<br />
<script>window.scrollToTop = () => { window.scrollTo({ top: 0, behavior: 'smooth' }); };</script>

@code {
    [Parameter]
    public List<Dataset>? lstSelectedDatasets
        {
        get; set;
        }
    [Parameter]
    public List<Species>? lstSpeciesFlorAn
        {
        get; set;
        }
    [Parameter]
    public EventCallback<bool> OnAnalysisFlorAnResultsClosed
        {
        get; set;
        }
    User user = new User();
    public bool _hasFetched = false;
    string _cmd = "";

    int nFam = 0;
    int nGen = 0;
    int nSp = 0;
    int nEndem = 0;
    int nRare = 0;
    int nMed = 0;
    int nRange = 0;
    int nCR = 0;
    int nEN = 0;
    int nVU = 0;
    int nNT = 0;
    int nLC = 0;
    int nLR = 0;
    int nDD = 0;
    int nNE = 0;
    int fv1 = 0;
    //
    int nPh = 0;
    int nCh = 0;
    int nHe = 0;
    int nCr = 0;
    int nTh = 0;
    int nNa = 0;
    // DTOs
    public record FamCount (string f, int c);
    public record FamGenCount (string fam, int cnt);
    public record GenCount (string gen, int c, string fam);
    // Fields the markup can see
    private List<FamCount> FlorAnData1 = new();
    private List<FamGenCount> FlorAnData2 = new();
    private List<GenCount> FlorAnData3 = new();

    private double [] _chartData1 = Array.Empty<double>();
    private string [] _chartLbls1 = Array.Empty<string>();
    private double [] _chartData2 = Array.Empty<double>();
    private string [] _chartLbls2 = Array.Empty<string>();
    private double [] _chartData3 = Array.Empty<double>();
    private string [] _chartLbls3 = Array.Empty<string>();

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        appState.SetCmd("");
        user.UserId = Convert.ToInt32(appState.UserId);
        user.Username = appState.Username ?? "";
        await CalcFlorAnStats();
        _hasFetched = true;
        }
    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }
    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }
    //Clacs
    private async Task CalcFlorAnStats ()
        {
        //LINQs
        nFam = lstSpeciesFlorAn.Select(r => r.FamilyId).Distinct().Count();
        nGen = lstSpeciesFlorAn.Select(r => r.GenusId).Distinct().Count();
        nSp = lstSpeciesFlorAn.Select(r => r.SpeciesId).Distinct().Count();
        nEndem = lstSpeciesFlorAn.Count(r => (r.Characters & 1) == 1);
        nRare = lstSpeciesFlorAn.Count(r => (r.Characters & 2) == 2);
        nMed = lstSpeciesFlorAn.Count(r => (r.Characters & 4) == 4);
        nRange = lstSpeciesFlorAn.Count(r => (r.Characters & 8) == 8);
        nCR = lstSpeciesFlorAn.Count(r => (r.ConsStatus & 64) == 64);
        nEN = lstSpeciesFlorAn.Count(r => (r.ConsStatus & 32) == 32);
        nVU = lstSpeciesFlorAn.Count(r => (r.ConsStatus & 16) == 16);
        nNT = lstSpeciesFlorAn.Count(r => (r.ConsStatus & 8) == 8);
        nLC = lstSpeciesFlorAn.Count(r => (r.ConsStatus & 4) == 4);
        nLR = lstSpeciesFlorAn.Count(r => (r.ConsStatus & 2) == 2);
        nDD = lstSpeciesFlorAn.Count(r => (r.ConsStatus & 1) == 1);
        nNE = lstSpeciesFlorAn.Count(r => r.ConsStatus == 0);
        fv1 = nCR * 1024 + nEN * 512 + nVU * 256 + nNT * 128 + nLC * 64 + nLR * 32 + nEndem * 16 + nRare * 8 + nMed * 4 + nRange * 2 + nSp;
        FlorAnData1 = (from r in lstSpeciesFlorAn
                       group r by r.FamilyName into g
                       orderby g.Count() descending
                       select new FamCount(g.Key, g.Count()))
                       .Take(10)
                       .ToList();
        _chartData1 = FlorAnData1.Select(x => (double) x.c).ToArray();
        _chartLbls1 = FlorAnData1.Select(x => x.f).ToArray();

        FlorAnData2 = (from r in lstSpeciesFlorAn
                       group r by r.FamilyName into g
                       let cnt = g.Select(x => x.GenusName).Distinct().Count()
                       orderby cnt descending
                       select new FamGenCount(g.Key, cnt))
                               .Take(10)
                               .ToList();
        _chartData2 = FlorAnData2.Select(x => (double) x.cnt).ToArray();
        _chartLbls2 = FlorAnData2.Select(x => x.fam).ToArray();

        FlorAnData3 = (from r in lstSpeciesFlorAn
                       group r by r.GenusName into g
                       orderby g.Count() descending
                       select new GenCount(
                           g.Key,
                           g.Count(),
                           g.Select(z => z.FamilyName).FirstOrDefault()))
                          .Take(10)
                      .ToList();
        _chartData3 = FlorAnData3.Select(x => (double) x.c).ToArray();
        _chartLbls3 = FlorAnData3.Select(x => x.gen).ToArray();




        //linq para CT
        var FlorAnData4 = (from r in lstSpeciesFlorAn
                           group r by r.Chorotype into grpct
                           select new
                               {
                               ct = grpct.Key,
                               ctcount = grpct.Key.Count()
                               })
                          .Take(10)
                      .ToList();

        //linq para LF
        nPh = lstSpeciesFlorAn.Count(r => r.Lifeform == "Ph");
        nCh = lstSpeciesFlorAn.Count(r => r.Lifeform == "Ch");
        nHe = lstSpeciesFlorAn.Count(r => r.Lifeform == "He");
        nCr = lstSpeciesFlorAn.Count(r => r.Lifeform == "Cr");
        nTh = lstSpeciesFlorAn.Count(r => r.Lifeform == "Th");
        nNa = lstSpeciesFlorAn.Count(r => r.Lifeform == "Na");
        }
    //methods
    public string PersianDate (DateTimeOffset? dt)
        {
        if ((Convert.ToInt32(appState.UserTags) & 2) == 2)
            {
            return feService.ToPersianDate(dt.ToString());
            }
        else
            {
            return dt?.ToString("yyyy-MM-dd HH:mm");
            }
        }
    private async Task HandleModalClose ()
        {
        _hasFetched = false;
        _hasFetched = true;
        StateHasChanged();
        }
    private async Task OnClose ()
        {
        await OnAnalysisFlorAnResultsClosed.InvokeAsync(true);
        }
    }
