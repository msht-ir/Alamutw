@page "/PgSearch"
@using System.Globalization
@using AlamutB.Service
@using System.Threading.Tasks
@inject FeService feService
@inject NavigationManager Navman
@inject AppState appState
@inject IJSRuntime JS
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<h5 style="text-align:center;padding-left:15px;">Search - <span style="font-size:smaller;text-align:center;color:indianred">@appState.UserNickname</span></h5>
<hr style="color:red" />
    @if (!_hasFetched)
    {
    <_ScanSheets />
    }
else
    {
        <EditForm Model="lstNotes">
        @if (appState.Cmd == "ShowNoteInDialog")
            {
            <Modal_ShowNote OnClose="HandleModalClose" />
            }
        else
            {
            @* ---------------------------------------------------------------------------------- SEARCH Species *@
                <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-0">
                    <MudCard Class="mx-auto">
                        <MudCardContent Style="background-color:rgba(249,249,249);">
                            <div class="d-flex align-content-center align-items-center">
                            <MudTextField T="string"
                                          @ref="refSearchSpecies"
                                          @bind-Value="_speciesSearchText"
                                          OnKeyDown="HandleKey_SearchboxSpecies"
                                          Label="search species"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          OnAdornmentClick='()=>SearchSpecies(_speciesSearchText)'
                                          Style="font-family:Tahoma;"
                                          Class="my-textfield" />
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudContainer>
            @* ---------------------------------------------------------------------------------- LIST Species *@
            @if ((lstSpecies.Count > 0) || (lstDatasetData.Count > 0))
                {
                    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-0">
                        <MudCard Class="mx-0">
                            <MudCardContent Style="background-color:rgb(245,245,245);">
                            @if (_SpeciesListType.StartsWith("Dataset"))
                                {
                                <h6 style="text-align:center;color:royalblue">@_SpeciesListType<span style="font-size:x-small;color:indianred"> ( Count @lstDatasetData.Count() )</span></h6>
                                }
                            else
                                {
                                <h6 style="text-align:center;color:royalblue">@_SpeciesListType<span style="font-size:x-small;color:indianred"> ( Count @lstSpecies.Count() )</span></h6>
                                }
                            <hr style="color:indianred" />
                            @* 4CMDs: Search, All, Invert, delete/add *@
                                <div class="d-flex gap-3 justify-content-center align-items-center" style="margin-top:15px;margin-bottom:15px;">
                                <MudIconButton Icon="@Icons.Material.Filled.Search"
                                               Color="Color.Secondary"
                                               Size="Size.Medium"
                                               OnClick="BtnFilterSpeciesList"
                                               Title="Filter Species List" />
                                <MudIconButton Icon="@Icons.Material.Filled.DoneAll"
                                               Color="Color.Primary"
                                               Size="Size.Medium"
                                               OnClick="BtnSelectAllSpecies"
                                               Title="Select all" />
                                <MudIconButton Icon="@Icons.Material.Filled.Rule"
                                               Color="Color.Primary"
                                               Size="Size.Medium"
                                               OnClick="BtnInvertSelection"
                                               Title="Invert Selection" />
                                </div>
                            @* FILTER TextBox for Species List *@
                            @if (_cmd1 == "cmdFilterSpeciesList")
                                {
                                    <div class="d-flex">
                                    <MudTextField @ref="refFilterSpeciesList"
                                                  @bind-Value="_speciesListFilter"
                                                  Label="search results"
                                                  Variant="Variant.Text"
                                                  Margin="Margin.Dense"
                                                  Immediate="true"
                                                  Adornment="Adornment.End"
                                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                                  OnAdornmentClick='@(() => FilterSpeciesList(_speciesListFilter))'
                                                  Class="my-textfield" />
                                    </div>
                                <br />
                                <br />
                                }
                            @foreach (Species species in lstSpecies)
                                {
                                    <div class="d-flex align-items-center mb-1">
                                    <input class="form-check-input"
                                           style="margin-left:1px;margin-right:1px;"
                                           type="checkbox"
                                           @bind="species.IsSelected" />
                                        <button type="button"
                                            class="btn btn-link"
                                            style="margin-left:1px"
                                            @onclick='() => BtnShowSubspecies(species)'
                                            Title="Show sub-Species">
                                        <img src="/img/icoListS.png" width="34" />
                                        </button>
                                        <button type="button"
                                            class="btn btn-link"
                                            style="margin-left:1px"
                                            @onclick='() => BtnReadDatasetsBySpeciesId(species)'
                                            Title="distribution (datasets)">
                                        <img src="/img/icoListD.png" width="34" />
                                        </button>
                                        <button type="button"
                                            class="btn btn-link"
                                            style="margin-left:1px"
                                            @onclick='() => BtnShowSubspecies(species)'
                                            Title="map distributions">
                                        <img src="/img/icoMap.png" width="24" />
                                        </button>
                                    <span style="font-size:smaller">@species.SciName </span>
                                    <span style="font-size:smaller;color:forestgreen">&nbsp; @((species.NomStatus == 1) ? " valid " : "") </span>
                                    <span style="font-size:smaller;color:darkgoldenrod">&nbsp; @((species.TaxStatus == 1) ? " accepted " : "") </span>
                                    </div>
                                @if ((_cmd1 == "ShowListOfDatasets") && (species.SpeciesId == _speciesId))
                                    {
                                        <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 mb-4 px-0">
                                            <MudCard Class="mx-0">
                                                <MudCardContent Style="background-color:rgb(254,254,254);">
                                                <h6 style="text-align:center;color:royalblue">in datasets: <span style="font-size:x-small;color:indianred"> ( Count @lstDatasets.Count() )</span></h6>
                                                <hr style="color:indianred" />
                                                @foreach (Dataset _ds in lstDatasets)
                                                    {
                                                        <div class="d-flex align-items-center mb-1">
                                                        <input class="form-check-input"
                                                               style="margin-left:1px;margin-right:1px;"
                                                               type="checkbox"
                                                               @bind="_ds.IsSelected" />
                                                            <button type="button"
                                                                class="btn btn-link"
                                                                style="margin-left:1px"
                                                                @onclick='() => BtnShowDatasetInfo(_ds)'
                                                                Title="Dataset Info">
                                                            <img src="/img/icoFolderSearch.png" width="22" />
                                                            </button>
                                                        <span style="font-size:smaller">@_ds.DatasetName </span>
                                                        <span style="font-size:smaller;color:forestgreen">&nbsp; ( @_ds.DatasetAbbr - @_ds.ProvinceName)</span>
                                                        </div>
                                                        @if ((_cmd2 == "cmdEditDataset") && (_ds.DatasetId == _datasetId))
                                                            {
                                                            @* Edit Dataset *@
                                                            <br />
                                                                <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-1 mb-4 px-0">
                                                                    <MudCard Class="mx-0">
                                                                        <MudCardContent Style="background-color:rgba(240,240,240);">
                                                                        @* SHOW COMPONENT *@
                                                                        <CompDataset dataset="_ds" OnClose="CloseComponent" />
                                                                        </MudCardContent>
                                                                    </MudCard>
                                                                </MudContainer>
                                                            }
                                                    }
                                                    <hr />
                                                    <div class="gap-4" style="display: flex;  justify-content: center; align-items: center;">
                                                        <button class="btn btn-link pulse-hover" @onclick="BtnCancel">
                                                        <img src="/img/icoCancel.png" width="22" />
                                                        </button>
                                                    </div>
                                                </MudCardContent>
                                            </MudCard>
                                        </MudContainer>
                                    }
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudContainer>
                }
            }
        </EditForm>
    }
<hr />
<br />
    <div class="gap-4" style="display: flex;  justify-content: center; align-items: center;">
        <button class="btn btn-link pulse-hover" @onclick="ScrollToTop">
        <img src="/img/icoGotoTop2.png" width="32" />
        </button>
    </div>
<br />
    <script>
    window.scrollToTop = () => { window.scrollTo({ top: 0, behavior: 'smooth' }); };
    </script>

@code {
    [Parameter]
    public int mode
        {
        get; set;
        }
    [Parameter]
    public int Id
        {
        get; set;
        }
    private MudSelect<int> refNotebooks;
    private MudSelect<int> refSections;
    int NotebookId = 0;
    int SectionId = 0;

    private User user = new User();
    public MudTextField<string> reftxtSearch;
    public string strSearch = "";
    public MudNumericField<int> txtPageNumber;
    public int intPageNumber = 0;

    List<Note> lstNotes = new List<Note>();
    List<Notebook> lstNotebooks = new List<Notebook>();
    List<Section> lstSections = new List<Section>();
    string _ShowNotebooksMode = "active";
    //dataset
    public MudSelect<int> refDatasets;
    public MudTextField<string> refNewDataset;
    public MudTextField<string> refSearchDataset;
    List<Dataset>? lstDatasets = new();
    public Dataset dataset = new Dataset();
    public int _datasetId = 0;
    public string _datasetName = "";
    public string _datasetSearchText = "";

    //species
    public MudTextField<string> refNewSpecies;
    public MudTextField<string> refSearchSpecies;
    public MudSelect<int> refSpecies;
    public string _speciesSearchText = "";
    //species
    public MudTextField<string> refFilterSpeciesList;
    List<Species> lstSpecies = new();
    Species species = new Species();
    List<DatasetData> lstDatasetData = new();
    DatasetData datasetdata = new DatasetData();

    private string _speciesId = "";
    private string _speciesName = "";
    private string _speciesListFilter = "";

    //misc vars
    public int i = 0;
    public string _cmd1 = "";
    public string _cmd2 = "";
    public string _SpeciesListType = "-";
    public bool _hasFetched = false;
    public bool requestFeedback { get; set; } = false;


    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        if (Convert.ToInt32(appState.UserLoginStatus) != 1)
            {
            Navman.NavigateTo("/Login");
            }
        appState.SetCmd("");
        user.UserId = Convert.ToInt32(appState.UserId);
        user.Username = appState.Username;
        _hasFetched = true;
        }
    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }
    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }
    //Species
    public async Task BtnSelectAllSpecies ()
        {
        if (_SpeciesListType.StartsWith("Dataset"))
            {
            foreach (DatasetData datasetData in lstDatasetData)
                {
                datasetData.IsSelected = true;
                }
            }
        else
            {
            foreach (Species species in lstSpecies)
                {
                species.IsSelected = true;
                }
            }
        StateHasChanged();
        }
    public async Task BtnInvertSelection ()
        {
        if (_SpeciesListType.StartsWith("Dataset"))
            {
            foreach (DatasetData datasetData in lstDatasetData)
                {
                datasetData.IsSelected = (datasetData.IsSelected) ? false : true;
                }
            }
        else
            {
            foreach (Species species in lstSpecies)
                {
                species.IsSelected = (species.IsSelected) ? false : true;
                }
            }
        StateHasChanged();
        }
    public async Task BtnFilterSpeciesList ()
        {
        _cmd1 = _cmd1 == "cmdFilterSpeciesList" ? "" : "cmdFilterSpeciesList";
        StateHasChanged();
        }
    public async Task FilterSpeciesList (string _speciesListFilter)
        {
        if (_SpeciesListType.StartsWith("Dataset"))
            {
            lstDatasetData = lstDatasetData.Where(s => s.SciName?.Contains(_speciesListFilter, StringComparison.OrdinalIgnoreCase) == true).ToList();
            _SpeciesListType = "Dataset Filtered"; //keep word 'Dataset' at start position, so List type can be recognized in the page-code above
            }
        else
            {
            lstSpecies = lstSpecies.Where(s => s.SciName?.Contains(_speciesListFilter, StringComparison.OrdinalIgnoreCase) == true).ToList();
            _SpeciesListType = "List Filtered";
            }
        StateHasChanged();
        }
    private async Task HandleKey_SearchboxSpecies (KeyboardEventArgs e)
        {
        if (e.Key == "Enter")
            {
            await SearchSpecies(_speciesSearchText);
            return;
            }
        if (e.Key == "Escape")
            {
            strSearch = "";
            await InvokeAsync(StateHasChanged);
            }
        }
    private async Task SearchSpecies (string speciesKeywords)
        {
        _speciesSearchText = speciesKeywords; //keep the search text
        var words = speciesKeywords.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length < 2)
            {
            return;
            }
        else if ((words [0].Length < 2) || (words [1].Length < 2))
            {
            Snackbar.Add($"short keywords!", Severity.Warning);
            return;
            }
        else
            {
            _cmd1 = "";
            _SpeciesListType = "Species search";
            lstSpecies = new();
            lstSpecies = await feService.Read_SpeciesBySearch(words [0], words [1]);
            StateHasChanged();
            }
        }
    public async Task BtnShowSubspecies (Species species)
        {
        var words = species.SciName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length < 2)
            {
            return;
            }
        else
            {
            lstSpecies = await feService.Read_Subspecies(words [0], words [1]);
            _SpeciesListType = "Related Taxa";
            StateHasChanged();
            }
        }
    public async Task BtnReadDatasetsBySpeciesId (Species species)
        {
        _cmd1 = (_cmd1 == "ShowListOfDatasets") ? "" : "ShowListOfDatasets";
        if (_cmd1 == "ShowListOfDatasets")
            {
            lstSpecies.FirstOrDefault (s => s.SpeciesId == species.SpeciesId).IsSelected = true;
            _speciesId = species.SpeciesId;
            lstDatasets = await feService.Read_DatasetsBySpeciesId(species.SpeciesId);
            _cmd1 = "ShowListOfDatasets";            
            }
        StateHasChanged();
        }
    //dataset
    private async Task BtnShowDatasetInfo(Dataset dataset)
        {
        if (dataset != null)
            {
            _datasetId = dataset.DatasetId;
            lstDatasets.FirstOrDefault(ds => ds.DatasetId == dataset.DatasetId)?.IsSelected = true;
            _cmd2 = (_cmd2 == "cmdEditDataset") ? "" : "cmdEditDataset";
            StateHasChanged();
            }
        else
            {
            Snackbar.Add("Select a Dataset first", Severity.Warning, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
            }
        }
    //methods
    private async Task CloseComponent ()
        {
        //rollBack for Component 'Dataset'
        _cmd1 = "";
        // await BtnShowAllDatasets();
        //restore IsSelected
        lstDatasets.Where(d => d.DatasetId == _datasetId).ToList().ForEach(d => d.IsSelected = true);
        StateHasChanged();
        }
    public string PersianDate (DateTimeOffset? dt)
        {
        if ((Convert.ToInt32(appState.UserTags) & 256) == 256)
            {
            return feService.ToPersianDate(dt.ToString());
            }
        else
            {
            return dt?.ToString("yyyy-MM-dd HH:mm");
            }
        }
    private async Task HandleModalClose ()
        {
        _hasFetched = false;
        lstNotes.Clear();
        lstNotes = await feService.Read_Notes(12, Id);
        _hasFetched = true;
        StateHasChanged();
        }
    public async Task BtnCreateStickyNote (int refType, int refId)
        {
        if (refId > 0)
            {
            //refTypes: 1:ApgGroup 2:Order 3 ّFamily 4:Genus 5:Species 6:DatasetFL 7:DatasetCN 8:DatasetLM 9:Station 10:Set 11:SetData 12:Section 13:User'sNote
            appState.SetNoteRefId(refId);
            appState.SetNoteRefType(refType);
            appState.SetCmd("cmdCreateNote");
            StateHasChanged();
            //After the Modal_CreateNote is closed, HandleModalClose will refresh the list
            //to handel close event, I added in the Modal_CreateNote: [Parameter] public EventCallback OnClose
            }
        else
            {
            Snackbar.Add($"select an item first", Severity.Warning);
            }
        }
    private async Task ScrollToTop ()
        {
        await JS.InvokeVoidAsync("scrollToTop");
        }
    private void BtnCancel ()
        {
        _cmd1 = "";
        StateHasChanged();
        }
    public void BtnBack ()
        {
        Navman.NavigateTo("/Switchboard");
        }

    }
