                    <tr><td>1 Valid</td><td>Properly published and accepted</td></tr>
                    <tr><td>2 Conserved</td><td>Protected against competing names</td></tr>
                    <tr><td>3 Invalid</td><td>Not properly published</td></tr>
                    <tr><td>4 Rejected</td><td>Not to be used</td></tr>
                    <tr><td>5 Illegitimate</td><td>Unnecessary or invalid replacement</td></tr>
                    <tr><td>6 Superfluous</td><td>Unnecessary substitute name</td></tr>
