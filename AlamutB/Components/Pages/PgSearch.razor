    private async Task BtnShowDistributionMap (Species species)
        {
        lstMapPoints = new();
        lstSpecies.FirstOrDefault(s => s.SpeciesId == species.SpeciesId).IsSelected = true;
        // Always load datasets for THIS species, don't rely on prior state
        var datasets = await feService.Read_DatasetsBySpeciesId(species.SpeciesId);
        foreach (var ds in datasets)
            {
            if ((!string.IsNullOrWhiteSpace(ds.Coords)) && (ds.Coords != "0, 0"))
                {
                var parts = ds.Coords.Split(',', StringSplitOptions.TrimEntries);
                if (parts.Length >= 2 &&
                    double.TryParse(parts [0], CultureInfo.InvariantCulture, out double lat) &&
                    double.TryParse(parts [1], CultureInfo.InvariantCulture, out double lng))
                    {
                    lstMapPoints.Add(new MapPoint { Lat = lat, Lng = lng, Name = ds.DatasetName });
                    }
                }
            }

        if (lstMapPoints.Count == 0)
            {
            Snackbar.Add("No coordinates available for this species", Severity.Warning);
            return;
            }

        _isMapInitialized = false;
        _cmd1 = "showmap";
        StateHasChanged();
        }
