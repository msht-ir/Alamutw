        foreach (Notebook notebook in lstNotebooks)
            {
            if (notebook.NotebookId == NotebookId)
                {

                lstSections = notebook.Sections;
                return;
                }
            }
        }
    private void BtnReplaceNote (int noteId)
        {
        if (Convert.ToInt32(appState.NoteId) == noteId)
            {
            _cmd = (_cmd == "MoveNoteToNotebook") ? "" : "MoveNoteToNotebook";
            }
        else
            {
            appState.SetNoteId(noteId);
            _cmd = "MoveNoteToNotebook";
            }
        StateHasChanged();
        }
    private async Task BtnMoveToSelectedSection (int SectionId, int noteid)
        {
        if (SectionId > 0)
            {
            Note _note = new Note { NoteId = noteid, RefType = 2, RefId = SectionId };
            bool result = await feService.Update_NoteRef(_note);
            if (result)
                {
                Snackbar.Add("note replaced", Severity.Success);
                _cmd = "";
                NotebookId = 0;
                SectionId = 0;
                await GetListOfNotebooks(Convert.ToInt32(appState.UserId), _ShowNotebooksMode);
                Section _section = new Section()
                    {
                    SectionId = SectionId,
                    NotebookId = 0,
                    SectionName = "",
                    SectionTags = 0,
                    Notes = new List<Note>()
                    };
                await BtnReadSectionNotes(_section);
                StateHasChanged();
                }
            else
                {
                Snackbar.Add("failed", Severity.Warning);
                }
            }
        else
            {
            Snackbar.Add("select notebook and section", Severity.Info, opt => { opt.VisibleStateDuration = 1500; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
            }
        }
    //handle Keys
    private async Task HandleKey_Searchbox (KeyboardEventArgs e)
        {
        if (e.Key == "Enter")
            {
            await BtnReadNotesBySearch();
            return;
            }
        if (e.Key == "Escape")
            {
            strSearchKey = "";
            await InvokeAsync(StateHasChanged);
            await refSearchNote.FocusAsync();
            }
        }
    //convert date
    public string PersianDate (DateTimeOffset? dt)
        {
        if ((Convert.ToInt32(appState.UserTags) & 256) == 256)
            {
            return feService.ToPersianDate(dt.ToString());
            }
        else
            {
            return dt?.ToString("yyyy-MM-dd HH:mm");
            }
        }
    //back
    public void BtnGotoStickyNotes ()
        {
        //if: UserRole is teacher
        //needs: /mode/id
        user.UserId = Convert.ToInt32(appState.UserId);
        Navman.NavigateTo($"/PgStickyNotes");
        }
    private async Task HandleModalClose ()
        {
        int userId = Convert.ToInt32(appState.UserId);
        await GetListOfNotebooks(userId, _ShowNotebooksMode);
        Section _section = new Section() { SectionId = Convert.ToInt32(appState.NoteRefId), NotebookId = Convert.ToInt32(appState.NotebookId) };
        await BtnReadSectionNotes(_section);
        if (lstSearchedtNotes.Count > 0)
            {
            //refresh searched notes, as one of them may be editted
            await BtnReadNotesBySearch();
            }
        if ((user.UserTags & 16) == 16)
            {
            lstDueNotes = await feService.Read_NotesDue(user.UserId, ((user.UserTags & 32) == 32) ? 7 : 3);
            }
        StateHasChanged();
        }
    public void BtnCancel ()
        {
        appState.SetCmd("");
        _cmd = "";
        }
    public void BtnBackToCallingPage ()
        {
        Navman.NavigateTo(appState.ReturnPage ?? "/Switchboard");
        }
