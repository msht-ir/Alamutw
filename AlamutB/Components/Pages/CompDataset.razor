@using System.Globalization
@using AlamutB.Service
@using System.Threading.Tasks
@inject FeService feService
@inject NavigationManager Navman
@inject AppState appState
@inject IJSRuntime JS
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* <hr style="color:red" /> *@
    @if (!_hasFetched)
    {
    <_ScanSheets />
    }
else
    {
        <EditForm Model="dataset">
        @* TITLE *@
        @if (dataset.DatasetId == 0)
            {
            <h6 style="color:indianred">New Dataset</h6>
            }
        else
            {
                <h6 style="font-size:smaller;color:indianred">
                @* <button class="btn btn-link" style="margin-left:5px;" Title="cancel" @onclick="OnClose">
                    <img src="/img/icoCancel.png" width="18" />
                    </button> *@
                    <button class="btn btn-link" @onclick="BtnSaveDataset">
                    <img src="/img/icoSave2.png" width="18" title="save / update" />
                    </button>
                Edit: <span style="font-size:smaller;color:darkslategray">@dataset.DatasetName</span> (id:@dataset.DatasetId)
                </h6>
            }
        @* BODY *@
            <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-1 mb-4 px-0">
                <MudCard Class="mx-0">
                    <MudCardContent Style="background-color:rgba(230,230,230);">
                        <div class="flex">
                            <div class="d-flex gap-3">
                            @* Name *@
                            <MudTextField @ref="refDatasetName"
                                          @bind-Value="dataset.DatasetName"
                                          Label="dataset name"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Autocomplete="off"
                                          Style="width:600px;color:darkblue;"
                                          Class="my-textfield" />
                            @* Abbr *@
                            <MudTextField @ref="refDatasetAbbr"
                                          @bind-Value="dataset.DatasetAbbr"
                                          Label="abbreviation"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Autocomplete="off"
                                          Class="my-textfield" />
                            </div>
                            <div class="d-flex gap-3">
                            @* Year *@
                            <MudNumericField @ref="refRefYear"
                                             @bind-Value="dataset.RefYear"
                                             Label="year"
                                             Variant="Variant.Text"
                                             Margin="Margin.Dense"
                                             Autocomplete="off"
                                             Style="width:100px;color:indianred;"
                                             Class="my-textfield" />
                            @* Lang *@
                            <MudTextField @ref="refRefLang"
                                          @bind-Value="dataset.RefLang"
                                          Label="language"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Autocomplete="off"
                                          Style="width:80px"
                                          Class="my-textfield" />
                            @* Manager *@
                            <MudTextField @ref="refDatasetManager"
                                          @bind-Value="dataset.DatasetManager"
                                          Label="manager"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Autocomplete="off"
                                          Class="my-textfield" />
                            @* DatasetType *@
                                <MudSelect T="int"
                                       @ref="refDatasetType"
                                       @bind-Value="dataset.DatasetType"
                                       Label="dataset type"
                                       Class="w-auto my-select"
                                       Variant="Variant.Text"
                                       Margin="Margin.Dense"
                                       Adornment="Adornment.Start"
                                       AdornmentIcon="@Icons.Material.Filled.List"
                                       AdornmentColor="Color.Tertiary"
                                       Style="color:royalblue;width:90px;font-size:small;">
                                <MudSelectItem Value="0">select</MudSelectItem>
                                <MudSelectItem Value="3">ListMaker</MudSelectItem>
                                <MudSelectItem Value="2">CheckName</MudSelectItem>
                                <MudSelectItem Value="1">Floristic</MudSelectItem>
                                </MudSelect>
                            </div>
                        <br />
                        <hr style="color:red;" />
                            <div class="d-flex gap-3">
                            @* Country *@
                                <MudAutocomplete T="int"
                                             Value="dataset.CountryId"
                                             Label="country"
                                             SearchFunc="@SearchCountries"
                                             ToStringFunc="GetCountryName"
                                             ValueChanged="OnCountryChanged"
                                             Variant="Variant.Text"
                                             Margin="Margin.Dense"
                                             style="font-family:tahoma;font-size:small;color:royalblue;"
                                             Adornment="Adornment.Start"
                                             AdornmentIcon="@Icons.Material.Filled.List">
                                    <ItemTemplate Context="countryId">
                                        <span style="font-family:tahoma; font-size:small; display:block;">
                                        @GetCountryName(countryId)
                                        </span>
                                    </ItemTemplate>
                                </MudAutocomplete>
                            @* Province *@
                                <MudSelect T="int"
                                       @ref="refProvinces"
                                       @bind-Value="dataset.ProvinceId"
                                       Label="province"
                                       Class="w-auto my-select"
                                       Variant="Variant.Text"
                                       Margin="Margin.Dense"
                                       Adornment="Adornment.Start"
                                       AdornmentIcon="@Icons.Material.Filled.List"
                                       AdornmentColor="Color.Secondary"
                                       ToStringFunc="@GetProvinceName"
                                       Style="color:royalblue;width:140px;font-size:small;">
                                <MudSelectItem Value="0">select</MudSelectItem>
                                @foreach (var province in lstProvinces)
                                    {
                                    <MudSelectItem Value="@province.ProvinceId"><span style="font-size:small;font-family:Tahoma;">@province.ProvinceName</span></MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                            <div class="d-flex gap-3">
                            @* Ref *@
                            <MudTextField @ref="refDatasetRef"
                                          @bind-Value="dataset.DatasetRef"
                                          Label="reference"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Autocomplete="off"
                                          Style="color:dimgrey;"
                                          Lines="10"
                                          Class="my-textfield" />
                            </div>
                            <div class="d-flex gap-3">
                            @* Area *@
                            <MudNumericField @ref="refAreaHa"
                                             @bind-Value="dataset.AreaHa"
                                             Label="area Ha"
                                             Variant="Variant.Text"
                                             Margin="Margin.Dense"
                                             Autocomplete="off"
                                             Style="width:130px"
                                             Class="my-textfield" />
                            @* Coords *@
                            <MudTextField @ref="refCoords"
                                          @bind-Value="dataset.Coords"
                                          Label="coords"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Autocomplete="off"
                                          Style="width:290px"
                                          Class="my-textfield" />
                            @* PREC *@
                            <MudNumericField @ref="refPrecipitation"
                                             @bind-Value="dataset.Precipitation"
                                             Label="precipitation mm"
                                             Variant="Variant.Text"
                                             Margin="Margin.Dense"
                                             Autocomplete="off"
                                             Style="width:140px"
                                             Class="my-textfield" />
                            </div>
                        <hr style="color:red;" />
                            <div class="d-flex gap-3">
                            @* Alt MIN *@
                            <MudNumericField @ref="refAltMin"
                                             @bind-Value="dataset.AltMin"
                                             Label="alt min"
                                             Variant="Variant.Text"
                                             Margin="Margin.Dense"
                                             Autocomplete="off"
                                             Style="width:100px"
                                             Class="my-textfield" />
                            @* Alt MAX *@
                            <MudNumericField @ref="refAltMax"
                                             @bind-Value="dataset.AltMax"
                                             Label="alt max"
                                             Variant="Variant.Text"
                                             Margin="Margin.Dense"
                                             Autocomplete="off"
                                             Style="width:100px"
                                             Class="my-textfield" />
                            @* Alt AVER *@
                            <MudNumericField @ref="refAltAver"
                                             @bind-Value="dataset.AltAver"
                                             Label="alt average"
                                             Variant="Variant.Text"
                                             Margin="Margin.Dense"
                                             Autocomplete="off"
                                             Style="width:100px"
                                             Class="my-textfield" />
                            @* Temp MIN *@
                            <MudNumericField @ref="refTempMin"
                                             @bind-Value="dataset.TempMin"
                                             Label="temp min"
                                             Variant="Variant.Text"
                                             Margin="Margin.Dense"
                                             Autocomplete="off"
                                             Style="width:100px"
                                             Class="my-textfield" />
                            @* Temp MAX *@
                            <MudNumericField @ref="refTempMax"
                                             @bind-Value="dataset.TempMax"
                                             Label="temp max"
                                             Variant="Variant.Text"
                                             Margin="Margin.Dense"
                                             Autocomplete="off"
                                             Style="width:100px"
                                             Class="my-textfield" />
                            @* Temp AVER *@
                            <MudNumericField @ref="refTempAver"
                                             @bind-Value="dataset.TempAver"
                                             Label="temp average"
                                             Variant="Variant.Text"
                                             Margin="Margin.Dense"
                                             Autocomplete="off"
                                             Style="width:100px"
                                             Class="my-textfield" />
                            </div>
                            <div class="d-flex gap-3">
                            @* Tags *@
                            @* <MudNumericField @ref="refDatasetTags"
                                             @bind-Value="dataset.DatasetTags"
                                             Label="tags"
                                             Variant="Variant.Text"
                                             Margin="Margin.Dense"
                                             Autocomplete="off"
                                             Class="my-textfield" /> *@
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        </EditForm>
    @* FOOTER *@
        <div style="text-align: center; margin:10px;">
            <button class="btn btn-link" @onclick="BtnSaveDataset">
            <img src="/img/icoSave2.png" width="22" title="save / update" />
            </button>
            <button class="btn btn-link" style="margin-left:20px;" Title="cancel" @onclick="OnClose">
            <img src="/img/icoCancel.png" width="20" />
            </button>
        </div>
    }
    <script>
    window.scrollToTop = () => { window.scrollTo({ top: 0, behavior: 'smooth' }); };
    </script>

@code {
    [Parameter]
    public Dataset dataset
        {
        get; set;
        }
    [Parameter]
    public EventCallback OnClose
        {
        get; set;
        }
    User user = new User();
    public MudTextField<string> refDatasetAbbr;
    public MudTextField<string> refDatasetName;
    public MudTextField<string> refDatasetRef;
    public MudNumericField<int> refRefYear;
    public MudTextField<string> refRefLang;
    public MudTextField<string> refDatasetManager;
    public MudSelect<int> refDatasetType;
    public MudNumericField<int> refAreaHa;

    public MudSelect<int> refCountries;
    private List<Country> lstCountries = new List<Country>();
    Country country = new Country();
    public int _countryId = 0;
    public string _countryName = "";

    public MudSelect<int> refProvinces;
    private List<Province> lstProvinces = new List<Province>();
    Province province = new Province();
    public int _provinceId = 0;
    public string _provinceName = "";

    public MudNumericField<int> refProvinceId;
    public MudTextField<string> refCoords;
    public MudNumericField<int> refAltMax;
    public MudNumericField<int> refAltMin;
    public MudNumericField<int> refAltAver;
    public MudNumericField<decimal> refTempMax;
    public MudNumericField<decimal> refTempMin;
    public MudNumericField<decimal> refTempAver;
    public MudNumericField<decimal> refPrecipitation;
    public MudNumericField<int> refDatasetTags;

    string _cmd = "";
    public bool _hasFetched = false;

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        if (Convert.ToInt32(appState.UserLoginStatus) != 1)
            {
            Navman.NavigateTo("/Login");
            }
        appState.SetCmd("");
        user.UserId = Convert.ToInt32(appState.UserId);
        user.Username = appState.Username;
        await ReadCoutriesAndProvinces();
        lstProvinces = await feService.Read_Provinces(dataset.CountryId);
        _hasFetched = true;
        }
    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }
    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }
    private async Task OnCloseClick ()
        {
        await OnClose.InvokeAsync();
        }
    //Dataset
    private async Task ReadCoutriesAndProvinces ()
        {
        lstCountries = await feService.Read_Countries();
        lstProvinces = await feService.Read_Provinces(country.CountryId);
        StateHasChanged();
        }
    private async Task BtnSaveDataset ()
        {
        if(dataset.ProvinceId == 0)
            {
            Snackbar.Add("select a province", Severity.Warning, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
            return;
            }
        else
            {
            bool result;
            if (dataset.DatasetId > 0)
                {
                result = await feService.Update_Dataset(dataset);
                }
            else
                {
                result = await feService.Create_Dataset(dataset);
                }
            if (result)
                {
                Snackbar.Add("saved", Severity.Success);
                _cmd = "";
                StateHasChanged();
                await OnCloseClick();
                }            
            }
        }

    private string GetCountryName (int id)
        {
        if (id == 0)
            return "";
        var country = lstCountries.FirstOrDefault(a => a.CountryId == id);
        return country != null ? $"{country.CountryName}" : "";
        }
    private async Task<IEnumerable<int>> SearchCountries (string value, CancellationToken ct)
        {
        //if nothing is typed, return all authors or a subset
        if (string.IsNullOrEmpty(value))
            return lstCountries.Select(x => x.CountryId);
        //filter the list
        return lstCountries
            .Where(x => x.CountryName.Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => x.CountryId);
        }
    private async Task OnCountryChanged (int newValue)
        {
        var oldValue = _countryId;
        _countryId = newValue;
        if (_countryId != 0)
            {
            _cmd = "";
            dataset.ProvinceId = 0;
            lstProvinces = await feService.Read_Provinces(_countryId);
            }
        StateHasChanged();
        }
    private string GetProvinceName (int provinceId)
        {
        //if the ID is 0, return the default 'select' text
        if (provinceId == 0)
            {
            return "select";
            }
        var province = lstProvinces?.FirstOrDefault(p => p.ProvinceId == provinceId);
        return province?.ProvinceName ?? string.Empty;
        }
    //methods
    public string PersianDate (DateTimeOffset? dt)
        {
        if ((Convert.ToInt32(appState.UserTags) & 256) == 256)
            {
            return feService.ToPersianDate(dt.ToString());
            }
        else
            {
            return dt?.ToString("yyyy-MM-dd HH:mm");
            }
        }
    private void BtnCancel ()
        {
        _cmd = "";
        StateHasChanged();
        }



    }
