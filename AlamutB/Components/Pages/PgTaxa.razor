    private async Task CreateDatasetLM (string datasetLMName)
        {
        // dataTypes: 1FL 2CN 3LM 4ST
        int userId = Convert.ToInt32(appState.UserId);
        Dataset datasetLM = (new Dataset
            {
            UserId = userId,
            DatasetType = 3,
            DatasetAbbr = "new List",
            DatasetName = datasetLMName,
            DatasetTags = 0
            });
        bool result = await feService.Create_Dataset(datasetLM);
        if (result)
            {
            Snackbar.Add("dataset created", Severity.Success);
            lstDatasetsLM = await feService.Read_Datasets(userId, 3);
            _cmd = "";
            StateHasChanged();
            }
        }
    private void BtnEditDatasetLM (int _datasetLMId)
        {
        if (_datasetLMId != 0)
            {
            datasetLM = new Dataset();
            datasetLM = lstDatasetsLM.FirstOrDefault(d => d.DatasetId == _datasetLMId);
            if (datasetLM != null)
                {
                _datasetLMName = datasetLM.DatasetName;
                _cmd = "cmdEditDatasetLM";
                StateHasChanged();
                }
            else
                {
                Snackbar.Add("Dataset not found", Severity.Warning);
                }
            }
        else
            {
            Snackbar.Add("Select a Dataset first", Severity.Warning);
            }
        }
    private async Task UpdateDatasetLM (string datasetLMName)
        {
        Dataset _datasetLM = new()
            {
            DatasetId = datasetLM.DatasetId,
            UserId = datasetLM.UserId,
            DatasetType = datasetLM.DatasetType,
            DatasetAbbr = datasetLM.DatasetAbbr,
            DatasetName = datasetLMName,
            DatasetRef = datasetLM.DatasetRef,
            RefYear = datasetLM.RefYear,
            RefLang = datasetLM.RefLang,
            DatasetManager = datasetLM.DatasetManager,
            AreaHa = datasetLM.AreaHa,
            ProvinceId = datasetLM.ProvinceId,
            Coords = datasetLM.Coords,
            AltMax = datasetLM.AltMax,
            AltMin = datasetLM.AltMin,
            AltAver = datasetLM.AltAver,
            TempMax = datasetLM.TempMax,
            TempMin = datasetLM.TempMin,
            TempAver = datasetLM.TempAver,
            Precipitation = datasetLM.Precipitation,
            DatasetTags = datasetLM.DatasetTags
            };
        bool result = await feService.Update_Dataset(_datasetLM);
        if (result)
            {
            Snackbar.Add("dataset updated", Severity.Success);
            int userId = Convert.ToInt32(appState.UserId);
            lstDatasetsLM = await feService.Read_Datasets(userId, 3);
            _cmd = "";
            StateHasChanged();
            }
        }
