                                        }
                                    @if ((species.KEWUPS & 4) == 4)
                                        {
                                        <span style="font-weight:bold;font-size:x-small;color:black">&nbsp;IF</span>
                                        }
                                    @if ((species.KEWUPS & 2) == 2)
                                        {
                                        <span style="font-weight:bold;font-size:x-small;color:black">&nbsp;FU</span>
                                        }
                                    @if ((species.KEWUPS & 1) == 1)
