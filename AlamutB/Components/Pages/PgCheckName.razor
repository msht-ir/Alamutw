    private async Task HandleFileSelected (InputFileChangeEventArgs e)
        {
        /*
        method 1: Save excel file to server folder
        mothod 2: Parse directly in memory
        method 3: EPPlus package (fast!)
        */
        try
            {
            _hasFetched = false;
            excelFile = e.File;
            ExcelPackage.License.SetNonCommercialPersonal("Majid SharifiTehrani"); //for non commertial use of package EPPlus
            //copy stream
            await excelFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(stream);
            stream.Position = 0;
            //use EPPlus to get worksheets
            using var package = new ExcelPackage(stream);
            lstWorksheets = package.Workbook.Worksheets
                .Select(ws => ws.Name)
                .ToList();

            StateHasChanged();
            Snackbar.Add("Excel worksheets listed", Severity.Success, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
            _cmd1 = "ShowWorksheetNames";
            _hasFetched = true;
            }
        catch (Exception ex)
            {
            Console.WriteLine($"Excel Error\n{ex}");
            appState.SetCmd("");
            _hasFetched = true;
            return;
            }
        }
