@page "/PgTaxa"
@using ClosedXML.Excel
@using Microsoft.Extensions.Hosting
@using ClosedXML
@using AlamutB.Service
@using System.Threading.Tasks
@inject NavigationManager Navman
@inject AppState appState
@inject FeService feService
@inject IJSRuntime JS
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (!_hasFetched)
    {
    <_Loading />
    }
else if (appState.Cmd == "cmdCreateNote")
    {
    <Modal_CreateNote />
    }
else
    {
        <div style="display: flex; flex-direction: column; justify-content: center; align-items: center;">
        <h2 style="color:royalblue; font-style:italic">Taxa and Datasets</h2>
        @* ---------------------------------------------------------------------------------- 1 APG Groups *@
            <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                <MudCard Class="mx-auto">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                        <div class="d-flex align-content-center align-items-center">
                            <MudSelect T="int"
                                   @ref="refApgGroups"
                                   @bind-Text="_apgGroupName"
                                   Label="groups"
                                   Value="_apgGroupId"
                                   ValueChanged="OnApgGroupChanged"
                                   Class="w-auto my-select"
                                   Variant="Variant.Text"
                                   Margin="Margin.Dense"
                                   Adornment="Adornment.End"
                                   AdornmentIcon="@Icons.Material.Filled.List"
                                   Style="color:royalblue;width:140px;font-size:small;">
                            <MudSelectItem Value="0">select</MudSelectItem>
                            @foreach (var apgGroup in lstApgGroups)
                                {
                                <MudSelectItem Value="@apgGroup.ApgGroupId"><span style="font-size:small;font-family:Tahoma;">@apgGroup.ApgGroupName</span></MudSelectItem>
                                }
                            </MudSelect>
                        @* MENU *@
                            <MudMenu Label="Menu"
                                 Variant="Variant.Text"
                                 Color="Color.Tertiary"
                                 EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                 Size="Size.Small"
                                 Style="margin-top:15px;margin-left:15px;"
                                 Dense="true">
                                <MudMenuItem @onclick='() => BtnCreateStickyNote(1, _apgGroupId)'>
                                    <button class="btn btn-link" Title="add note about this group">
                                    <img src="/img/icoNoteStickyAdd.png" width="22" />
                                    </button>
                                new note
                                </MudMenuItem>
                                <MudMenuItem @onclick='() => BtnShowNotes(_apgGroupId, 14)'>
                                    <button class="btn btn-link" Title="add note about this group">
                                    <img src="/img/icoNoteSticky2.png" width="22" />
                                    </button>
                                show notes
                                </MudMenuItem>
                            </MudMenu>
                        </div>
                    </MudCardContent>
                </MudCard>

            </MudContainer>
        @* ---------------------------------------------------------------------------------- 2 Orders *@
            <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                <MudCard Class="mx-auto">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                        <div class="d-flex align-content-center align-items-center">
                        @if (_cmd == "cmdSearchOrders")
                            {
                            <br />
                            <MudTextField T="string"
                                          @ref="refSearchOrder"
                                          @bind-Value="_orderSearchText"
                                          OnKeyDown="HandleKey_SearchboxOrders"
                                          Label="Search Orders"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          OnAdornmentClick='()=>SearchOrders(_orderSearchText)'
                                          Style="font-family:Tahoma;"
                                          Class="my-textfield" />
                            }
                        else
                            {
                                <MudSelect T="int"
                                       @ref="refOrders"
                                       @bind-Text="_orderName"
                                       Label="orders"
                                       Value="_orderId"
                                       ValueChanged="OnOrderChanged"
                                       Class="w-auto my-select"
                                       Variant="Variant.Text"
                                       Margin="Margin.Dense"
                                       Adornment="Adornment.End"
                                       AdornmentIcon="@Icons.Material.Filled.Search"
                                       OnAdornmentClick='@(() => BtnSearchOrders())'
                                       Style="color:royalblue;width:140px;font-size:small;">
                                <MudSelectItem Value="0">select</MudSelectItem>
                                @foreach (Order order in lstOrders)
                                    {
                                    <MudSelectItem Value="@order.OrderId"><span style="font-size:small;font-family:Tahoma;">@order.OrderName</span></MudSelectItem>
                                    }
                                </MudSelect>
                            @* MENU *@
                                <MudMenu Label="Menu"
                                     Variant="Variant.Text"
                                     Color="Color.Tertiary"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Size="Size.Small"
                                     Style="margin-top:15px;margin-left:15px;"
                                     Dense="true">
                                    <MudMenuItem @onclick='() => BtnCreateStickyNote(2, _orderId)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteStickyAdd.png" width="22" />
                                        </button>
                                    Add New Note
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnShowNotes(_orderId, 2)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteSticky2.png" width="22" />
                                        </button>
                                    Show Notes
                                    </MudMenuItem>
                                </MudMenu>
                            }
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        @* ---------------------------------------------------------------------------------- 3 Families *@
            <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                <MudCard Class="mx-auto">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                    @if (_cmd == "cmdSearchFamilies")
                        {
                        <MudTextField T="string"
                                      @ref="refSearchFamily"
                                      @bind-Value="_familySearchText"
                                      OnKeyDown="HandleKey_SearchboxFamilies"
                                      Label="Search Families"
                                      Variant="Variant.Text"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      OnAdornmentClick='()=>SearchFamilies(_familySearchText)'
                                      Style="font-family:Tahoma;"
                                      Class="my-textfield" />
                        }
                    else if (_cmd == "cmdEditFamily")
                        {
                            <div class="d-flex">
                            <MudTextField @ref="refNewFamily"
                                          @bind-Value="_familyName"
                                          Label="edit family"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Autocomplete="off"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Save"
                                          Class="my-textfield" />
                                <button class="btn btn-link" style="margin-left:20px;" Title="cancel" @onclick="BtnCancel">
                                <img src="/img/icoCancel.png" width="20" />
                                </button>
                            </div>
                        }
                    else
                        {
                            <div class="d-flex align-content-center align-items-center">
                                <MudSelect T="int"
                                       @ref="refFamilies"
                                       @bind-Text="_familyName"
                                       Label="families"
                                       Value="_familyId"
                                       ValueChanged="OnFamilyChanged"
                                       Class="w-auto my-select"
                                       Variant="Variant.Text"
                                       Margin="Margin.Dense"
                                       Adornment="Adornment.End"
                                       AdornmentIcon="@Icons.Material.Filled.Search"
                                       OnAdornmentClick='@(() => BtnSearchFamilies())'
                                       Style="color:royalblue;width:140px;font-size:small;">
                                <MudSelectItem Value="0">select</MudSelectItem>
                                @foreach (var family in lstFamilies)
                                    {
                                    <MudSelectItem Value="@family.FamilyId"><span style="font-size:small;font-family:Tahoma;">@family.FamilyName</span></MudSelectItem>
                                    }
                                </MudSelect>
                            @* MENU *@
                                <MudMenu Label="Menu"
                                     Variant="Variant.Text"
                                     Color="Color.Tertiary"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Size="Size.Small"
                                     Style="margin-top:15px;margin-left:15px;"
                                     Dense="true">
                                    <MudMenuItem @onclick='() => BtnEditFamily(_familyId)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoRename.png" width="26" />
                                        </button>
                                    Edit Family
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnCreateStickyNote(3, _familyId)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteStickyAdd.png" width="22" />
                                        </button>
                                    Add New Note
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnShowNotes(_apgGroupId, 14)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteSticky2.png" width="22" />
                                        </button>
                                    Show Notes
                                    </MudMenuItem>
                                </MudMenu>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        @* ---------------------------------------------------------------------------------- 4 Genera *@
            <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                <MudCard Class="mx-auto">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                        <div class="d-flex align-content-center align-items-center">
                        @if (_cmd == "cmdSearchGenera")
                            {
                            <MudTextField T="string"
                                          @ref="refSearchGenus"
                                          @bind-Value="_genusSearchText"
                                          OnKeyDown="HandleKey_SearchboxGenera"
                                          Label="Search Genera"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          OnAdornmentClick='()=>SearchGenera(_genusSearchText)'
                                          Style="font-family:Tahoma;"
                                          Class="my-textfield" />
                            }
                        else
                            {
                                <MudSelect T="int"
                                       @ref="refGenera"
                                       @bind-Text="_genusName"
                                       Label="genera"
                                       Value="_genusId"
                                       ValueChanged="OnGenusChanged"
                                       Class="w-auto my-select"
                                       Variant="Variant.Text"
                                       Margin="Margin.Dense"
                                       Adornment="Adornment.End"
                                       AdornmentIcon="@Icons.Material.Filled.List"
                                       OnAdornmentClick="@(() => BtnListSpeciesOfGenus(_genusId))"
                                       Style="color:royalblue;width:140px;font-size:small;">
                                <MudSelectItem Value="0">select</MudSelectItem>
                                @foreach (var genus in lstGenera)
                                    {
                                    <MudSelectItem Value="@genus.GenusId"><span style="font-size:small;font-family:Tahoma;">@genus.GenusName</span></MudSelectItem>
                                    }
                                </MudSelect>
                            @* MENU *@
                                <MudMenu Label="Menu"
                                     Variant="Variant.Text"
                                     Color="Color.Tertiary"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Size="Size.Small"
                                     Style="margin-top:15px;margin-left:15px;"
                                     Dense="true">
                                    <MudMenuItem @onclick="@(() => BtnSearchGenera())">
                                        <button class="btn btn-link" Title="add new DatasetLM">
                                        <img src="/img/icoSearch.png" width="20" />
                                        </button>
                                    Search Genera
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnCreateStickyNote(4, _genusId)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteStickyAdd.png" width="22" />
                                        </button>
                                    Add New Note
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnShowNotes(4, _genusId)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteSticky2.png" width="22" />
                                        </button>
                                    Show Notes
                                    </MudMenuItem>
                                </MudMenu>
                            }
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudContainer>

        @* ---------------------------------------------------------------------------------- 5 Dataset ML *@
            <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                <MudCard Class="mx-auto">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                    @if (_cmd == "cmdAddNewDatasetLM")
                        {
                            <div class="d-flex">
                            <MudTextField @ref="refNewDatasetLM"
                                          @bind-Value="_datasetLMName"
                                          Label="new dataset name"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Autocomplete="off"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Save"
                                          OnAdornmentClick="@(() => CreateDatasetLM (_datasetLMName))"
                                          Class="my-textfield" />
                                <button class="btn btn-link" style="margin-left:20px;" Title="cancel" @onclick="BtnCancel">
                                <img src="/img/icoCancel.png" width="20" />
                                </button>
                            </div>
                        }
                    else if (_cmd == "cmdEditDatasetLM")
                        {
                            <div class="d-flex">
                            <MudTextField @ref="refNewDatasetLM"
                                          @bind-Value="_datasetLMName"
                                          Label="edit dataset"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Autocomplete="off"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Save"
                                          OnAdornmentClick="@(() => UpdateDatasetLM (_datasetLMName))"
                                          Class="my-textfield" />
                                <button class="btn btn-link" style="margin-left:20px;" Title="cancel" @onclick="BtnCancel">
                                <img src="/img/icoCancel.png" width="20" />
                                </button>
                            </div>
                        }
                    else if (_cmd == "cmdSearchDatasetsFL")
                        {
                        <MudTextField T="string"
                                      @ref="refSearchDatasetLM"
                                      @bind-Value="_datasetLMSearchText"
                                      OnKeyDown="HandleKey_SearchboxDatasetLM"
                                      Label="search datasets"
                                      Variant="Variant.Text"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      OnAdornmentClick='()=>SearchDatasetsLM(_datasetLMSearchText)'
                                      Style="font-family:Tahoma;"
                                      Class="my-textfield" />
                        }
                    else
                        {
                            <div class="d-flex align-content-center align-items-center">
                                <MudSelect T="int"
                                       @ref="refDatasetsLM"
                                       @bind-Text="_datasetLMName"
                                       Label="datasets"
                                       Value="_datasetLMId"
                                       ValueChanged="OnDatasetLMChanged"
                                       Class="w-auto my-select"
                                       Variant="Variant.Text"
                                       Margin="Margin.Dense"
                                       Adornment="Adornment.End"
                                       AdornmentIcon="@Icons.Material.Filled.List"
                                       OnAdornmentClick="@(() => BtnListSpeciesOfDatasetsLM(_datasetLMId))"
                                       Style="color:royalblue;width:140px;font-size:small;">
                                <MudSelectItem Value="0">select</MudSelectItem>
                                @foreach (var datasetLM in lstDatasetsLM)
                                    {
                                    <MudSelectItem Value="@datasetLM.DatasetId"><span style="font-size:small;font-family:Tahoma;">@datasetLM.DatasetName</span></MudSelectItem>
                                    }
                                </MudSelect>
                            @* MENU *@
                                <MudMenu Label="Menu"
                                     Variant="Variant.Text"
                                     Color="Color.Tertiary"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Size="Size.Small"
                                     Style="margin-top:15px;margin-left:15px;"
                                     Dense="true">
                                    <MudMenuItem @onclick="BtnAddNewDatasetLM">
                                        <button class="btn btn-link" Title="add new DatasetLM">
                                        <img src="/img/icoAdd0.png" width="20" />
                                        </button>
                                    New Dataset
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnEditDatasetLM(_datasetLMId)'>
                                        <button class="btn btn-link" Title="edit dataset">
                                        <img src="/img/icoRename.png" width="26" />
                                        </button>
                                    Edit Dataset
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => ListAllDatasetsLM()'>
                                        <button class="btn btn-link" Title="list all datasets">
                                        <img src="/img/icoList.png" width="22" />
                                        </button>
                                    List All Datasets
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnSearchDatasetsFL()'>
                                        <button class="btn btn-link" Title="search datasets">
                                        <img src="/img/icoSearch.png" width="18" />
                                        </button>
                                    Search Datasets
                                    </MudMenuItem>
                                <hr>
                                    <MudMenuItem @onclick="@(() => BtnAddSelectedSpeciesToDatasetLM(_datasetLMId))">
                                        <button class="btn btn-link" Title="add new DatasetLM">
                                        <img src="/img/icoAdd0.png" width="20" />
                                        </button>
                                    Add Species to Dataset
                                    </MudMenuItem>
                                <hr>
                                    <MudMenuItem @onclick='() => BtnCreateStickyNote(8, _datasetLMId)'>
                                        <button class="btn btn-link" Title="add note for dataset">
                                        <img src="/img/icoNoteStickyAdd.png" width="22" />
                                        </button>
                                    Add New Note
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnShowNotes(8, _datasetLMId)'>
                                        <button class="btn btn-link" Title="show notes of thos dataset">
                                        <img src="/img/icoNoteSticky2.png" width="22" />
                                        </button>
                                    Show Notes
                                    </MudMenuItem>
                                </MudMenu>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        @* ---------------------------------------------------------------------------------- 6 LIST Species *@
        @if (lstSpecies.Count > 0)
            {
                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                    <MudCard Class="mx-0">
                        <MudCardContent Style="background-color:rgba(249,249,249);">
                        <h6 style="text-align:center;color:royalblue">@_SpeciesListType<span style="font-size:x-small;color:indianred"> ( @lstSpecies.Count() )</span></h6>
                        <hr style="color:indianred" />
                            <div class="d-flex gap-3 justify-content-center align-items-center" style="margin-top:15px;margin-bottom:15px;">
                            <MudIconButton Icon="@Icons.Material.Filled.DoneAll"
                                           Color="Color.Primary"
                                           Size="Size.Medium"
                                           OnClick="BtnSelectAllSpecies"
                                           Title="Select all" />
                            <MudIconButton Icon="@Icons.Material.Filled.Rule"
                                           Color="Color.Primary"
                                           Size="Size.Medium"
                                           OnClick="BtnInvertSelection"
                                           Title="Invert Selection" />
                            <MudIconButton Icon="@Icons.Material.Filled.FilterList"
                                           Color="Color.Secondary"
                                           Size="Size.Medium"
                                           OnClick="BtnFilterSpeciesList"
                                           Title="Filter Species List" />
                            </div>
                        @if (_cmd == "cmdFilterSpeciesList")
                            {
                                <div class="d-flex">
                                <MudTextField @ref="refFilterSpeciesList"
                                              @bind-Value="_speciesListFilter"
                                              Label="filter species list"
                                              Variant="Variant.Text"
                                              Margin="Margin.Dense"
                                              Autocomplete="off"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              OnAdornmentClick="@(() => FilterSpeciesList (_speciesListFilter))"
                                              Class="my-textfield" />
                                    <button class="btn btn-link" style="margin-left:20px;" Title="cancel" @onclick="BtnCancel">
                                    <img src="/img/icoCancel.png" width="20" />
                                    </button>
                                </div>
                            }

                        @foreach (Species species in lstSpecies)
                            {
                                <div class="d-flex align-items-center mb-1">
                                <input class="form-check-input"
                                       style="margin-left:1px;margin-right:1px;"
                                       type="checkbox"
                                       @bind="species.IsSelected" />
                                    <button type="button"
                                        class="btn btn-link"
                                        style="margin-left:1px"
                                        @onclick='() => BtnReportSpecies(species.SpeciesId)'
                                        Title="Edit Species">
                                    <img src="/img/icoFolderS.png" width="22" />
                                    </button>
                                    <button type="button"
                                        class="btn btn-link"
                                        style="margin-left:1px"
                                        @onclick='() => BtnShowSubspecies(species)'
                                        Title="Show sub-Species">
                                    <img src="/img/icoList.png" width="24" />
                                    </button>
                                    <button type="button"
                                        class="btn btn-link"
                                        style="margin-left:1px"
                                        @onclick='() => BtnCreateNoteForSpecies(species.SpeciesId)'
                                        Title="Note for Species">
                                    <img src="/img/icoNoteStickyAdd.png" width="20" />
                                    </button>
                                <span style="font-size:x-small">@species.SciName</span>
                                </div>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudContainer>
            }
        </div>
    @* ---------------------------------------------------------------------------------- FOOTER *@
    <br />
    <br />
    <hr />
    <br />
        <div class="gap-4" style="display: flex;  justify-content: center; align-items: center;">
        <MudIconButton OnClick="BtnBack"
                       Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Warning"
                       Size="Size.Large"
                       Title="Switchboard" />
        <MudIconButton OnClick='() => BtnGotoPage("N")'
                       Icon="@Icons.Material.Filled.StickyNote2"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Title="Notes" />
        <MudIconButton OnClick="BtnHelpSignupNewUser"
                       Icon="@Icons.Material.Filled.HelpCenter"
                       Color="Color.Tertiary"
                       Size="Size.Large"
                       Title="Help" />
        </div>
    }
    <script>
    window.addEventListener('load', () => { window.scrollTo({ top: 0, behavior: 'smooth' }); });
    </script>

@code {
    public MudTextField<string> reftxtSearch;
    public string strSearch = "";
    public MudNumericField<int> txtPageNumber;
    public int intPageNumber = 0;
    //apg
    public MudSelect<int> refApgGroups;
    List<ApgGroup> lstApgGroups = new();
    ApgGroup apgGroup = new ApgGroup();
    public int _apgGroupId = 0;
    public string _apgGroupName = "";
    //order
    public MudSelect<int> refOrders;
    public MudTextField<string> refNewOrder;
    public MudTextField<string> refSearchOrder;
    List<Order> lstOrders = new();
    Order order = new Order();
    public int _orderId = 0;
    public string _orderName = "";
    public string _orderSearchText = "";
    //family
    public MudSelect<int> refFamilies;
    public MudTextField<string> refNewFamily;
    public MudTextField<string> refSearchFamily;
    List<Family> lstFamilies = new();
    Family family = new Family();
    public int _familyId = 0;
    public string _familyName = "";
    public string _familySearchText = "";
    //genus
    public MudTextField<string> refNewGenus;
    public MudTextField<string> refSearchGenus;
    public MudSelect<int> refGenera;
    List<Genus> lstGenera = new();
    Genus genus = new Genus();
    public int _genusId = 0;
    public string _genusName = "";
    public string _genusSearchText = "";
    //dataset
    public MudSelect<int> refDatasetsLM;
    public MudTextField<string> refNewDatasetLM;
    public MudTextField<string> refSearchDatasetLM;
    List<Dataset>? lstDatasetsLM = new();
    public Dataset datasetLM = new Dataset();
    public int _datasetLMId = 0;
    public string _datasetLMName = "";
    public string _datasetLMSearchText = "";
    //species
    public MudTextField<string> refFilterSpeciesList;
    List<Species> lstSpecies = new();
    Species species = new Species();
    private string _speciesId = "";
    private string _speciesName = "";
    private string _speciesListFilter = "";
    //misc vars
    public int i = 0;
    public string _cmd = "";
    public string _SpeciesListType = "-";
    public bool _hasFetched = false;
    public bool requestFeedback { get; set; } = false;

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        if (Convert.ToInt32(appState.UserLoginStatus) != 1)
            {
            Navman.NavigateTo("/Login");
            }
        else
            {
            appState.SetMessage("");
            lstApgGroups = await feService.Read_ApgGroups();
