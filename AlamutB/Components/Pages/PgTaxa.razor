    private string GetGenusName (int id)
        {
        if (id == 0 || lstGenera == null)
            return "";
        var genus = lstGenera.FirstOrDefault(a => a.GenusId == id);
        return genus != null ? genus.GenusName : "";
        }
    private async Task<IEnumerable<int>> SearchGenera (string value, CancellationToken ct)
        {
        // If nothing is typed, return all authors or a subset
        if (string.IsNullOrEmpty(value))
            return lstGenera.Select(x => x.GenusId);
        // Filter the list
        return lstGenera
            .Where(x => x.GenusName.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Select(x => x.GenusId);
        }
