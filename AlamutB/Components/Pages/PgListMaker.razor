@page "/PgListMaker"
@using ClosedXML.Excel
@using Microsoft.Extensions.Hosting
@using ClosedXML
@using AlamutB.Service
@using System.Threading.Tasks
@inject NavigationManager Navman
@inject AppState appState
@inject FeService feService
@inject IJSRuntime JS
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (!_hasFetched)
    {
    <_Loading />
    }
else if (appState.Cmd == "cmdCreateNote")
    {
    <Modal_CreateNote />
    }
else
    {
        <div style="display: flex; flex-direction: column; justify-content: center; align-items: center;">
            <div class="d-flex" style="display: flex; flex-direction: column; justify-content: center; align-items: center;">
            <h2 style="color:royalblue; font-style:italic">ListMaker </h2>
            <span style="font-size:smaller;text-align:center;color:indianred">@appState.UserNickname</span>
            <hr style="color:red" />
            </div>
        @* ---------------------------------------------------------------------------------- 1 APG Groups *@
            <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-0">
                <MudCard Class="mx-auto">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                        <div class="d-flex align-content-center align-items-center">
                            <MudSelect T="int"
                                   @ref="refApgGroups"
                                   @bind-Text="_apgGroupName"
                                   Label="groups"
                                   Value="_apgGroupId"
                                   ValueChanged="OnApgGroupChanged"
                                   Class="w-auto my-select"
                                   Variant="Variant.Text"
                                   Margin="Margin.Dense"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.List"
                                   Style="color:royalblue;width:140px;font-size:small;">
                            <MudSelectItem Value="0">select</MudSelectItem>
                            @foreach (var apgGroup in lstApgGroups)
                                {
                                <MudSelectItem Value="@apgGroup.ApgGroupId"><span style="font-size:small;font-family:Tahoma;">@apgGroup.ApgGroupName</span></MudSelectItem>
                                }
                            </MudSelect>
                        @* MENU *@
                            <MudMenu Label="Menu"
                                 Variant="Variant.Text"
                                 Color="Color.Tertiary"
                                 EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                 Size="Size.Small"
                                 Style="margin-top:15px;margin-left:15px;"
                                 Dense="true">
                                <MudMenuItem @onclick='() => BtnCreateStickyNote(1, _apgGroupId)'>
                                    <button class="btn btn-link" Title="add note about this group">
                                    <img src="/img/icoNoteStickyAdd.png" width="22" />
                                    </button>
                                new note
                                </MudMenuItem>
                                <MudMenuItem @onclick='() => BtnShowNotes(_apgGroupId, 14)'>
                                    <button class="btn btn-link" Title="add note about this group">
                                    <img src="/img/icoNoteSticky2.png" width="22" />
                                    </button>
                                show notes
                                </MudMenuItem>
                            </MudMenu>
                        </div>
                    </MudCardContent>
                </MudCard>

            </MudContainer>
        @* ---------------------------------------------------------------------------------- 2 Orders *@
            <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-0">
                <MudCard Class="mx-auto">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                        <div class="d-flex align-content-center align-items-center">
                        @if (_cmd == "cmdSearchOrders")
                            {
                            <br />
                            <MudTextField T="string"
                                          @ref="refSearchOrder"
                                          @bind-Value="_orderSearchText"
                                          OnKeyDown="HandleKey_SearchboxOrders"
                                          Label="search orders"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          OnAdornmentClick='()=>SearchOrders(_orderSearchText)'
                                          Style="font-family:Tahoma;"
                                          Class="my-textfield" />
                            }
                        else
                            {
                                <MudSelect T="int"
                                       @ref="refOrders"
                                       @bind-Text="_orderName"
                                       Label="orders"
                                       Value="_orderId"
                                       ValueChanged="OnOrderChanged"
                                       Class="w-auto my-select"
                                       Variant="Variant.Text"
                                       Margin="Margin.Dense"
                                       Adornment="Adornment.Start"
                                       AdornmentIcon="@Icons.Material.Filled.Search"
                                       OnAdornmentClick='@(() => BtnSearchOrders())'
                                       Style="color:royalblue;width:140px;font-size:small;">
                                <MudSelectItem Value="0">select</MudSelectItem>
                                @foreach (Order order in lstOrders)
                                    {
                                    <MudSelectItem Value="@order.OrderId"><span style="font-size:small;font-family:Tahoma;">@order.OrderName</span></MudSelectItem>
                                    }
                                </MudSelect>
                            @* MENU *@
                                <MudMenu Label="Menu"
                                     Variant="Variant.Text"
                                     Color="Color.Tertiary"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Size="Size.Small"
                                     Style="margin-top:15px;margin-left:15px;"
                                     Dense="true">
                                    <MudMenuItem @onclick='() => BtnCreateStickyNote(2, _orderId)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteStickyAdd.png" width="22" />
                                        </button>
                                    Add New Note
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnShowNotes(_orderId, 2)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteSticky2.png" width="22" />
                                        </button>
                                    Show Notes
                                    </MudMenuItem>
                                </MudMenu>
                            }
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        @* ---------------------------------------------------------------------------------- 3 Families *@
            <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-0">
                <MudCard Class="mx-auto">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                    @if (_cmd == "cmdSearchFamilies")
                        {
                        <MudTextField T="string"
                                      @ref="refSearchFamily"
                                      @bind-Value="_familySearchText"
                                      OnKeyDown="HandleKey_SearchboxFamilies"
                                      Label="search families"
                                      Variant="Variant.Text"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      OnAdornmentClick='()=>SearchFamilies(_familySearchText)'
                                      Style="font-family:Tahoma;"
                                      Class="my-textfield" />
                        }
                    else if (_cmd == "cmdEditFamily")
                        {
                            <div class="d-flex">
                            <MudTextField @ref="refNewFamily"
                                          @bind-Value="_familyName"
                                          Label="edit family"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Autocomplete="off"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Save"
                                          Class="my-textfield" />
                                <button class="btn btn-link" style="margin-left:20px;" Title="cancel" @onclick="BtnCancel">
                                <img src="/img/icoCancel.png" width="20" />
                                </button>
                            </div>
                        }
                    else
                        {
                            <div class="d-flex align-content-center align-items-center">
                                <MudSelect T="int"
                                       @ref="refFamilies"
                                       @bind-Text="_familyName"
                                       Label="families"
                                       Value="_familyId"
                                       ValueChanged="OnFamilyChanged"
                                       Class="w-auto my-select"
                                       Variant="Variant.Text"
                                       Margin="Margin.Dense"
                                       Adornment="Adornment.Start"
                                       AdornmentIcon="@Icons.Material.Filled.Search"
                                       OnAdornmentClick='@(() => BtnSearchFamilies())'
                                       Style="color:royalblue;width:140px;font-size:small;">
                                <MudSelectItem Value="0">select</MudSelectItem>
                                @foreach (var family in lstFamilies)
                                    {
                                    <MudSelectItem Value="@family.FamilyId"><span style="font-size:small;font-family:Tahoma;">@family.FamilyName</span></MudSelectItem>
                                    }
                                </MudSelect>
                            @* MENU *@
                                <MudMenu Label="Menu"
                                     Variant="Variant.Text"
                                     Color="Color.Tertiary"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Size="Size.Small"
                                     Style="margin-top:15px;margin-left:15px;"
                                     Dense="true">
                                    <MudMenuItem @onclick='() => BtnEditFamily(_familyId)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoRename.png" width="26" />
                                        </button>
                                    Edit Family
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnCreateStickyNote(3, _familyId)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteStickyAdd.png" width="22" />
                                        </button>
                                    Add New Note
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnShowNotes(_apgGroupId, 14)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteSticky2.png" width="22" />
                                        </button>
                                    Show Notes
                                    </MudMenuItem>
                                </MudMenu>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        @* ---------------------------------------------------------------------------------- 4 Genera *@
            <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-0">
                <MudCard Class="mx-auto">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                        <div class="d-flex align-content-center align-items-center">
                        @if (_cmd == "cmdSearchGenera")
                            {
                            <MudTextField T="string"
                                          @ref="refSearchGenus"
                                          @bind-Value="_genusSearchText"
                                          OnKeyDown="HandleKey_SearchboxGenera"
                                          Label="search genera"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          OnAdornmentClick='()=>SearchGenera(_genusSearchText)'
                                          Style="font-family:Tahoma;"
                                          Class="my-textfield" />
                            }
                        else
                            {
                            @if (_genusId > 0)
                                {
                                    <MudSelect T="int"
                                           @ref="refGenera"
                                           @bind-Text="_genusName"
                                           Label="genera"
                                           Value="_genusId"
                                           ValueChanged="OnGenusChanged"
                                           Class="w-auto my-select"
                                           Variant="Variant.Text"
                                           Margin="Margin.Dense"
                                           Adornment="Adornment.Start"
                                           AdornmentIcon="@Icons.Material.Filled.List"
                                           OnAdornmentClick="@(() => BtnListSpeciesOfGenus(_genusId))"
                                           Style="color:royalblue;width:140px;font-size:small;">
                                    <MudSelectItem Value="0">select</MudSelectItem>
                                    @foreach (var genus in lstGenera)
                                        {
                                        <MudSelectItem Value="@genus.GenusId"><span style="font-size:small;font-family:Tahoma;">@genus.GenusName</span></MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                            else
                                {
                                    <MudSelect T="int"
                                           @ref="refGenera"
                                           @bind-Text="_genusName"
                                           Label="genera"
                                           Value="_genusId"
                                           ValueChanged="OnGenusChanged"
                                           Class="w-auto my-select"
                                           Variant="Variant.Text"
                                           Margin="Margin.Dense"
                                           Adornment="Adornment.Start"
                                           AdornmentIcon="@Icons.Material.Filled.Search"
                                           OnAdornmentClick="@(() => BtnSearchGenera())"
                                           Style="color:royalblue;width:140px;font-size:small;">
                                    <MudSelectItem Value="0">select</MudSelectItem>
                                    @foreach (var genus in lstGenera)
                                        {
                                        <MudSelectItem Value="@genus.GenusId"><span style="font-size:small;font-family:Tahoma;">@genus.GenusName</span></MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                            @* MENU *@
                                <MudMenu Label="Menu"
                                     Variant="Variant.Text"
                                     Color="Color.Tertiary"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Size="Size.Small"
                                     Style="margin-top:15px;margin-left:15px;"
                                     Dense="true">
                                    <MudMenuItem @onclick='() => BtnCreateStickyNote(4, _genusId)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteStickyAdd.png" width="22" />
                                        </button>
                                    Add New Note
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnShowNotes(4, _genusId)'>
                                        <button class="btn btn-link" Title="add note about this group">
                                        <img src="/img/icoNoteSticky2.png" width="22" />
                                        </button>
                                    Show Notes
                                    </MudMenuItem>
                                </MudMenu>
                            }
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        @* ---------------------------------------------------------------------------------- 5 Search species *@
            <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-0">
                <MudCard Class="mx-auto">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                        <div class="d-flex align-content-center align-items-center">
                        <MudTextField T="string"
                                      @ref="refSearchSpecies"
                                      @bind-Value="_speciesSearchText"
                                      OnKeyDown="HandleKey_SearchboxSpecies"
                                      Label="search species"
                                      Variant="Variant.Text"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      OnAdornmentClick='()=>SearchSpecies(_speciesSearchText)'
                                      Style="font-family:Tahoma;"
                                      Class="my-textfield" />
                        @* MENU *@
                            <MudMenu Label="Menu"
                                 Variant="Variant.Text"
                                 Color="Color.Tertiary"
                                 EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                 Size="Size.Small"
                                 Style="margin-top:15px;margin-left:15px;"
                                 Dense="true">
                                <MudMenuItem @onclick='() => BtnCreateStickyNote(13, user.UserId)'>
                                    <button class="btn btn-link" Title="add note about this group">
                                    <img src="/img/icoNoteStickyAdd.png" width="22" />
                                    </button>
                                Add New User Sticky Note
                                </MudMenuItem>
                            </MudMenu>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        @* ---------------------------------------------------------------------------------- 6 Dataset ML *@
            <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-0">
                <MudCard Class="mx-auto">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                    @if (_cmd == "cmdAddNewDataset")
                        {
                            <div class="d-flex">
                            <MudTextField @ref="refNewDataset"
                                          @bind-Value="_datasetName"
                                          Label="new dataset name"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Autocomplete="off"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Save"
                                          OnAdornmentClick="@(() => CreateDataset (_datasetName))"
                                          Class="my-textfield" />
                                <button class="btn btn-link" style="margin-left:20px;" Title="cancel" @onclick="BtnCancel">
                                <img src="/img/icoCancel.png" width="20" />
                                </button>
                            </div>
                        }
                    else if (_cmd == "cmdEditDataset")
                        {
                        <br />
                            <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-1 mb-4 px-0">
                                <MudCard Class="mx-0">
                                    <MudCardContent Style="background-color:rgba(240,240,240);">
                                    @* SHOW COMPONENT *@
                                    <CompDataset dataset="dataset" OnClose="CloseComponent" />
                                    </MudCardContent>
                                </MudCard>
                            </MudContainer>

                        }
                    else if (_cmd == "cmdSearchDatasets")
                        {
                        <MudTextField T="string"
                                      @ref="refSearchDataset"
                                      @bind-Value="_datasetSearchText"
                                      OnKeyDown="HandleKey_SearchboxDataset"
                                      Label="search datasets"
                                      Variant="Variant.Text"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      OnAdornmentClick='()=>SearchDatasets(_datasetSearchText)'
                                      Style="font-family:Tahoma;"
                                      Class="my-textfield" />
                        }
                    else
                        {
                            <div class="d-flex align-content-center align-items-center">
                            @if (_datasetId > 0)
                                {
                                    <MudSelect T="int"
                                           @ref="refDatasets"
                                           @bind-Text="_datasetName"
                                           Label="datasets"
                                           Value="_datasetId"
                                           ValueChanged="OnDatasetChanged"
                                           Class="w-auto my-select"
                                           Variant="Variant.Text"
                                           Margin="Margin.Dense"
                                           Adornment="Adornment.Start"
                                           AdornmentIcon="@Icons.Material.Filled.List"
                                           OnAdornmentClick='() => BtnListSpeciesOfDataset(_datasetId)'
                                           Style="color:royalblue;width:140px;font-size:small;">
                                    <MudSelectItem Value="0">select</MudSelectItem>
                                    @foreach (var dataset in lstDatasets)
                                        {
                                        <MudSelectItem Value="@dataset.DatasetId"><span style="font-size:small;font-family:Tahoma;">@dataset.DatasetName</span></MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                            else
                                {
                                    <MudSelect T="int"
                                           @ref="refDatasets"
                                           @bind-Text="_datasetName"
                                           Label="datasets"
                                           Value="_datasetId"
                                           ValueChanged="OnDatasetChanged"
                                           Class="w-auto my-select"
                                           Variant="Variant.Text"
                                           Margin="Margin.Dense"
                                           Adornment="Adornment.Start"
                                           AdornmentIcon="@Icons.Material.Filled.Search"
                                           OnAdornmentClick='() => BtnSearchDatasets()'
                                           Style="color:royalblue;width:140px;font-size:small;">
                                    <MudSelectItem Value="0">select</MudSelectItem>
                                    @foreach (var dataset in lstDatasets)
                                        {
                                        <MudSelectItem Value="@dataset.DatasetId"><span style="font-size:small;font-family:Tahoma;">@dataset.DatasetName</span></MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                            @* MENU *@
                                <MudMenu Label="Menu"
                                     Variant="Variant.Text"
                                     Color="Color.Tertiary"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Size="Size.Small"
                                     Style="margin-top:15px;margin-left:15px;"
                                     Dense="true">
                                    <MudMenuItem @onclick="BtnAddNewDataset">
                                        <button class="btn btn-link" Title="add new Dataset">
                                        <img src="/img/icoAdd0.png" width="20" />
                                        </button>
                                    New Dataset
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnEditDataset(_datasetId)'>
                                        <button class="btn btn-link" Title="edit dataset">
                                        <img src="/img/icoRename.png" width="26" />
                                        </button>
                                    Edit Dataset
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => ListAllDatasets()'>
                                        <button class="btn btn-link" Title="list all datasets">
                                        <img src="/img/icoList1.png" width="22" />
                                        </button>
                                    List All Datasets
                                    </MudMenuItem>
                                <hr>
                                    <MudMenuItem @onclick="@(() => BtnAddSelectedSpeciesToDataset(_datasetId))">
                                        <button class="btn btn-link" Title="add new Dataset">
                                        <img src="/img/icoAdd0.png" width="20" />
                                        </button>
                                    Add Species to Dataset
                                    </MudMenuItem>
                                <hr>
                                    <MudMenuItem @onclick='() => BtnCreateStickyNote(8, _datasetId)'>
                                        <button class="btn btn-link" Title="add note for dataset">
                                        <img src="/img/icoNoteStickyAdd.png" width="22" />
                                        </button>
                                    Add New Note
                                    </MudMenuItem>
                                    <MudMenuItem @onclick='() => BtnShowNotes(8, _datasetId)'>
                                        <button class="btn btn-link" Title="show notes of thos dataset">
                                        <img src="/img/icoNoteSticky2.png" width="22" />
                                        </button>
                                    Show Notes
                                    </MudMenuItem>
                                </MudMenu>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        @* ---------------------------------------------------------------------------------- 7 LIST Species *@
        @if ((lstSpecies.Count > 0) || (lstDatasetData.Count > 0))
            {
                <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-0">
                    <MudCard Class="mx-0">
                        <MudCardContent Style="background-color:rgba(249,249,249);">
                        @if (_SpeciesListType.StartsWith("Dataset"))
                            {
                            <h6 style="text-align:center;color:royalblue">@_SpeciesListType<span style="font-size:x-small;color:indianred"> ( Count @lstDatasetData.Count() )</span></h6>
                            }
                        else
                            {
                            <h6 style="text-align:center;color:royalblue">@_SpeciesListType<span style="font-size:x-small;color:indianred"> ( Count @lstSpecies.Count() )</span></h6>
                            }
                        <hr style="color:indianred" />
                            <div class="d-flex gap-3 justify-content-center align-items-center" style="margin-top:15px;margin-bottom:15px;">
                            <MudIconButton Icon="@Icons.Material.Filled.Search"
                                           Color="Color.Secondary"
                                           Size="Size.Medium"
                                           OnClick="BtnFilterSpeciesList"
                                           Title="Filter Species List" />
                            <MudIconButton Icon="@Icons.Material.Filled.DoneAll"
                                           Color="Color.Primary"
                                           Size="Size.Medium"
                                           OnClick="BtnSelectAllSpecies"
                                           Title="Select all" />
                            <MudIconButton Icon="@Icons.Material.Filled.Rule"
                                           Color="Color.Primary"
                                           Size="Size.Medium"
                                           OnClick="BtnInvertSelection"
                                           Title="Invert Selection" />
                            @if (_SpeciesListType.StartsWith("Dataset"))
                                {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Dark"
                                               Size="Size.Medium"
                                               OnClick='@(() => BtnRemoveSelectedSpeciesFromDataset(_datasetId))'
                                               Title="remove selected species from dataset" />
                                }
                            else
                                {
                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                               Color="Color.Dark"
                                               Size="Size.Medium"
                                               OnClick='@(() => BtnAddSelectedSpeciesToDataset(_datasetId))'
                                               Title="add selected species to dataset" />
                                }
                            </div>
                        @if (_cmd == "cmdFilterSpeciesList")
                            {
                                <div class="d-flex">
                                <MudTextField @ref="refFilterSpeciesList"
                                              @bind-Value="_speciesListFilter"
                                              Label="search results"
                                              Variant="Variant.Text"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              OnAdornmentClick='@(() => FilterSpeciesList(_speciesListFilter))'
                                              Class="my-textfield" />
                                </div>
                            <br />
                            <br />
                            }
                        @if (_SpeciesListType.StartsWith("Dataset"))
                            {
                            @foreach (DatasetData datasetData in lstDatasetData)
                                {
                                    <div class="d-flex align-items-center mb-1">
                                    <input class="form-check-input"
                                           style="margin-left:1px;margin-right:1px;"
                                           type="checkbox"
                                           @bind-value="datasetdata.IsSelected" />
                                        @* <button type="button"
                                            class="btn btn-link"
                                            style="margin-left:1px"
                                            @onclick='() => BtnReportSpecies(datasetData.SpeciesId)'
                                            Title="Edit Species">
                                        <img src="/img/icoFolderS.png" width="22" />
                                        </button> *@
                                        <button type="button"
                                            class="btn btn-link"
                                            style="margin-left:1px"
                                            @onclick='() => BtnCreateNoteForSpecies(datasetData.SpeciesId)'
                                            Title="Note for Species">
                                        <img src="/img/icoNoteStickyAdd.png" width="22" />
                                        </button>
                                        <button type="button"
                                            class="btn btn-link"
                                            style="margin-left:1px"
                                            @onclick='@(() => BtnRemoveSpeciesFromDataset(datasetData.DatasetDataId))'
                                            Title="remove species from dataset">
                                        <img src="/img/icoDelete1.png" width="18" />
                                        </button>
                                    <span style="font-size:smaller">@datasetData.SciName </span>
                                    </div>
                                }
                            }
                        else
                            {
                            @foreach (Species species in lstSpecies)
                                {
                                    <div class="d-flex align-items-center mb-1">
                                    <input class="form-check-input"
                                           style="margin-left:1px;margin-right:1px;"
                                           type="checkbox"
                                           @bind-value="species.IsSelected" />
                                        <button type="button"
                                            class="btn btn-link"
                                            style="margin-left:1px"
                                            @onclick='() => BtnReportSpecies(species.SpeciesId)'
                                            Title="Edit Species">
                                        <img src="/img/icoFolderS.png" width="22" />
                                        </button>
                                        <button type="button"
                                            class="btn btn-link"
                                            style="margin-left:1px"
                                            @onclick='() => BtnShowSubspecies(species)'
                                            Title="Show sub-Species">
                                        <img src="/img/icoList1.png" width="24" />
                                        </button>
                                        <button type="button"
                                            class="btn btn-link"
                                            style="margin-left:1px"
                                            @onclick='() => BtnCreateNoteForSpecies(species.SpeciesId)'
                                            Title="Note for Species">
                                        <img src="/img/icoNoteStickyAdd.png" width="22" />
                                        </button>
                                        <button type="button"
                                            class="btn btn-link"
                                            style="margin-left:1px"
                                            @onclick='@(() => BtnAddSpeciesToDataset(species.SpeciesId))'
                                            Title="add species to dataset">
                                        <img src="/img/icoAdd1.png" width="16" />
                                        </button>
                                    <span style="font-size:smaller">@species.SciName </span>
                                    <span style="font-size:smaller;color:forestgreen">&nbsp; @((species.NomStatus == 1) ? " valid " : "") </span>
                                    <span style="font-size:smaller;color:darkgoldenrod">&nbsp; @((species.TaxStatus == 1) ? " accepted " : "") </span>
                                    </div>
                                }
                            }
                        </MudCardContent>
                    </MudCard>
                </MudContainer>
            }
        </div>
    @* ---------------------------------------------------------------------------------- FOOTER *@
