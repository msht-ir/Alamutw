@using System.Globalization
@using System.Threading.Tasks
@using AlamutB.Service
@using Microsoft.VisualBasic
@inject FeService feService
@inject NavigationManager Navman
@inject AppState appState
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using System.Text;

@if (!_hasFetched)
    {
    <_ScanSheets />
    }
else
    {
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-2 px-0">
            <MudCard Class="mx-0">
                <MudCardContent Style="background-color:rgba(245,245,245);">
                <h6 style="text-align:center;color:royalblue">Multivariate Floristic Analysis (MultivarFlorAn)</h6>
                <h6 style="text-align:center;"><span style="font-size:x-small;color:indianred"> ( Set: @appState.SetName )</span></h6>
                <hr style="color:lightslategrey" />
                    <table class="table table-borderless">
                        <tr>
                        <th>Id</th>
                        <th>Dataset name</th>
                        </tr>
                    @foreach (Dataset ds in lstSelectedDatasets)
                        {
                            <tr>
                            <td> <span style="color:dimgray;font-weight:normal;">@ds.DatasetId </span></td>
                            <td> <span style="color:darkslategrey;font-weight:normal;">@ds.DatasetName </span></td>
                            </tr>
                        }
                    </table>
                <hr />
                    <div class="d-flex justify-content-center align-items-center" style="margin-left:20px; width:300px;">
                        <table class="table table-borderless">
                            <tr>
                            <td> <span style="color:dimgray;font-weight:normal;"> Datasets </span></td>
                            <td> <span style="color:darkslategrey;font-weight:bold;"> @lstSelectedDatasets.Count() </span></td>
                            </tr>
                            <tr>
                            <td> <span style="color:dimgray;font-weight:normal;"> Data points </span></td>
                            <td> <span style="color:darkslategrey;font-weight:bold;"> @lstOccurrenceData.Count() </span></td>
                            </tr>
                        </table>
                    </div>
                <hr />
                <div>
                    <p>An R Script is created containing required data and codes to analyze the (sub)set with Clustering and HeatMap methods.
                        Assuming R is installed on the client, download and Run the R-Script. 
                        Result would be four dendrograms and a HeatMap plot in a pdf file </p>
                </div>
                <hr />
                <!-- Section save R Script -->
                    <div class="d-flex justify-content-center align-items-center">
                    <hr />
                        <button class="btn btn-primary" @onclick="DownloadRScript">
                        Download R-Script.R
                        </button>
                    </div>
                @* FOOTER *@
                <hr style="color:royalblue;margin-top:50px" />
                @* ScrollToTop *@
                    <div class="d-flex justify-content-center">
                        <button class="btn btn-link pulse-hover" @onclick="OnClose">
                        <img src="/img/icoCancel.png" width="26" />
                        </button>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudContainer>
    }
<br />
<br />
<script>window.scrollToTop = () => { window.scrollTo({ top: 0, behavior: 'smooth' }); };</script>

@code {
    [Parameter]
    public List<Dataset>? lstSelectedDatasets
        {
        get; set;
        }
    [Parameter]
    public List<Occurrence>? lstOccurrenceData
        {
        get; set;
        }
    [Parameter]
    public EventCallback<bool> OnAnalysisFlorAnResultsClosed
        {
        get; set;
        }
    User user = new User();
    public bool _hasFetched = false;
    string _cmd = "";

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        appState.SetCmd("");
        user.UserId = Convert.ToInt32(appState.UserId);
        user.Username = appState.Username ?? "";
        _hasFetched = true;
        }
    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }
    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }
    //Clacs
    public static string BuildRScript (int [,] RawMatrix, IReadOnlyList<string> speciesIds, IReadOnlyList<string> datasetLabels, string pdfPath = "RClustering.pdf")
        {
        int nSpecies = RawMatrix.GetLength(0);
        int nDatasets = RawMatrix.GetLength(1);

        var sb = new StringBuilder();

        sb.AppendLine("# Auto-generated by iHerbs.MultiFlorAn");
        sb.AppendLine("# Rows of RawMatrix = species, columns = datasets.");
        sb.AppendLine();

        // --- dataset labels (used later as row names of M) ---
        sb.Append("DSn = c(");
        for (int j = 0; j < nDatasets; j++)
            {
            sb.Append('"').Append(Escape(datasetLabels [j])).Append('"');
            if (j < nDatasets - 1)
                sb.Append(", ");
            }
        sb.AppendLine(")");
        sb.AppendLine();

        // --- one R vector per dataset, containing presence/absence of each species ---
        //     DS1 = c(1,0,1,0,...)  → column j of RawMatrix
for (int j = 0; j < nDatasets; j++)
{
    sb.Append("DS").Append(j + 1).Append(" = c(");
    for (int i = 0; i < nSpecies; i++)
    {
        sb.Append(RawMatrix[i, j]);
        if (i < nSpecies - 1)
        {
            sb.Append(", ");
            // Break line every 200 values
            if ((i + 1) % 200 == 0)
            {
                sb.AppendLine();
            }
        }
    }
    sb.AppendLine(")");
}
sb.AppendLine();
        // --- stack datasets as rows of M (same orientation as your VBA) ---
        sb.Append("M = rbind(");
        for (int j = 0; j < nDatasets; j++)
            {
            sb.Append("DS").Append(j + 1);
            if (j < nDatasets - 1)
                sb.Append(", ");
            }
        sb.AppendLine(")");
        sb.AppendLine();

        // --- give the rows meaningful names so the dendrogram is readable ---
        sb.AppendLine("rownames(M) = DSn");
        sb.AppendLine();

        // --- the rest is your original analysis ---
        sb.AppendLine("DF = data.frame(M)");
        sb.AppendLine("DistDF = dist(DF)");
        sb.AppendLine();
        sb.AppendLine("DFClust1 <- hclust(DistDF, 'single')");
        sb.AppendLine("DFClust2 <- hclust(DistDF, 'complete')");
        sb.AppendLine("DFClust3 <- hclust(DistDF, 'average')");
        sb.AppendLine("DFClust4 <- hclust(DistDF, 'centroid')");
        sb.AppendLine();
        sb.AppendLine($"pdf('{pdfPath.Replace("\\", "/")}')");
        sb.AppendLine("par(mfrow = c(2, 2))");
        sb.AppendLine("plot(DFClust1, hang = -1, main = 'single', cex = 0.5)");
        sb.AppendLine("plot(DFClust2, hang = -1, main = 'complete', cex = 0.5)");
        sb.AppendLine("plot(DFClust3, hang = -1, main = 'average', cex = 0.5)");
        sb.AppendLine("plot(DFClust4, hang = -1, main = 'centroid', cex = 0.5)");
        sb.AppendLine("heatmap(M,cexRow = 0.5, cexCol = 0.5)");
        sb.AppendLine("dev.off()");   // ← must close the PDF device

        return sb.ToString();
        }
    private async Task DownloadRScript ()
        {
        //1. Get data
        // lstOccurrenceData is already passes as [parameter]
        //2. Build RawMatrix (from the earlier answer)
        var speciesIds = lstOccurrenceData
            .Select(o => o.SpeciesId)
            .Distinct(StringComparer.Ordinal)
            .OrderBy(s => s, StringComparer.Ordinal)
            .ToList();
        var datasetIds = lstOccurrenceData
            .Select(o => o.DatasetId)
            .Distinct()
            .OrderBy(id => id)
            .ToList();
        var speciesIndex = speciesIds
            .Select((id, idx) => (id, idx))
            .ToDictionary(t => t.id, t => t.idx, StringComparer.Ordinal);
        var datasetIndex = datasetIds
            .Select((id, idx) => (id, idx))
            .ToDictionary(t => t.id, t => t.idx);
        int [,] RawMatrix = new int [speciesIds.Count, datasetIds.Count];
        foreach (var occ in lstOccurrenceData)
            {
            int i = speciesIndex [occ.SpeciesId];
            int j = datasetIndex [occ.DatasetId];
            RawMatrix [i, j] = 1;
            }
        // 3. Dataset labels (use the same abbreviations you had in VBA).
        //    If you already fetched them from Collections, use that list.
        //    Otherwise fall back to the numeric DatasetId.
        //--var datasetLabels = datasetIds.Select(id => id.ToString()).ToList();
        var datasetLabels = lstOccurrenceData
            .Select(o => o.DatasetName)
            .Distinct()
            .OrderBy(id => id)
            .ToList();
        // 4. Build the R script text.
        string script = BuildRScript(RawMatrix, speciesIds, datasetLabels, pdfPath: "RClustering.pdf");
        // 5. Hand it to the browser → user picks where to save.
        await JS.InvokeVoidAsync("downloadTextFile","RScript.R", "text/plain;charset=utf-8", script);
        }
    private static string Escape (string s) =>
        s.Replace("\\", "\\\\").Replace("\"", "\\\"");
    //methods
    public string PersianDate (DateTimeOffset? dt)
        {
        if ((Convert.ToInt32(appState.UserTags) & 256) == 256)
            {
            return feService.ToPersianDate(dt.ToString());
            }
        else
            {
            return dt?.ToString("yyyy-MM-dd HH:mm");
            }
        }
    private async Task HandleModalClose ()
        {
        _hasFetched = false;
        _hasFetched = true;
        StateHasChanged();
        }
    private async Task OnClose ()
        {
        await OnAnalysisFlorAnResultsClosed.InvokeAsync(true);
        }

    }
