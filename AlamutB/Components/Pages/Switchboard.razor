@code
{
    private bool _firstRender = true;
    private bool _isDataReady = false;
    private bool _isMapInitialized = false; // NEW: Tracks if JS has run
    User user = new User();
    public int Spacing { get; set; } = 3;
    string _cmd = "";
    string _accountType = "";

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        if (Convert.ToInt32(appState.UserLoginStatus) != 1)
            {
            Navman.NavigateTo("/Login");
            }
        if (Convert.ToInt32(appState.UserTags) > 256)
            _accountType = " admin account";
        else if (Convert.ToInt32(appState.UserTags) > 128)
            _accountType = " gold account";
        else if (Convert.ToInt32(appState.UserTags) > 64)
            _accountType = " silver account";
        else
            _accountType = " demo account";
        }
    protected override async Task OnAfterRenderAsync (bool firstRender)
        {
        // 1. Handle Session Storage on the very first load
        if (firstRender && !_isDataReady)
            {
            try
                {
                    user.Username = appState.Username;
                    _isDataReady = true;
                    StateHasChanged(); // This will cause OnAfterRenderAsync to run again
                }
            catch (InvalidOperationException)
                {
                return;
                }
            }
        // 2. Initialize the Map -- We check if _isDataReady is true, but _isMapInitialized is false. This guarantees the div has been rendered to the DOM.
        if (_isDataReady && !_isMapInitialized)
            {
            _isMapInitialized = true; // Set to true immediately to prevent duplicate calls
            try
                {
                await JS.InvokeVoidAsync("leafletMap.init", "mapup-container", 32.621738, 51.626070, 6);
                }
            catch (JSDisconnectedException) { }
            catch (Exception ex)
                {
                Console.WriteLine($"Map Init Error: {ex.Message}");
                _isMapInitialized = false; // Allow retry if it failed
                }
            }
        }
    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }
    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }
    //methods
    public void GotoLogin ()
        {
        Navman.NavigateTo("/Login");
        }
    public void GotoPage (string _pageId)
        {
        string page = _pageId switch
            {
                "TX" => "/PgListMaker",
                "CN" => "/PgCheckName",
                "DS" => "/PgDatasets",
                "SET" => "/PgSets",
                "ANL" => "/PgAnalysis",
                "STT" => "/PgSettings",
                "ADM" => "/PgAdmin",
                "NBK" => "/PgNotebooks",
                "STN" => "/PgStickyNotes",
                "RGN" => "/PgReportGenerator",
                "APL" => "/PgAPL",
                "PRN" => "/PgPrints",
                "SRC" => "/PgSearch",
                "LIB" => "/PgLibrary",
                "MAP" => "/PgMaps",
                "CLM" => "/PgClimagraph",
                "INF" => "/PgInfo"
                };
        Navman.NavigateTo(page);
        }
    public void GotoNotebooks ()
        {
        appState.SetReturnPage("/Switchboard");
        Navman.NavigateTo("/E_NoteBooks");
        }
    public void BtnGotoAdminPage ()
        {
        appState.SetReturnPage("/Switchboard");
        Navman.NavigateTo("/T_Admin");
        }
    public async Task BtnCreateNote ()
        {
        appState.SetNoteRefId(Convert.ToInt32(appState.UserId)); //for quickNote(t): NoteReferenceId = UserId
        appState.SetNoteRefType(11);
        appState.SetCmd("CreateNote");
        StateHasChanged();
        //After the Modal_CreateNote is closed, HandleModalClose will refresh the list
        //to handel close event, I added in the Modal_CreateNote: [Parameter] public EventCallback OnClose
        }
    public void ReportUserNotes ()
        {
        user.UserId = Convert.ToInt32(appState.UserId);
        appState.SetReturnPage("/Switchboard");
        Navman.NavigateTo($"/T_ReportNotes/11/{user.UserId}");
        }
    private void BtnChangeTeacherPassword ()
        {
        if ((Convert.ToInt32(appState.UserTags) & 256) == 256)
            {
            appState.SetUserLoginStatus(1);
            Navman.NavigateTo("/ChangePassword");
            }
        else
            {
            Snackbar.Add("not available in silver / demo account", Severity.Info, opt => { opt.VisibleStateDuration = 1500; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
            }
        }
    private async Task HandleModalClose ()
        {
        StateHasChanged();
        }
    //temp codes to parse afgh and uzb text files (see temp btn at end of page html code)
    private void TempMethod_RemoveExtraLines ()
        {
        string inputPath = @"d:\CheckNameIn.txt";
        string outputPath = @"d:\CheckNameOut.txt";
        var lines = File.ReadAllLines(inputPath);
        var filteredLines = lines.Where(line => !line.StartsWith("Distr"));
        File.WriteAllLines(outputPath, filteredLines);
        }
    private async Task RemoveCrLfs ()
        {
        try
            {
            string inputPath = @"d:\2025Uzb.txt";
            string outputPath = @"d:\2025Uzb_.txt";
            string content = await File.ReadAllTextAsync(inputPath);
            var lines = content.Split(new [] { "\r\n" }, StringSplitOptions.None);
            var result = new StringBuilder();
            for (int i = 0; i < lines.Length; i++)
                {
                string line = lines [i];
                //check if line starts with "1. ", "2. ", "3. ", etc.
                bool isNumberedLine = System.Text.RegularExpressions.Regex.IsMatch(line, @"^\d+\.\s");
                if (i > 0 && isNumberedLine)
                    result.AppendLine();  // Keep line break
                else if (i > 0)
                    result.Append(" ");   // Join with space
                result.Append(line);
                }
            await File.WriteAllTextAsync(outputPath, result.ToString());
            Snackbar.Add($"Finished ", Severity.Success);
            }
        catch (Exception ex)
            {
            Console.WriteLine($"Error: {ex.Message}");
            }
        }
    private async Task TruncateLines ()
        {
        try
            {
            string inputPath = @"d:\2025Uzb_.txt";
            string outputPath = @"d:\2025Uzbs.txt";
            var lines = await File.ReadAllLinesAsync(inputPath);
            //truncate to 300 chars
            var truncated = lines.Select(line =>
                line.Length > 300 ? line.Substring(0, 300) : line
            );
            await File.WriteAllLinesAsync(outputPath, truncated);
            Snackbar.Add($"Finished trunctaing ", Severity.Success);
            }
        catch (Exception ex)
            {
            Console.WriteLine($"Error: {ex.Message}");
            }
        }




    }
