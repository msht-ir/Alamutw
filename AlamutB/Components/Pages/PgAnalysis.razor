@page "/PgAnalysis"
@using System.Globalization
@using AlamutB.Service
@using System.Threading.Tasks
@inject FeService feService
@inject NavigationManager Navman
@inject AppState appState
@inject IJSRuntime JS
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="d-flex" style="display: flex; flex-direction: column; justify-content: center; align-items: center;">
    <h2 style="color:royalblue; font-style:italic">Analyses</h2>
    @if (_accountType.Trim() == "admin account")
        {
        <p style="font-size:large;font-style:italic;color:royalblue">@appState.UserNickname <span style="font-style:normal;font-size:x-small;color:darkgoldenrod"> @_accountType</span></p>
        }
    else if (_accountType.Trim() == "gold account")
        {
        <p style="font-size:large;font-style:italic;color:royalblue">@appState.UserNickname <span style="font-style:normal;font-size:x-small;color:darkgoldenrod"> @_accountType</span></p>
        }
    else if (_accountType.Trim() == "silver account")
        {
        <p style="font-size:large;font-style:italic;color:royalblue">@appState.UserNickname <span style="font-style:normal;font-size:x-small;color:gray"> @_accountType</span></p>
        }
    else if (_accountType.Trim() == "demo account")
        {
        <p style="font-size:large;font-style:italic;color:royalblue">@appState.UserNickname <span style="font-style:normal;font-size:x-small;color:green"> @_accountType</span></p>
        }
    </div>
<hr style="color:red" />
@if (!_hasFetched)
    {
    <_ScanSheets />
    }
else if (appState.Cmd == "cmdCreateNote")
    {
    <Modal_CreateNote />
    }
else
    {
        <EditForm Model="user">
            <MudStack Row
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Start"
                  Style="width:980px;"
                  Breakpoint="Breakpoint.SmAndDown">
            @* Pannel Left - MENU*@
                <MudStack>
                <MudText Style="color:indianred;">Analyses</MudText>
                    <MudToggleGroup T="String"
                                SelectionMode="SelectionMode.SingleSelection"
                                @bind-Value="_analysis"
                                @bind-Value:after="() => BtnAnalysisSelected(_analysis)"
                                Color="Color.Primary"
                                CheckMark FixedContent Vertical>
                    <MudToggleItem Value=@("fvalue")
                                   SelectedIcon="@Icons.Material.Outlined.Functions"
                                   Text="F-Value" />
                    <MudToggleItem Value=@("diversity")
                                   SelectedIcon="@Icons.Material.Outlined.InsertChart"
                                   Text="Diversity" />
                    <MudToggleItem Value=@("floran")
                                   SelectedIcon="@Icons.Material.Outlined.Grass"
                                   Text="FlorAn" />
                    <MudToggleItem Value=@("multivarfloran")
                                   SelectedIcon="@Icons.Material.Outlined.Window"
                                   Text="MultivarFlorAn" />
                    <MudToggleItem Value=@("comparesets")
                                   SelectedIcon="@Icons.Material.Outlined.JoinLeft"
                                   Text="Compare Sets" />
                    <MudToggleItem Value=@("association")
                                   SelectedIcon="@Icons.Material.Filled.InsertLink"
                                   Text="Association" />
                    <MudToggleItem Value=@("cooccurrence")
                                   SelectedIcon="@Icons.Material.Outlined.Dashboard"
                                   Text="Cooccurrence" />
                    <MudToggleItem Value=@("climagraph")
                                   SelectedIcon="@Icons.Material.Outlined.Cloud"
                                   Text="ClimaGraph" />
                    <MudToggleItem Value=@("multivarcliman")
                                   SelectedIcon="@Icons.Material.Outlined.Window"
                                   Text="MultivarClimAn" />
                    <MudToggleItem Value=@("help")
                                   SelectedIcon="@Icons.Material.Filled.LiveHelp"
                                   Text="Guide" />
                    <MudToggleItem Value=@("back")
                                   Text="Back to Menu"
                                   Style="color:indianred" />
                    </MudToggleGroup>
                </MudStack>
            @* Pannel Right *@
                <MudStack Style="width:740px;margin-top:30px">
                @if (_cmd == "")
                    {
                        <div class="d-flex justify-content-center">
                        <img src="/img/gifUserLogin.gif" width="52" />
                        </div>
                    }
                else if (_cmd == "help")
                    {
                    <CompInfoTech />
                    }
                else if ((_cmd == "fvalue") || (_cmd == "diversity") || (_cmd == "floran") || (_cmd == "multivarfloran") || (_cmd == "comparesets") || (_cmd == "association"))
                    {
                    <CompAnalysisSets AnalysisType="@_cmd" OnSelectedSetsReceived="GetSelectedSetsFromComponent" />
                    }
                else if (_cmd == "cooccurrence")
                    {
                    @* component for cooccurrence *@
                    }
                else if ((_cmd == "climagraph") || (_cmd == "multivarcliman"))
                    {
                    @* component for climagraph *@
                    }
                else if (_cmd == "ShowFloristicValueStatsResults")
                    {
                    <CompAnalysisFVResults lstSelectedDatasets="lstSelectedDatasets" FVStats="FVStats" OnAnalysisFVResultsClosed="BtnCloseAnalysisFVResults" />
                    }
                else if (_cmd == "ShowCalcDiversityResults")
                    {
                    <CompAnalysisDiversityResults lstSelectedDatasets="lstSelectedDatasets" lstDiversities="lstDiversities" OnAnalysisDiversityResultsClosed="BtnCloseAnalysisDiversityResults" />
                    }
                else if (_cmd == "ShowFlorAnResults")
                    {
                    <CompAnalysisFlorAnResults lstSelectedDatasets="lstSelectedDatasets" lstSpeciesFlorAn="lstSpeciesFlorAn" OnAnalysisFlorAnResultsClosed="BtnCloseAnalysisFlorAnResults" />
                    }
                else if (_cmd == "ShowMultivarFlorAnResults")
                    {
                    <CompAnalysisMultivarFlorAnResults lstSelectedDatasets="lstSelectedDatasets" lstOccurrenceData="lstOccurrenceData" OnAnalysisFlorAnResultsClosed="BtnCloseAnalysisMultivarFlorAnResults" />
                    }
                else if (_cmd == "ShowCompareSetsResults")
                    {
                    <CompAnalysisCompareSetsResults lstNetSpeciesListA="lstNetSpeciesListA" lstNetSpeciesListB="lstNetSpeciesListB" lstNetSpeciesListC="lstNetSpeciesListC" OnAnalysisCompareSetsResultsClosed="BtnCloseAnalysisCompareSetsResults" />
                    }
                else if (_cmd == "ShowAssociationResults")
                    {
                    <CompAnalysisAssociationResults lstOccurrenceData="lstOccurrenceData" lstSelectedDatasets="lstSelectedDatasets" lstNetSpeciesListA="lstNetSpeciesListA" lstAssociationResults="lstAssociationResults" OnAnalysisAssociationResultsClosed="BtnCloseAnalysisAssociationResults" />
                    }
                </MudStack>
            </MudStack>
        @if (_cmd.StartsWith("calculating association of"))
            {
            @* ProgressBar *@
                <MudCard Class="mx-0 mt-5">
                    <MudCardContent Style="background-color:rgba(240,240,240);">
                        <div class="d-flex justify-content-center">
                            <MudProgressCircular Style="height: 80px; width: 80px"
                                             Color="Color.Primary"
                                             Value="@progressPercent">
                                <ChildContent>
                                    <MudStack Spacing="0" AlignItems="AlignItems.Center" Justify="Justify.Center">
                                    <MudText Typo="Typo.subtitle2">alamut</MudText>
                                    <MudText Typo="Typo.subtitle2">@progressPercent %</MudText>
                                    </MudStack>
                                </ChildContent>
                            </MudProgressCircular>
                        </div>
                    <br />
                        <div class="d-flex justify-content-center">
                        <h6 style="color:indianred">@_cmd</h6>
                        </div>
                    <br />
                    <br />
                    </MudCardContent>
                </MudCard>
            }

        </EditForm>
    <br />
    <hr />
        <div class="gap-4" style="display: flex;  justify-content: center; align-items: center;">
            <button class="btn btn-link pulse-hover" @onclick="ScrollToTop">
            <img src="/img/icoGotoTop2.png" width="32" />
            </button>
        </div>
    }

@code {
    private string _analysis = "";
    User user = new User();

    public MudTextField<string> refFilterDatasets;
    public List<Set> lstSelectedSets = new List<Set>();
    public List<Dataset> lstSelectedDatasets = new List<Dataset>();
    public List<Species> lstSelectedSpecies = new List<Species>();
    public List<Diversity> lstDiversities = new List<Diversity>();
    public FV FVStats = new FV();
    public List<Species> lstSpeciesFlorAn = new List<Species>();
    public List<Occurrence> lstOccurrenceData = new List<Occurrence>();
    //comparesets
    public List<wfoSpeciesId> lstNetSpeciesListA = new List<wfoSpeciesId>();
    public List<wfoSpeciesId> lstNetSpeciesListB = new List<wfoSpeciesId>();
    public List<wfoSpeciesId> lstNetSpeciesListC = new List<wfoSpeciesId>();
    //association
    public List<AssociationResult> lstAssociationResults = new List<AssociationResult>();
    Set set = new Set();
    Dataset dataset = new Dataset();
    Species species = new Species();
    Diversity diversity = new Diversity();
    string _cmd = "";
    public bool _hasFetched = false;
    string _accountType = "";
    public int progressPercent = 0;

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        if (Convert.ToInt32(appState.UserLoginStatus) != 1)
            {
            Navman.NavigateTo("/Login");
            }
        appState.SetCmd("");
        user.UserId = Convert.ToInt32(appState.UserId);
        user.Username = appState.Username;
        user.UserTags = Convert.ToInt32(appState.UserTags);
        if (user.UserTags > 256)
            {
            _accountType = " admin account";
            }
        else if (user.UserTags > 128)
            {
            _accountType = " gold account";
            }
        else if (user.UserTags > 64)
            {
            _accountType = " silver account";
            Navman.NavigateTo("/Switchboard");
            }
        else
            {
            _accountType = " demo account";
            Navman.NavigateTo("/Switchboard");
            }
        _hasFetched = true;
        }
    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }
    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }

    //btns
    public void BtnAnalysisSelected (string _analysisName)
        {
        if (_analysisName == "back")
            {
            BtnBack();
            }
        else
            {
            _cmd = _analysisName;
            StateHasChanged();
            }
        }

    //rollbacks
    public async Task GetSelectedSetsFromComponent (List<Set> lstSelectedSets)
        {
        switch (_cmd)
            {
            case "diversity":
                    {
                    _hasFetched = false;
                    lstDiversities.Clear();
                    //pass set and subset to feService:
                    lstDiversities = await feService.Calc_Diversity(lstSelectedSets [0].SetId, lstSelectedSets [0].SelectedSubset);
                    //get list of Datasets (from distinct DatasetA, DatasetB)
                    lstSelectedDatasets = lstDiversities
                        .Select(x => new Dataset
                            {
                            DatasetId = x.DatasetIdA,
                            DatasetName = x.DatasetNameA,
                            //set as default
                            UserId = 0,
                            DatasetType = 0,
                            DatasetAbbr = "",
                            DatasetRef = "",
                            RefYear = 0,
                            RefLang = "",
                            DatasetManager = "",
                            AreaHa = 0,
                            ProvinceId = 0,
                            Coords = "",
                            AltMax = 0,
                            AltMin = 0,
                            AltAver = 0,
                            TempMax = 0,
                            TempMin = 0,
                            TempAver = 0,
                            Precipitation = 0,
                            DatasetTags = 0,
                            IsSelected = false
                            })
                        .Union(lstDiversities.Select(x => new Dataset
                            {
                            DatasetId = x.DatasetIdB,
                            DatasetName = x.DatasetNameB,
                            //set as default
                            UserId = 0,
                            DatasetType = 0,
                            DatasetAbbr = "",
                            DatasetRef = "",
                            RefYear = 0,
                            RefLang = "",
                            DatasetManager = "",
                            AreaHa = 0,
                            ProvinceId = 0,
                            Coords = "",
                            AltMax = 0,
                            AltMin = 0,
                            AltAver = 0,
                            TempMax = 0,
                            TempMin = 0,
                            TempAver = 0,
                            Precipitation = 0,
                            DatasetTags = 0,
                            IsSelected = false
                            }))
                        .DistinctBy(x => x.DatasetId) //distinct
                        .ToList();
                    _hasFetched = true;
                    _cmd = "ShowCalcDiversityResults";
                    break;
                    }
            case "fvalue":
                    {
                    _hasFetched = false;
                    lstSelectedDatasets = await feService.Read_DatasetsBySubsetIndex(lstSelectedSets [0].SetId, lstSelectedSets [0].SelectedSubset);
                    FVStats = await feService.Get_FloristicValueStats(lstSelectedSets [0].SetId, lstSelectedSets [0].SelectedSubset);
                    appState.SetSetName(lstSelectedSets [0].SetName);
                    _hasFetched = true;
                    _cmd = "ShowFloristicValueStatsResults";
                    break;
                    }
            case "floran":
                    {
                    _hasFetched = false;
                    lstSelectedDatasets = await feService.Read_DatasetsBySubsetIndex(lstSelectedSets [0].SetId, lstSelectedSets [0].SelectedSubset);
                    lstSpeciesFlorAn = await feService.Get_FlorAnData(lstSelectedSets [0].SetId, lstSelectedSets [0].SelectedSubset);
                    appState.SetSetName(lstSelectedSets [0].SetName);
                    _hasFetched = true;
                    _cmd = "ShowFlorAnResults";
                    break;
                    }
            case "comparesets":
                    {
                    //guard against: not 3 sets being selected
                    if (lstSelectedSets.Count() < 3)
                        {
                        Snackbar.Add($"three (3) sets must be selcted", Severity.Warning, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                        }
                    else
                        {
                        _hasFetched = false;
                        lstNetSpeciesListA = await feService.Get_SetxNetSpeciesList(lstSelectedSets [0].SetId, lstSelectedSets [0].SelectedSubset);
                        lstNetSpeciesListB = await feService.Get_SetxNetSpeciesList(lstSelectedSets [1].SetId, lstSelectedSets [1].SelectedSubset);
                        lstNetSpeciesListC = await feService.Get_SetxNetSpeciesList(lstSelectedSets [2].SetId, lstSelectedSets [2].SelectedSubset);
                        //keep sets names
                        appState.SetSetName(lstSelectedSets [0].SetName + " | " + lstSelectedSets [1].SetName + " | " + lstSelectedSets [2].SetName);
                        _hasFetched = true;
                        _cmd = "ShowCompareSetsResults";
                        }
                    break;
                    }
            case "association":
                    {
                    // _hasFetched = false;
                    //Read/Get from Database
                    lstOccurrenceData = await feService.Get_MultivarFlorAnData(lstSelectedSets [0].SetId, lstSelectedSets [0].SelectedSubset);
                    lstSelectedDatasets = await feService.Read_DatasetsBySetId(lstSelectedSets [0].SetId);
                    lstNetSpeciesListA = await feService.Get_SetxNetSpeciesList(lstSelectedSets [0].SetId, lstSelectedSets [0].SelectedSubset);
                    //log
                    Console.WriteLine($@"---- lstOccurrenceData: {lstOccurrenceData.Count()}, lstSelectedDatasets: {lstSelectedDatasets.Count()}, lstNetSpeciesListA: {lstNetSpeciesListA.Count()}");
                    //calc Results
                    lstAssociationResults.Clear();
                    string result = "";
                    int _recs = lstNetSpeciesListA.Count(); //temp use
                    _recs = _recs * (_recs - 1) / 2;
                    int cnt = 0;
                    for (int i = 0; i < lstNetSpeciesListA.Count - 1; i++)
                        {
                        for (int j = i + 1; j < lstNetSpeciesListA.Count; j++)
                            {
                            int hasSp1 = 0;
                            int hasSp2 = 0;
                            int A = 0;
                            int B = 0;
                            int C = 0;
                            int D = 0;
                            int N = 0;
                            double Ae = 0;
                            double Be = 0;
                            double Ce = 0;
                            double De = 0;
                            double Chi2 = 0;
                            string SpeciesAId = lstNetSpeciesListA [i].SpeciesId;
                            string SpeciesBId = lstNetSpeciesListA [j].SpeciesId;
                            foreach (Dataset ds in lstSelectedDatasets)
                                {
                                hasSp1 = lstOccurrenceData.Any(x => string.Equals(x.AcceptedId, SpeciesAId, StringComparison.OrdinalIgnoreCase)) ? 1 : 0;
                                hasSp2 = lstOccurrenceData.Any(x => string.Equals(x.AcceptedId, SpeciesBId, StringComparison.OrdinalIgnoreCase)) ? 1 : 0;
                                if ((hasSp1 == 1) & (hasSp2 == 1))
                                    {
                                    A++;
                                    }
                                if ((hasSp1 == 1) & (hasSp2 == 0))
                                    {
                                    B++;
                                    }
                                if ((hasSp1 == 0) & (hasSp2 == 1))
                                    {
                                    C++;
                                    }
                                if ((hasSp1 == 0) & (hasSp2 == 0))
                                    {
                                    D++;
                                    }
                                }
                            N = A + B + C + D;
                            Ae = (A + B) * (A + C) / N;
                            Be = (A + B) * (B + D) / N;
                            Ce = (C + D) * (A + C) / N;
                            De = (C + D) * (B + D) / N;
                            Chi2 = Math.Pow(Math.Abs(A * D - B * C), 2) * N / ((A + B) * (C + D) * (A + C) * (B + D));
                            if ((Chi2 > 3.84) & (A > Ae))
                                {
                                result = "association (+)";
                                }
                            else if ((Chi2 > 3.84) & (A <= Ae))
                                {
                                result = "association (-)";
                                }
                            else if ((Chi2 <= 3.84))
                                {
                                result = "association (x)";
                                }
                            else
                                {
                                result = "association (?)";
                                }
                            lstAssociationResults.Add(new AssociationResult
                                {
                                SpeciesA = "",
                                SpeciesB = "",
                                A = A,
                                B = B,
                                C = C,
                                D = D,
                                Ae = Ae,
                                Be = Be,
                                Ce = Ce,
                                De = De,
                                chi2 = Chi2,
                                result = result
                                });
                            cnt++;
                            if (cnt % 200 == 0)
                                {
                                //using mod200 to slowDown refreshing of pageProgressBar
                                Console.WriteLine($@"------ cnt: {cnt} / {_recs}");
                                progressPercent = (int) (((double) cnt / _recs) * 100);
                                _cmd = $"calculating association of {i.ToString()}";
                                StateHasChanged();
                                }
                            }
                        }
                    //keep sets names
                    appState.SetSetName("associations in:" + lstSelectedSets [0].SetName);
                    // _hasFetched = true;
                    _cmd = "ShowAssociationResults";
                    break;
                    }
            case "multivarfloran":
                    {
                    _hasFetched = false;
                    lstSelectedDatasets = await feService.Read_DatasetsBySubsetIndex(lstSelectedSets [0].SetId, lstSelectedSets [0].SelectedSubset);
                    lstOccurrenceData = await feService.Get_MultivarFlorAnData(lstSelectedSets [0].SetId, lstSelectedSets [0].SelectedSubset);
                    appState.SetSetName(lstSelectedSets [0].SetName);
                    _hasFetched = true;
                    _cmd = "ShowMultivarFlorAnResults";
                    break;
                    }
            case "cooccurrence":
                    {
                    Snackbar.Add($"selcted Sets received for cooccurrence!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            case "climagraph":
                    {
                    Snackbar.Add($"selcted Sets received for climagraph!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            case "multivarcliman":
                    {
                    Snackbar.Add($"selcted Sets received for multivarcliman!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            default:
                    {
                    Snackbar.Add($"selcted Sets received for ??!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            }
        }
    private void BtnCloseAnalysisDiversityResults ()
        {
        _cmd = "diversity";
        StateHasChanged();
        }
    private void BtnCloseAnalysisFVResults ()
        {
        _cmd = "fvalue";
        StateHasChanged();
        }
    private void BtnCloseAnalysisFlorAnResults ()
        {
        _cmd = "floran";
        StateHasChanged();
        }
    private void BtnCloseAnalysisMultivarFlorAnResults ()
        {
        _cmd = "multivarfloran";
        StateHasChanged();
        }
    private void BtnCloseAnalysisCompareSetsResults ()
        {
        _cmd = "comparesets";
        StateHasChanged();
        }
    private void BtnCloseAnalysisAssociationResults ()
        {
        _cmd = "association";
        StateHasChanged();
        }

    //methods
    private async Task ScrollToTop ()
        {
        await JS.InvokeVoidAsync("scrollToTop");
        }
    public string PersianDate (DateTimeOffset? dt)
        {
        if ((Convert.ToInt32(appState.UserTags) & 2) == 2)
            {
            return feService.ToPersianDate(dt.ToString());
            }
        else
            {
            return dt?.ToString("yyyy-MM-dd HH:mm");
            }
        }
    public void BtnHelp ()
        {
        _cmd = _cmd == "help" ? "" : "help";
        StateHasChanged();
        }
    private void BtnCancel ()
        {
        _cmd = "";
        StateHasChanged();
        }
    public void BtnBack ()
        {
        Navman.NavigateTo("/Switchboard");
        }
    }
