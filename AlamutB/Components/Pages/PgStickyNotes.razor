@page "/PgStickyNotes"
@using System.Globalization
@using AlamutB.Service
@using System.Threading.Tasks
@inject FeService feService
@inject NavigationManager Navman
@inject AppState appState
@inject IJSRuntime JS
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<h5 style="text-align:center;padding-left:5px;">stickys Notes - <span style="font-size:smaller;text-align:center;color:indianred">@appState.UserNickname</span></h5>
<hr style="color:red" />
    @if (!_hasFetched)
    {
    <_ScanSheets />
    }
else
    {
    @if (lstNotes.Count > 0)
        {
        @* <div style="max-width:500px; margin: 0 auto;"> *@
            <div class="flex gap-4" style="text-align: center; margin:15px;">
                <button class="btn btn-link pulse-hover" @onclick="BtnBack">
                <img src="/img/icoList1.png" width="28" title="back" />
                </button>
                <button class="btn btn-link pulse-animation" @onclick="CreateNote">
                <img src="/img/icoNoteStickyAdd.png" width="28" title="add new quick-note" />
                </button>
            </div>
        }
        <EditForm Model="lstNotes">
        @if (appState.Cmd == "cmdShowNoteInDialog")
            {
            <Modal_ShowNote OnClose="HandleModalClose" />
            }
        else if (appState.Cmd == "cmdUpdateNote")
            {
            <Modal_CreateNote OnClose="HandleModalClose" />
            }
        else if (appState.Cmd == "cmdCreateNote")
            {
            <Modal_CreateNote OnClose="HandleModalClose" />
            }
        else
            {
            @foreach (Note notex in lstNotes)
                {
                var isRtl = (notex.NoteTags & 1) == 1;
                var isLongText = notex.NoteText.Length > 100;
                var isMoving = (_cmd == "cmdMoveNoteToNotebook") && (Convert.ToInt32(appState.NoteId) == notex.NoteId);
                var dateToShow = notex.IsTodo ? PersianDate(notex.NoteDateTimeDue) : PersianDate(notex.NoteDateTime);
                var fontFamily = isRtl ? "'Segoe UI'" : "Courier New, Courier, monospace";
                var textAlign = isRtl ? "text-end" : "text-start";
                    <div class="mt-3 @textAlign">
                        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                            <MudCard Class="mx-0">
                                <MudCardContent Style="background-color:whitesmoke;">
                                <!-- Date/Time -->
                                    <span class="d-flex align-items-center" style="text-align:center; color:indianred; font-weight:bold; font-size:smaller; margin:0px;">
                                    @if (notex.IsTodo)
                                        {
                                        <img class="pulse-hover" src="/img/icoClockRed.png" width="20" style="margin-right:7px" />
                                        }
                                    @dateToShow
                                    </span>
                                <hr />

                                <!-- Note Text -->
                                    <div style="white-space: pre-wrap; font-family:@fontFamily; font-size:small; @(isRtl ? "font-weight:normal" : "font-weight:bold")">
                                    @if (isLongText)
                                        {
                                        <div>@notex.NoteText.Substring(0, 100) <span style="font-size:xx-small;font-weight:bold;color:indianred">[...]</span></div>
                                        }
                                    else
                                        {
                                        <div>@notex.NoteText</div>
                                        }
                                    </div>
                                <hr />

                                @if (isMoving)
                                    {
                                    <h6 style="color:indianred;text-align:center;">move to:</h6>
                                        <div class="d-flex">
                                            <MudSelect T="int"
                                                   @ref="refNotebooks"
                                                   Label="Notebook"
                                                   Value="NotebookId"
                                                   ValueChanged="OnNotebookChanged"
                                                   Class="w-auto my-select"
                                                   Variant="Variant.Text"
                                                   Margin="Margin.Dense"
                                                   Style="color:royalblue;width:140px;font-size:small;">
                                            <MudSelectItem Value="0">Select a Notebook...</MudSelectItem>
                                            @foreach (var notebook in lstNotebooks)
                                                {
                                                <MudSelectItem Value="@notebook.NotebookId">@notebook.NotebookName</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </div>
                                        <div class="d-flex align-content-center align-items-center align-content-md-center">
                                            <MudSelect T="int"
                                                   @ref="refSections"
                                                   Label="Section"
                                                   Value="SectionId"
                                                   ValueChanged="OnSectionChanged"
                                                   Class="w-auto my-select"
                                                   Variant="Variant.Text"
                                                   Margin="Margin.Dense"
                                                   Style="color:royalblue;width:140px;font-size:small;">
                                            <MudSelectItem Value="0">Select a Section...</MudSelectItem>
                                            @foreach (var section in lstSections)
                                                {
                                                <MudSelectItem Value="@section.SectionId">@section.SectionName</MudSelectItem>
                                                }
                                            </MudSelect>
                                            <button class="btn btn-link pulse-animation" Title="move!" @onclick='() => BtnMovetoSelectSection(SectionId, notex)'>
                                            <img src="/img/icoMoveToNoteBook.png" width="34" />
                                            </button>
                                            <button class="btn btn-link pulse-hover" Title="cancel" @onclick='() => BtnCancel()'>
                                            <img src="/img/icoCancel.png" width="20" />
                                            </button>
                                        </div>
                                    }
                                else
                                    {
                                        <div class="d-flex align-items-center" style="color:indianred; font-weight:bold;font-size:small">
                                            <MudMenu Label="actions" Variant="Variant.Outlined" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Menu" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Dense="true">
                                                <MudMenuItem @onclick="() => BtnEditNoteInDialog(notex)">
                                                    <button class="btn btn-link pulse-animation">
                                                    <img src="/img/icoRename.png" width="28" title="ويرايش يادداشت" />
                                                    </button>
                                                edit
                                                </MudMenuItem>
                                                <MudMenuItem @onclick="() => BtnMoveNote(notex.NoteId)">
                                                    <button class="btn btn-link">
                                                    <img src="/img/icoMoveToNoteBook.png" width="32" title="انتقال يادداشت به دفترچه" />
                                                    </button>
                                                move to notebook
                                                </MudMenuItem>
                                                <MudMenuItem @onclick="() => BtnDeleteNote(notex.NoteId)">
                                                    <button class="btn btn-link">
                                                    <img src="/img/icoDelete1.png" width="22" title="حذف يادداشت" />
                                                    </button>
                                                delete note
                                                </MudMenuItem>
                                            </MudMenu>
                                        @if (isLongText)
                                            {
                                                <button class="btn btn-link pulse-animation" @onclick="() => BtnShowNoteInDialog(notex)">
                                                <img src="/img/icoNoteSticky2.png" width="22" title="نمايش يادداشت در صفحه" />
                                                </button>
                                            }
                                        </div>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudContainer>
                    </div>
                }
            }
        </EditForm>
    }
<br />
<br />
@if (lstNotes.Count > 0)
    {
        <div style="text-align:center">
        @* <div style="max-width:500px; margin: 0 auto;"> *@
            <button class="btn btn-link pulse-hover" @onclick="BtnBack">
            <img src="/img/icoList1.png" width="28" />
            </button>
            <button class="btn btn-link pulse-hover" @onclick="ScrollToTop">
            <img src="/img/icoGotoTop1.png" width="28" />
            </button>
        </div>
    }
else
    {
        <div style="max-width:500px; margin: 0 auto;">
        @* <div style="text-align:center"> *@
            <button class="btn btn-link pulse-hover" @onclick="BtnBack">
            <img src="/img/gifUserLogin.gif" width="70" />
            </button>
        </div>
    }
    <script>
    window.scrollToTop = () => { window.scrollTo({ top: 0, behavior: 'smooth' }); };
    </script>


@code {
    private ElementReference topElement;
    private MudSelect<int> refNotebooks;
    private MudSelect<int> refSections;
    int NotebookId = 0;
    int SectionId = 0;
    string _cmd = "";

    User user = new User();
    List<Note> lstNotes = new List<Note>();
    List<Notebook> lstNotebooks = new List<Notebook>();
    List<Section> lstSections = new List<Section>();
    string _ShowNotebooksMode = "active";
    public bool _hasFetched = false;

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        if (Convert.ToInt32(appState.UserLoginStatus) != 1)
            {
            Navman.NavigateTo("/Login");
            }
        appState.SetCmd("");
        user.UserId = Convert.ToInt32(appState.UserId);
        user.Username = appState.Username;
        lstNotes = await feService.Read_Notes(13, user.UserId);
        await GetListOfNotebooks(user.UserId, _ShowNotebooksMode);
        _hasFetched = true;
        }
    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }
    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }
    //btns
    public void GotoNotebooks ()
        {
        appState.SetReturnPage($"PgStickyNotes");
        Navman.NavigateTo("/PgNoteBooks");
        }
    private async Task OnNotebookChanged (int newValue)
        {
        NotebookId = newValue;
        //appState.SetNotebookId(NotebookId);
        SectionId = 0;
        await FilterSections(NotebookId);
        StateHasChanged();
        }
    private async Task OnSectionChanged (int newValue)
        {
        SectionId = newValue;
        //appState.SetSectionId(SectionId);
        StateHasChanged();
        }
    private void BtnMoveNote (int noteId)
        {
        if (Convert.ToInt32(appState.NoteId) == noteId)
            {
            _cmd = (_cmd == "cmdMoveNoteToNotebook") ? "" : "cmdMoveNoteToNotebook";
            }
        else
            {
            appState.SetNoteId(noteId);
            _cmd = "cmdMoveNoteToNotebook";
            }
        StateHasChanged();
        }
    private async Task BtnMovetoSelectSection (int sectionId, Note notex)
        {
        if (sectionId > 0)
            {
            notex.RefType = 12;
            notex.RefId = sectionId;
            bool result = await feService.Update_Note(notex);
            if (result)
                {
                Snackbar.Add("note moved to notebook", Severity.Success);
                _cmd = "";
                appState.SetCmd("");
                lstNotes = await feService.Read_Notes(13, user.UserId);
                StateHasChanged();
                }
            else
                {
                Snackbar.Add("failed", Severity.Warning);
                }
            }
        else
            {
            Snackbar.Add("select notebook and section", Severity.Info);
            }
        }
    private void BtnCancel ()
        {
        _cmd = "";
        StateHasChanged();
        }
    public void BtnBack ()
        {
        Navman.NavigateTo("/Switchboard");
        }
    //convert date
    public string PersianDate (DateTimeOffset? dt)
        {
        if ((Convert.ToInt32(appState.UserTags) & 256) == 256)
            {
            return feService.ToPersianDate(dt.ToString());
            }
        else
            {
            return dt?.ToString("yyyy-MM-dd HH:mm");
            }
        }
    //
    private async Task ScrollToTop ()
        {
        await JS.InvokeVoidAsync("scrollToTop");
        }
    public async Task CreateNote ()
        {
        appState.SetNoteRefType(13);
        appState.SetNoteRefId(Convert.ToInt32(appState.UserId));
        appState.SetCmd("cmdCreateNote");
        StateHasChanged();
        //After the Modal_CreateNote is closed, HandleModalClose will refresh the list
        //to handel close event, I added in the Modal_CreateNote: [Parameter] public EventCallback OnClose
        }
    public async Task BtnShowNoteInDialog (Note note)
        {
        appState.SetSelectedNoteId(note.NoteId);
        appState.SetNoteDateTime(note.NoteDateTime.ToString("yyyy-MM-dd HH:mm"));
        appState.SetNoteDateTimeDue(note.NoteDateTimeDue?.ToString("yyyy-MM-dd HH:mm")); //use ? becuse note.NoteDateTimeDue is nullable
        appState.SetNoteText(note.NoteText);
        appState.SetNoteTags(note.NoteTags);
        appState.SetNoteRefId(note.RefId);
        appState.SetNoteRefType(note.RefType);
        appState.SetCmd("cmdShowNoteInDialog");
        StateHasChanged();
        //After the Modal_ShowNote is closed, HandleModalClose will refresh the list
        //to handel close event, I added in the Modal_ShowNote: [Parameter] public EventCallback OnClose
        }
    public async Task BtnEditNoteInDialog (Note note)
        {
        appState.SetSelectedNoteId(note.NoteId);
        appState.SetNoteDateTime(note.NoteDateTime.ToString("yyyy-MM-dd HH:mm"));
        appState.SetNoteDateTimeDue(note.NoteDateTimeDue?.ToString("yyyy-MM-dd HH:mm")); //use ? becuse note.NoteDateTimeDue is nullable
        appState.SetNoteText(note.NoteText);
        appState.SetNoteTags(note.NoteTags);
        appState.SetNoteRefId(note.RefId);
        appState.SetNoteRefType(note.RefType);
        // appState.SetNoteRefName(note.RefName);
        appState.SetCmd("cmdUpdateNote");
        StateHasChanged();
        //After the Modal_CreateNote is closed, HandleModalClose will refresh the list
        //to handel close event, I added in the Modal_CreateNote: [Parameter] public EventCallback OnClose
        }
    public async Task BtnDeleteNote (int noteId)
        {
        var message = new MarkupString($@"
        <hr><span style='color:indianred'>Delete</span>
        note ? Are you sure ?
        < br >
        < br > < div style = 'text-align:center' >< img src = '/img/icoDelete1.png' width = '40' /></ div >
        < br >
        < hr > ");
        bool? confirmResult = await DialogService.ShowMessageBox(title: "Confirm", markupMessage: message, yesText: "Yes", cancelText: "No");
        if (confirmResult == true)
            {
            bool result = await feService.Delete_Note(noteId);
            if (result)
                {
                Snackbar.Add($"deleted", Severity.Warning);
                user.UserId = Convert.ToInt32(appState.UserId);
                _hasFetched = false;
                lstNotes.Clear();
                lstNotes = await feService.Read_Notes(13, user.UserId);
                _hasFetched = true;
                appState.SetCmd("");
                StateHasChanged();
                }
            else
                {
                Snackbar.Add($"Failed to delete note!", Severity.Error, opt => { opt.VisibleStateDuration = 1500; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                }
            }
        }
    private async Task HandleModalClose ()
        {
        _hasFetched = false;
        lstNotes.Clear();
        lstNotes = await feService.Read_Notes(13, user.UserId);
        _hasFetched = true;
        StateHasChanged();
        }
    public async Task GetListOfNotebooks (int userId, string mode)
        {
        _hasFetched = false;
        lstNotebooks.Clear();
        lstNotebooks = await feService.Read_Notebooks(userId);
        _hasFetched = true;
        }
    private async Task FilterSections (int notebookId)
        {
        lstSections.Clear();
        foreach (Notebook notebook in lstNotebooks)
            {
            if (notebook.NotebookId == notebookId)
                {
                lstSections = notebook.Sections;
                return;
                }
            }
        }
    }

    