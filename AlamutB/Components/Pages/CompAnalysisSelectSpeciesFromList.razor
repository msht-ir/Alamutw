@using System.Globalization
@using AlamutB.Service
@using System.Threading.Tasks
@inject FeService feService
@inject NavigationManager Navman
@inject AppState appState
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService

 @if (!_hasFetched)
    {
    <_ScanSheets />
    }
else
    {
        <EditForm Model="lstSpecies">
            <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-0">
                <MudCard Class="mx-0">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                    @* LIST Species *@
                    <h6 style="text-align:center;color:royalblue">species <span style="font-size:x-small;color:indianred"> ( @lstSpecies.Count() )</span></h6>
                    <hr style="color:indianred" />
                    @* Filter *@
                        <div class="d-flex">
                        <MudTextField @ref="refFilterSpeciesList"
                                      @bind-Value="_speciesListFilter"
                                      Label="search species"
                                      Variant="Variant.Text"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      OnAdornmentClick='@(() => FilterSpeciesList(_speciesListFilter))'
                                      Class="my-textfield" />
                        @* Refresh *@
                            <button type="button"
                                class="btn btn-link"
                                style="margin-left:1px"
                                @onclick='() => BtnShowAllSpecies()'
                                Title="Show species">
                            <img src="/img/icoList1.png" width="22" />
                            </button>
                        </div>
                    <br />
                    <hr />
                    @foreach (Species sp in lstSpecies)
                        {
                            <div class="d-flex align-items-center mb-1">
                            <input class="form-check-input"
                                   style="margin-left:1px;margin-right:10px;"
                                   type="checkbox"
                                   @bind="sp.IsSelected" />
                            @sp.SciName
                            </div>
                        }
                    <br />
                    <hr />
                        <div class="d-flex justify-content-center">
                            <button class="btn btn-link pulse-hover"
                                @onclick="RollbackListOfSelectedSpecies">
                            <img src="/img/icoGo.png" width="28" />
                            </button>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        </EditForm>
    }
<br />

