@page "/PgCheckName"
@using System.Globalization
@using AlamutB.Service
@using System.Threading.Tasks
@inject FeService feService
@inject NavigationManager Navman
@inject AppState appState
@inject IJSRuntime JS
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using ClosedXML.Excel
@using Microsoft.Extensions.Hosting
@using ClosedXML
@using Microsoft.VisualBasic
@using OfficeOpenXml;

    <div class="d-flex" style="display: flex; flex-direction: column; justify-content: center; align-items: center;">
    <h2 style="color:royalblue; font-style:italic">CheckName </h2>
    <span style="font-size:smaller;text-align:center;color:indianred">@appState.UserNickname</span>
    </div>
<hr style="color:red" />
@if (!_hasFetched)
    {
    <_ScanSheets />
    }
else if (appState.Cmd == "ShowNoteInDialog")
    {
    <Modal_ShowNote OnClose="HandleModalClose" />
    }
else if (appState.Cmd == "cmdCreateNote")
    {
    <Modal_CreateNote />
    }
else
    {
        <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-0">
            <MudIconButton OnClick="BtnBack"
                           Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Title="Switchboard" />
                <button class="btn btn-link pulse-hover" @onclick="BtnAddNewDataset">
                <img src="/img/icoAdd1.png" width="24" />
                </button>
        </MudContainer>
        <EditForm Model="lstNotes">
        @* ADD NEW DATASET *@
        @if (_cmd1 == "cmdAddNewDataset")
            {
            <br />
                <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-1 mb-4 px-0">
                    <MudCard Class="mx-0">
                        <MudCardContent Style="background-color:rgba(240,240,240);">
                        @* SHOW COMPONENT *@
                        <CompDataset dataset="dataset" OnClose="CloseComponent" />
                        </MudCardContent>
                    </MudCard>
                </MudContainer>
            }
        <hr style="border-color:red" />
        @* FILTER *@
            <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-0">
                <MudCard Class="mx-0">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                    <h6 style="text-align:center;color:royalblue">Dataset<span style="font-size:x-small;color:indianred"> ( @lstDatasets.Count() )</span></h6>
                    <hr style="color:indianred" />
                        <div class="d-flex">
                        <MudTextField @ref="refFilterDatasets"
                                      @bind-Value="_datasetFilter"
                                      Label="filter datasets"
                                      Variant="Variant.Text"
                                      Margin="Margin.Dense"
                                      Autocomplete="off"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      OnAdornmentClick="@(() => FilterDatasets (_datasetFilter))"
                                      Class="my-textfield" />
                            <button class="btn btn-link" style="margin-left:20px;" Title="show all" @onclick="BtnShowAllDatasets">
                            <img src="/img/icoList1.png" width="20" />
                            </button>
                        </div>
                    <br />
                    <br />
                    @* LIST DataSets *@
                    @foreach (Dataset dataset in lstDatasets)
                        {
                            <div class="d-flex align-items-center mb-1">
                            @* Select *@
                            <input class="form-check-input"
                                   style="margin-left:1px;margin-right:1px;"
                                   type="checkbox"
                                   @bind="dataset.IsSelected" />
                            @* Import *@
                                <button class="btn btn-link" @onclick="() => BtnImportFromExcelFile(dataset.DatasetId)">
                                <img src="/img/icoFileExcel.png" width="20" title="import tests from excel" />
                                </button>
                            @* Note *@
                                <button type="button"
                                    class="btn btn-link"
                                    style="margin-left:1px"
                                    @onclick='() => BtnCreateNoteForDataset(dataset.DatasetId)'
                                    Title=@($"note for dataset id: {dataset.DatasetId}")>
                                <img src="/img/icoNoteStickyAdd.png" width="22" />
                                </button>
                            @* Edit *@
                                <button type="button"
                                    class="btn btn-link"
                                    style="margin-left:1px"
                                    @onclick='() => BtnEditDataset(dataset)'
                                    Title=@($"edit dataset id: {dataset.DatasetId}")>
                                <img src="/img/icoRename.png" width="24" />
                                </button>
                            @* List taxa *@
                                <button type="button"
                                    class="btn btn-link"
                                    style="margin-left:1px"
                                    @onclick='() => BtnListDatasetDataOfDataset(dataset.DatasetId, true)'
                                    Title=@($"show list of species in dataset id: {dataset.DatasetId}")>
                                <img src="/img/icoList1.png" width="22" />
                                </button>
                            <span style="font-size:small;font-weight:normal;margin-left:10px;color:darkslategrey">@dataset.DatasetName</span>
                            &nbsp;
                            <span style="color:indianred;font-size:x-small;font-weight:normal;"> &nbsp; (<span style="color:royalblue;font-size:x-small;font-weight:normal;"> @dataset.DatasetId </span>) </span>
                            </div>
                        @if ((_cmd1 == "cmdImportDatasetData") && (dataset.DatasetId == _datasetId))
                            {
                            @* Import *@
                            <br />
                                <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-1 mb-4 px-0">
                                    <MudCard Class="mx-0">
                                        <MudCardContent Style="background-color:rgba(240,240,240);">
                                            <div>
                                            <span style="font-size:smaller">Select Excel file containing raw data for: <span style="color:indianred">@dataset.DatasetName</span></span>
                                            <br />
                                            <br />
                                            <InputFile OnChange="HandleFileSelected" title="Refer to Alamut guide for correct Excel format" />
                                            </div>
                                        </MudCardContent>
                                    </MudCard>
                                </MudContainer>
                            }
                        else if ((_cmd1 == "ShowWorksheetNames") && (dataset.DatasetId == _datasetId))
                            {
                            @* Worksheets *@
                            <br />
                                <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-0">
                                    <MudCard Class="mx-0">
                                        <MudCardContent Style="background-color:rgba(240,240,240);">
                                        <br />
                                            <div class="d-flex">
                                                <MudSelect T="string"
                                                       @ref="refWorksheets"
                                                       Label="excel worksheet"
                                                       Value="WorksheetName"
                                                       ValueChanged="@((string worcksheetname) => OnWorksheetChanged(worcksheetname))"
                                                       Class="w-auto"
                                                       Variant="Variant.Text"
                                                       Margin="Margin.Dense"
                                                       Style="font-size:small;">
                                                @foreach (string ws in lstWorksheets)
                                                    {
                                                    <MudSelectItem Value="@ws">@ws</MudSelectItem>
                                                    }
                                                </MudSelect>
                                                <button class="btn btn-link" Title="import from excel" @onclick="() => ReadExcelAsync()">
                                                <img src="/img/icoGo.png" width="36" />
                                                </button>
                                                <button class="btn btn-link" style="margin-right:20px;" @onclick="BtnCancel">
                                                <img src="/img/icoCancel.png" width="24" />
                                                </button>
                                            </div>
                                        </MudCardContent>
                                    </MudCard>
                                </MudContainer>
                            }
                        else if ((_cmd1 == "cmdEditDataset") && (dataset.DatasetId == _datasetId))
                            {
                            @* Edit Dataset *@
                            <br />
                                <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-1 mb-4 px-0">
                                    <MudCard Class="mx-0">
                                        <MudCardContent Style="background-color:rgba(240,240,240);">
                                        @* SHOW COMPONENT *@
                                        <CompDataset dataset="dataset" OnClose="CloseComponent" />
                                        </MudCardContent>
                                    </MudCard>
                                </MudContainer>
                            }

                        else if ((_cmd1 == "cmdListDatasetData") && (dataset.DatasetId == _datasetId))
                            {
                            @* LIST Dataset Data *@
                            if (_cmd2.StartsWith("CheckName is processing row"))
                                {
                                @* ProgressBar for Import *@
                                    <MudCard Class="mx-0">
                                        <MudCardContent Style="background-color:rgba(240,240,240);">
                                            <div class="d-flex justify-content-center">
                                                <MudProgressCircular Style="height: 80px; width: 80px"
                                                                 Color="Color.Primary"
                                                                 Value="@progressPercent">
                                                    <ChildContent>
                                                        <MudStack Spacing="0" AlignItems="AlignItems.Center" Justify="Justify.Center">
                                                        <MudText Typo="Typo.subtitle2">alamut</MudText>
                                                        <MudText Typo="Typo.subtitle2">@progressPercent %</MudText>
                                                        </MudStack>
                                                    </ChildContent>
                                                </MudProgressCircular>
                                            </div>
                                        <br />
                                            <div class="d-flex justify-content-center">
                                            <h6 style="color:indianred">@_cmd2</h6>
                                            </div>
                                        <br />
                                        <br />
                                        </MudCardContent>
                                    </MudCard>
                                }
                            else
                                {
                                @* LIST SPECIES *@
                                    <MudCard Class="mx-0">
                                        <MudCardContent Style="background-color:rgba(240,240,240);">
                                        <h6 style="text-align:center;color:royalblue">Dataset species <span style="font-size:x-small;color:indianred"> ( count @lstDatasetData.Count() )</span></h6>
                                        @* CHECKNAME to ENCODE LIST *@
                                            <div class="d-flex justify-content-center">
                                                <button type="button"
                                                    class="btn btn-link"
                                                    style="margin-left:1px"
                                                    @onclick='() => CheckNameDataset(dataset)'
                                                    Title="perform CheckName">
                                                <img src="/img/icoCheckName0.png" width="36" />
                                                </button>
                                            </div>
                                        <hr style="color:indianred" />
                                        @* Filter Taxa *@
                                            <div class="d-flex">
                                            <MudTextField @ref="refFilterSpeciesList"
                                                          @bind-Value="_speciesListFilter"
                                                          Label="search current items"
                                                          Variant="Variant.Text"
                                                          Margin="Margin.Dense"
                                                          Immediate="true"
                                                          Style="margin-left:5px;"
                                                          Adornment="Adornment.Start"
                                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                                          OnAdornmentClick='@(() => FilterSpeciesList(_speciesListFilter))'
                                                          Class="my-textfield" />
                                            @* Refresh List of Taxa *@
                                                <button type="button"
                                                    class="btn btn-link"
                                                    style="margin-left:1px;margin-left:10px"
                                                    @onclick='() => BtnListDatasetDataOfDataset(dataset.DatasetId, false)'
                                                    Title="list all">
                                                <img src="/img/icoList1.png" width="22" />
                                                </button>
                                            @* List unparsed Taxa *@
                                                <button type="button"
                                                    class="btn btn-link"
                                                    style="margin-left:1px"
                                                    @onclick='() => BtnListUnparsedDatasetData()'
                                                    Title="list unparsed items">
                                                <img src="/img/icoListExclam.png" width="30" />
                                                </button>
                                            </div>
                                        <br />
                                        <br />
                                            <table class="table table-borderless table-sm" style="margin-bottom: 0; border-collapse: collapse;">
                                                <tr>
                                                <th style="padding: 1px 1px;">Raw Data </th>
                                                <th style="padding: 1px 1px;">Fetched SciName</th>
                                                </tr>
                                            @foreach (DatasetData datasetData in lstDatasetData)
                                                {
                                                @* now, List *@
                                                    <tr>
                                                        <td>
                                                            <div class="d-flex align-items-center mb-1">
                                                            @if ((_cmd2 == "EditDatasetData") && (datasetData.DatasetDataId == _datasetDataId))
                                                                {
                                                                @* Edit LineString *@
                                                                    <tr>
                                                                        <td>
                                                                            <div class="d-flex">
                                                                            <MudTextField @ref="refEditDatasetData"
                                                                                          @bind-Value="datasetData.LineString"
                                                                                          Label="edit"
                                                                                          Variant="Variant.Text"
                                                                                          Margin="Margin.Dense"
                                                                                          Autocomplete="off"
                                                                                          Adornment="Adornment.End"
                                                                                          AdornmentIcon="@Icons.Material.Filled.Save"
                                                                                          OnAdornmentClick="@(() => UpdateDatasetData (datasetData))"
                                                                                          AdornmentColor="Color.Dark"
                                                                                          Style="color:darkblue;width:400px;"
                                                                                          Class="my-textfield" />
                                                                                <button class="btn btn-link" style="margin-left:10px;" Title="cancel" @onclick="BtnCancelEditDatasetData">
                                                                                <img src="/img/icoCancel.png" width="18" />
                                                                                </button>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            else
                                                                {
                                                                <input class="form-check-input"
                                                                       style="margin-left:1px;margin-right:1px;"
                                                                       type="checkbox"
                                                                       @bind="datasetData.IsSelected" />
                                                                    <button type="button"
                                                                        class="btn btn-link"
                                                                        style="margin-left:1px"
                                                                        @onclick='@(() => BtnRemoveSpeciesFromDataset(datasetData.DatasetDataId))'
                                                                        Title="delete">
                                                                    <img src="/img/icoDelete1.png" width="18" />
                                                                    </button>
                                                                    <button type="button"
                                                                        class="btn btn-link"
                                                                        style="margin-left:1px"
                                                                        @onclick='@(() => BtnCheckNameThisDatasetData(datasetData))'
                                                                        Title="edit">
                                                                    <img src="/img/icoSearch.png" width="20" />
                                                                    </button>
                                                                <span style="color:darkblue;font-size:smaller">@datasetData.LineString </span>
                                                                }
                                                            <br />
                                                            </div>
                                                        </td>
                                                        <td>
                                                        <span style="font-size:smaller">@(datasetData.ParsedGenus + ' ' + datasetData.ParsedEpithet + ' ' + datasetData.Infraspecific) </span>
                                                        </td>
                                                    </tr>
                                                @if ((_cmd2 == "CheckNameThisDatasetData") && (datasetData.DatasetDataId == _datasetDataId))
                                                    {
                                                        <MudCard Class="mx-0">
                                                            <MudCardContent Style="background-color:rgba(230,230,230);width:100%;">
                                                                <div class="d-flex gap-4">
                                                                <MudNumericField @ref="refCheckNameThisDatasetDataChars"
                                                                                 @bind-Value="intCheckNameThisDatasetDataChars"
                                                                                 Label="use leading chars"
                                                                                 Variant="Variant.Text"
                                                                                 Margin="Margin.Dense"
                                                                                 Autocomplete="off"
                                                                                 Adornment="Adornment.End"
                                                                                 AdornmentIcon="@Icons.Material.Filled.List"
                                                                                 OnAdornmentClick="@(() => DoCheckNameThisDatasetData (datasetData, false, intCheckNameThisDatasetDataChars))"
                                                                                 AdornmentColor="Color.Dark"
                                                                                 Style="color:darkblue;width:400px;margin-left:10px;width:120px;"
                                                                                 Class="my-textfield" />
                                                                <MudTextField T="string"
                                                                              @ref="refSearchSpecies"
                                                                              @bind-Value="_speciesSearchText"
                                                                              OnKeyDown="HandleKey_SearchboxSpecies"
                                                                              Label="search species"
                                                                              Variant="Variant.Text"
                                                                              Margin="Margin.Dense"
                                                                              Immediate="true"
                                                                              Adornment="Adornment.Start"
                                                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                                                              OnAdornmentClick='()=>SearchSpecies(_speciesSearchText)'
                                                                              Style="font-family:Tahoma;"
                                                                              Class="my-textfield" />
                                                                </div>
                                                            <br />
                                                                <div class="d-flex">
                                                                <MudTextField @ref="refEditDatasetData"
                                                                              @bind-Value="datasetData.LineString"
                                                                              Label="edit"
                                                                              Variant="Variant.Text"
                                                                              Margin="Margin.Dense"
                                                                              Autocomplete="off"
                                                                              Adornment="Adornment.End"
                                                                              AdornmentIcon="@Icons.Material.Filled.Save"
                                                                              OnAdornmentClick="@(() => UpdateDatasetData (datasetData))"
                                                                              AdornmentColor="Color.Dark"
                                                                              Style="color:darkblue;width:500px;"
                                                                              Class="my-textfield" />
                                                                </div>
                                                                <div class="d-flex justify-content-center align-items-center">
                                                                    <button class="btn btn-link" style="margin-left:10px;" Title="cancel" @onclick="BtnCancelEditDatasetData">
                                                                    <img src="/img/icoCancel.png" width="18" />
                                                                    </button>
                                                                </div>
                                                            </MudCardContent>
                                                        </MudCard>
                                                    }
                                                @if ((_cmd2 == "CheckNameLetSearchLineString") && (datasetData.DatasetDataId == _datasetDataId))
                                                    {
                                                    @* Search species *@
                                                        <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-0">
                                                            <MudCard Class="mx-auto">
                                                                <MudCardContent Style="background-color:rgba(249,249,249);">
                                                                    <div class="d-flex align-content-center align-items-center">
                                                                    <MudTextField T="string"
                                                                                  @ref="refSearchSpecies"
                                                                                  @bind-Value="_speciesSearchText"
                                                                                  OnKeyDown="HandleKey_SearchboxSpecies"
                                                                                  Label="search species"
                                                                                  Variant="Variant.Text"
                                                                                  Margin="Margin.Dense"
                                                                                  Immediate="true"
                                                                                  Adornment="Adornment.Start"
                                                                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                                                                  OnAdornmentClick='()=>SearchSpecies(_speciesSearchText)'
                                                                                  Style="font-family:Tahoma;"
                                                                                  Class="my-textfield" />
                                                                    </div>
                                                                </MudCardContent>
                                                            </MudCard>
                                                        </MudContainer>

                                                    }
                                                @if ((_cmd2 == "ShowCheckNameThisDatasetData") && (datasetData.DatasetDataId == _datasetDataId))
                                                    {
                                                        <tr>
                                                            <td>
                                                                <div>
                                                                    <MudCard Class="mx-0">
                                                                        <MudCardContent Style="background-color:rgba(230,230,230);width:100%;">
                                                                        @if (lstSpecies.Any())
                                                                            {
                                                                            @foreach (Species spcs in lstSpecies)
                                                                                {
                                                                                    <div class="d-flex align-items-center mb-1">
                                                                                        <button type="button"
                                                                                            class="btn btn-link"
                                                                                            style="margin-left:1px"
                                                                                            @onclick='@(() => BtnUseThisSciNameManually(spcs, datasetData))'
                                                                                            Title="use this name">
                                                                                        <img src="/img/icoGo.png" width="18" />
                                                                                        </button>
                                                                                    <span style="font-size:small;font-weight:bold;margin-left:15px;">@spcs.SciName</span>
                                                                                    </div>
                                                                                }
                                                                                <div class="d-flex align-items-center mb-1">
                                                                                    <button type="button"
                                                                                        class="btn btn-link"
                                                                                        style="margin-left:1px"
                                                                                        @onclick='@(() => BtnCancelEditDatasetData())'
                                                                                        Title="cancel">
                                                                                    <img src="/img/icoCancel.png" width="18" />
                                                                                    </button>
                                                                                <span style="font-size:small;font-weight:bold;margin-left:15px;">Cancel</span>
                                                                                </div>
                                                                            }
                                                                        else
                                                                            {
                                                                                <div class="d-flex align-items-center" style=" color:indianred;font-size:smaller;font-style:italic;margin-left:20px;">
                                                                                No match found!
                                                                                    <button type="button"
                                                                                        class="btn btn-link"
                                                                                        style="margin-left:10px"
                                                                                        @onclick='@(() => BtnCheckNameThisDatasetData(datasetData))'
                                                                                        Title="cancel">
                                                                                    <img src="/img/icoBack3.png" width="24" />
                                                                                    </button>
                                                                                </div>
                                                                            }
                                                                        </MudCardContent>
                                                                    </MudCard>
                                                                </div>
                                                            </td>
                                                            <td>
                                                            </td>
                                                            <td>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </table>
                                        @* Close the List (BOTTOM) *@
                                            <button class="btn btn-link pulse-hover" @onclick="CloseSpeciesList">
                                            <img src="/img/icoGotoTop2.png" width="32" />
                                            </button>
                                        </MudCardContent>
                                    </MudCard>
                                }
                            }
                        }
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        <br />
        <br />
        @* FOOTER *@
            <div class="gap-4" style="display: flex;  justify-content: center; align-items: center;">
            @* <MudIconButton OnClick="BtnBack"
                           Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Title="Switchboard" /> *@
                <button class="btn btn-link pulse-hover" @onclick="ScrollToTop">
                <img src="/img/icoGotoTop2.png" width="32" />
                </button>
            </div>
        </EditForm>
    <br />
    <br />

        <script>
        window.scrollToTop = () => { window.scrollTo({ top: 0, behavior: 'smooth' }); };
        </script>
        <script>
        function showLoading() {
            document.getElementById("loadingOverlay").style.display = "block";
            document.querySelectorAll("button").forEach(btn => btn.disabled = true);
        }
        </script>
        <script>
        document.getElementById("txtSearch").focus();
        </script>
        <script>
        window.addEventListener('load', () => { window.scrollTo({ top: 0, behavior: 'smooth' }); });
        </script>
    }

@code {
    [Parameter]
    public int mode
        {
        get; set;
        }
    [Parameter]
    public int Id
        {
        get; set;
        }
    private User user = new User();
    private List<Note> lstNotes = new List<Note>();
    private List<Dataset> lstDatasets = new List<Dataset>();
    private List<DatasetData> lstDatasetData = new List<DatasetData>();
    private DatasetData datasetData = new DatasetData();

    public Dataset dataset = new Dataset();
    public int _datasetId = 0;
    private string _datasetName = "";
    private string _datasetFilter = "";
    public string _datasetSearchText = "";
    public int _datasetDataId = 0;

    //species
    public MudTextField<string> refFilterSpeciesList;
    public List<Species> lstSpecies = new();
    public Species species = new Species();
    private string _speciesId = "";
    private string _speciesName = "";
    private string _speciesListFilter = "";

    public MudSelect<int> refDatasets;
    public MudTextField<string> refNewDataset;
    public MudTextField<string> refSearchDataset;
    public MudTextField<string> refFilterDatasets;

    IBrowserFile? excelFile;
    MemoryStream stream = new MemoryStream();
    private MudAutocomplete<int> refCourseTopics;
    private MudSelect<string> refWorksheets;
    private MudNumericField<int> refPageNumber;
    private MudTextField<string> txtSearch;
    public List<string> lstWorksheets = new List<string>();
    private string WorksheetName = "";
    public string strSearch = "";
    public int intPageNumber = 1;
    public int _courseTopicId = 0;
    private int intPendingPageNumber = 1; //value typed in the input (prevent changing i (index number) of tests in list)
    public string strExcelFile = "";

    public MudTextField<string> refEditDatasetData;
    private string _datasetDataLineString = "";

    public MudNumericField<int> refCheckNameThisDatasetDataChars;
    public int intCheckNameThisDatasetDataChars = 3;

    public string _genusSearchText = "";
    string Current_Genus = "";
    string Current_Section = "";
    string Current_Species = "";
    string Current_Spec_Author = "";

    //species
    public MudTextField<string> refNewSpecies;
    public MudTextField<string> refSearchSpecies;
    public MudSelect<int> refSpecies;
    public string _speciesSearchText = "";

    public int i = 0;
    public int progressPercent = 0;
    string _cmd1 = "";
    string _cmd2 = "";
    public bool _hasFetched = false;

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        if (Convert.ToInt32(appState.UserLoginStatus) != 1)
            {
            Navman.NavigateTo("/Login");
            }
        appState.SetCmd("");
        user.UserId = Convert.ToInt32(appState.UserId);
        user.Username = appState.Username ?? "username?";
        await BtnShowAllDatasets();
        _hasFetched = true;
        }
    private void TriggerRender ()
