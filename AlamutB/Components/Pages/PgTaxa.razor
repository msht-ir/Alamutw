        }
    private async Task BtnEditApgGroup (int _apgGroupId)
        {

        }
    //Order
    private async Task OnOrderChanged (int newValue)
        {
        var oldValue = _orderId;
        _orderId = newValue;
        if (_orderId != 0)
            {
            lstFamilies = await feService.Read_Families(_orderId);
            }
        StateHasChanged();
        }
    private string GetOrderName (int id)
        {
        if (id == 0 || lstOrders == null)
            return "";
        var order = lstOrders.FirstOrDefault(a => a.OrderId == id);
        return order != null ? order.OrderName : "";
        }
    private async Task BtnAddNewOrder (int apgGroupId)
        {
        //add new order
        }
    private async Task BtnEditOrder (int OrderId)
        {

        }
    private async Task<IEnumerable<int>> SearchOrders (string value, CancellationToken ct)
        {
        if (string.IsNullOrEmpty(value))
            {
            return lstOrders.Select(x => x.OrderId);
            }
        else
            {
            return lstOrders
                .Where(x => x.OrderName.Contains(value, StringComparison.OrdinalIgnoreCase))
                .Select(x => x.OrderId);
            }
        }
    private async Task SearchOrders (string orderKeyword)
        {
        if (string.IsNullOrWhiteSpace(orderKeyword))
            {
            _cmd = "";
            StateHasChanged();
            }
        else
            {
            _orderId = 0;
            _orderSearchText = orderKeyword; //keep the search text
            lstFamilies = new();
            lstGenera = new();
            lstSpecies = new();
            lstOrders = await feService.Read_OrdersBySearch(orderKeyword);
            _cmd = "";
            StateHasChanged();
            }
        }
    //Fam
    private async Task OnFamilyChanged (int newValue)
        {
        var oldValue = _familyId;
        _familyId = newValue;
        if (_familyId != 0)
            {
            lstGenera = await feService.Read_Genera(_familyId);
            }
        StateHasChanged();
        }
    private async Task<IEnumerable<int>> SearchFamilies (string value, CancellationToken ct)
        {
        // If nothing is typed, return all authors or a subset
        if (string.IsNullOrEmpty(value))
            return lstFamilies.Select(x => x.FamilyId);
        // Filter the list
        return lstFamilies
            .Where(x => x.FamilyName.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Select(x => x.FamilyId);
        }
    private string GetFamilyName (int id)
        {
        if (id == 0 || lstFamilies == null)
            return "";
        var family = lstFamilies.FirstOrDefault(a => a.FamilyId == id);
        return family != null ? family.FamilyName : "";
        }
