    private async Task DoCheckNameThisDatasetData (DatasetData datasetData, bool partOfBatchProcess, int partialNameChars)
        {
        string thisLine = datasetData.LineString;
        try
            {
            //thisLine = await CheckLineString(thisLine); //this check is already done when importong from Excel
            if (!string.IsNullOrEmpty(thisLine))
                {
                //parse
                bool result = ParseLineString(thisLine);
                if (result)
                    {
                    if (partialNameChars > 0)
                        {
                        Current_Genus = Current_Genus.Substring(0, partialNameChars);
                        Current_Species = Current_Species.Substring(0, partialNameChars);
                        }
                    lstSpecies = await feService.Read_SpeciesBySearch(Current_Genus.Trim(), Current_Species.Trim());
                    if (partOfBatchProcess)
                        {
                        if (lstSpecies.Any())
                            {
                            var words = lstSpecies [0].SciName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            string _parsedGenus = words [0];
                            string _parsedEpithet = words [1];
                            datasetData.SpeciesId = lstSpecies [0].SpeciesId;
                            datasetData.Infraspecific = lstSpecies [0].InfraEpithet;
                            datasetData.SciName = lstSpecies [0].SciName;
                            datasetData.ParsedGenus = _parsedGenus;
                            datasetData.ParsedEpithet = _parsedEpithet;
                            //save to DB
                            bool resultSave = await feService.Update_DatasetData(datasetData);
                            if (partialNameChars > 0)
                                {
                                Snackbar.Add("line matched and saved", Severity.Success, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                                }
                            }
                        else
                            {
                            //Console.WriteLine($"--- {Current_Genus} {Current_Species} not fount");
                            }
                        }
                    else
                        {
                        _datasetDataId = datasetData.DatasetDataId;
                        _cmd2 = "ShowCheckNameThisDatasetData";
                        }
                    }
                }
            StateHasChanged();
            }
        catch (Exception ex)
            {
            Console.WriteLine(ex.ToString());
            }
        FileSystem.FileClose(1);
        }
    private async Task<string> CheckLineString (string strLine)
        {
        long j = 1L;
        int x = 0;
        j = j + 1L;
        strLine = strLine.Trim();
        if (string.IsNullOrEmpty(strLine))
            goto lblWEND;
        for (int k = 1; k <= 10; k++)
            {
            if (strLine.StartsWith("*"))
                strLine = strLine.Substring(1); //Remove leading '*'
            x = Strings.InStr(strLine, "  ");
            if (x > 0)
                strLine = Strings.Left(strLine, x) + Strings.Mid(strLine, x + 2); // Double spaces removed
            x = Strings.InStr(strLine, "..");
            if (x > 0)
                strLine = Strings.Left(strLine, x) + Strings.Mid(strLine, x + 2); // Double dots removed
            x = Strings.InStr(strLine, ",,");
            if (x > 0)
                strLine = Strings.Left(strLine, x) + Strings.Mid(strLine, x + 2); // Double commas removed
            x = Strings.InStr(strLine, "--");
            if (x > 0)
                strLine = Strings.Left(strLine, x) + Strings.Mid(strLine, x + 2); // Double dashes removed
            x = Strings.InStr(strLine, "( ");
            if (x > 0)
                strLine = Strings.Left(strLine, x) + Strings.Mid(strLine, x + 2); // Space after  '(' removed
            x = Strings.InStr(strLine, " )");
            if (x > 0)
                strLine = Strings.Left(strLine, x - 1) + Strings.Mid(strLine, x + 1); // Space before ')' removed
            x = Strings.InStr(strLine, ")");
            if (x > 0 & Strings.Mid(strLine, x + 1, 1) != " ")
                {
                if (x != Strings.Len(strLine))
                    strLine = Strings.Left(strLine, x) + " " + Strings.Mid(strLine, x + 1); // Space after ')' added
                }
            x = Strings.InStr(strLine, "(");
            if (x > 1)
                {
                if (Strings.Mid(strLine, x - 1, 1) != " ")
                    {
                    strLine = Strings.Left(strLine, x - 1) + " " + Strings.Mid(strLine, x); // Space before ')' added
                    }
                }
            x = Strings.InStr(strLine, "- ");
            if (x > 0)
                strLine = Strings.Left(strLine, x) + Strings.Mid(strLine, x + 2); // Space after - removed
            x = Strings.InStr(strLine, " -");
            if (x > 0)
                strLine = Strings.Left(strLine, x - 1) + Strings.Mid(strLine, x + 1); // Space before - removed
            x = Strings.InStr(strLine, " .");
            if (x > 0)
                strLine = Strings.Left(strLine, x - 1) + Strings.Mid(strLine, x + 1); // Space before '.' removed
            x = Strings.InStr(strLine, " ssp. ");
            if (x > 0)
                strLine = Strings.Left(strLine, x - 1) + " subsp. " + Strings.Mid(strLine, x + 6); // ssp.-> subsp. converted
            x = Strings.InStr(strLine, " ssp ");
            if (x > 0)
                strLine = Strings.Left(strLine, x - 1) + " subsp. " + Strings.Mid(strLine, x + 5); // ssp-> subsp. converted
            x = Strings.InStr(strLine, " subsp ");
            if (x > 0)
                strLine = Strings.Left(strLine, x - 1) + " subsp. " + Strings.Mid(strLine, x + 7); // subsp-> subsp. converted
            x = Strings.InStr(strLine, " var ");
            if (x > 0)
                strLine = Strings.Left(strLine, x - 1) + " var. " + Strings.Mid(strLine, x + 5); // var-> var. converted
            x = Strings.InStr(strLine, " sv. ");
            if (x > 0)
                strLine = Strings.Left(strLine, x - 1) + " subvar. " + Strings.Mid(strLine, x + 5); // var-> var. converted
            x = Strings.InStr(strLine, " sv ");
            if (x > 0)
                strLine = Strings.Left(strLine, x - 1) + " subvar. " + Strings.Mid(strLine, x + 4); // var-> var. converted
            x = Strings.InStr(strLine, "–");
            if (x > 0)
                strLine = Strings.Left(strLine, x - 1) + "-" + Strings.Mid(strLine, x + 1); // Psudo dash1-> dash converted
            x = Strings.InStr(strLine, "–");
            if (x > 0)
                strLine = Strings.Left(strLine, x - 1) + "-" + Strings.Mid(strLine, x + 1); // Psudo dash2-> dash converted
            x = Strings.InStr(strLine, " /");
            if (x > 0)
                strLine = Strings.Left(strLine, x - 1); // comments after ' /' removed
            x = Strings.InStr(strLine, "/");
            if (x > 0)
                strLine = Strings.Left(strLine, x - 1); // comments after '/' removed
            x = Strings.InStr(strLine.ToLower(), "aceae");
            if (x > 0 & Strings.InStr(strLine, " ") == 0)
                goto lblWEND;
            if (x > 0 & Strings.InStr(strLine, " ") != 0)
                goto lblWEND;
            if (strLine.ToLower() == "palmae")
                goto lblWEND;
            if (strLine.ToLower() == "cruciferae")
                goto lblWEND;
            if (strLine.ToLower() == "leguminosae")
                goto lblWEND;
            if (strLine.ToLower() == "gramineae")
                goto lblWEND;
            if (strLine.ToLower() == "umbelliferae")
                goto lblWEND;
            if (strLine.ToLower() == "labiatae")
                goto lblWEND;
            if (strLine.ToLower() == "compositae")
                goto lblWEND;
            if (strLine.ToLower() == "archive of sid")
                goto lblWEND;
            if (strLine.ToLower() == "archive")
                goto lblWEND;
            }
        return strLine;
    lblWEND:
        return "";
        }
    private bool ParseLineString (string strLine)
        {
        var Infraspecific = "";
        bool ParseLineRet = default;
        // Returens: {0(False):Error, -1:(True)ParsedOK}
        int PointA;
        int LineParts = 0;       // for bit operations
        string strS_A, strS_B, strS_C, strS_D, strS_E;
        int spcx;                // position of the 1st space in Part_B
        int spcA1, spcA2, spcA3; // position of spaces in Part_A
        /*
          |Part A                   |Part B             |Part C         |Part D                  |Part E              |
          Gen|G.#(Sect)#spec#SpecAut#supspec.#ssp#sspAut#var.#var#varAut#subvar.#subvar#subvarAut#forma#forma#formaAut
          |     ^      ^    ^       |        -   ^      |    -   ^      |       -      ^         |     -     ^        |
        */
        try
            {
            if (Strings.Len(Strings.Trim(strLine)) == 0)
                {
                ParseLineRet = false;
                return ParseLineRet;
                }
            LineParts = 0;
            //Part_E: forma
            PointA = Strings.InStr(strLine, "forma ");
            if (PointA != 0)
                {
                LineParts = (int) ((long) LineParts | (long) Math.Round(Math.Pow(2d, 4d))); // [----x]
                strS_E = Strings.Mid(strLine, PointA);
                strLine = Strings.Trim(Strings.Left(strLine, PointA - 1));
                spcx = Strings.InStr(7, strS_E, " ");
                switch (spcx)
                    {
                    case 0:
                            {
                            Infraspecific = "forma " + Strings.Mid(strS_E, 7);
                            break;
                            }

                    default:
                            {
                            Infraspecific = "forma " + Strings.Mid(strS_E, 7, spcx - 7) + " " + Strings.Mid(strS_E, spcx + 1);
                            break;
                            }
                    }
                }
            else
                {
                LineParts = LineParts & 15; // [xxxx-]
                strS_E = "";
                }
            //Part_D: subvar
            PointA = Strings.InStr(strLine, "subvar. ");
            if (PointA != 0)
                {
                LineParts = (int) ((long) LineParts | (long) Math.Round(Math.Pow(2d, 3d)));
                strS_D = Strings.Mid(strLine, PointA);
                strLine = Strings.Trim(Strings.Left(strLine, PointA - 1));
                spcx = Strings.InStr(9, strS_D, " ");
                switch (spcx)
                    {
                    case 0:
                            {
                            Infraspecific = "subvar " + Infraspecific + Strings.Mid(strS_D, 9);
                            break;
                            }

                    default:
                            {
                            Infraspecific = "subvar " + Strings.Mid(strS_D, 9, spcx - 9) + ' ' + Strings.Mid(strS_D, spcx + 1);
                            break;
                            }
                    }
                }
            else
                {
                strS_D = "";
                }
            //Part_C: Var
            PointA = Strings.InStr(strLine, "var. ");
            if (PointA != 0)
                {
                LineParts = (int) ((long) LineParts | (long) Math.Round(Math.Pow(2d, 2d)));
                strS_C = Strings.Mid(strLine, PointA);
                strLine = Strings.Trim(Strings.Left(strLine, PointA - 1));
                spcx = Strings.InStr(6, strS_C, " ");
                switch (spcx)
                    {
                    case 0:
                            {
                            Infraspecific = "var " + Strings.Mid(strS_C, 6);
                            break;
                            }

                    default:
                            {
                            Infraspecific = "var " + Strings.Mid(strS_C, 6, spcx - 6) + " " + Strings.Mid(strS_C, spcx + 1);
                            break;
                            }
                    }
                }
            else
                {
                strS_C = "";
                }
            //Part_B: subsp
            PointA = Strings.InStr(strLine, "subsp. ");
            if (PointA != 0)
                {
                LineParts = (int) ((long) LineParts | (long) Math.Round(Math.Pow(2d, 1d)));
                strS_B = Strings.Mid(strLine, PointA);
                strLine = Strings.Trim(Strings.Left(strLine, PointA - 1));
                // determine subsp
                spcx = Strings.InStr(8, strS_B, " ");
                if (spcx != 0) // con subsp_Aut
                    {
                    Infraspecific = "ssp " + Strings.Mid(strS_B, 8, spcx - 8) + " " + Strings.Mid(strS_B, spcx + 1);
                    }
                else // sin ssp_Aut
                    {
                    Infraspecific = "ssp " + Strings.Mid(strS_B, 8);
                    }
                }
            else
                {
                strS_B = "";
                }
            //Part_A
            if (Strings.Len(strLine) > 0) // ***con Part_A
                {
                LineParts = (int) ((long) LineParts | (long) Math.Round(Math.Pow(2d, 0d)));
                strS_A = strLine;
                spcA1 = Strings.InStr(strS_A, " ");

                if (Strings.Mid(strS_A, spcA1, 2) == " (") // con (Sect)
                    {
                    spcA2 = Strings.InStr(spcA1 + 1, strS_A, ") ") + 1;
                    spcA3 = Strings.InStr(spcA2 + 1, strS_A, " ");
                    //determine genus
                    if (Strings.Mid(strS_A, 2, 2) == ". " | Strings.Mid(strS_A, 3, 2) == ". ") // Genus is Abbr
                        {
                        }
                    //Current_Genus: Same as previous record
                    else // not Abbr
                        {
                        Current_Genus = Strings.Left(strS_A, spcA1 - 1);
                        }
                    //determine section
                    Current_Section = Strings.Mid(strS_A, spcA1 + 2, spcA2 - spcA1 - 3); // is -3 ok?
                    // determine species
                    if (spcA3 == 0) // sin spec_Aut
                        {
                        Current_Species = Strings.Mid(strS_A, spcA2 + 1);
                        Current_Spec_Author = "";
                        }
                    else //con spec_Aut
                        {
                        Current_Species = Strings.Mid(strS_A, spcA2 + 1, spcA3 - spcA2 - 1);
                        Current_Spec_Author = Strings.Mid(strS_A, spcA3 + 1);
                        }
                    }
                else //sin (Sect)
                    {
                    spcA2 = Strings.InStr(spcA1 + 1, strS_A, " ");
                    // determine genus
                    if (Strings.Mid(strS_A, 2, 2) == ". " | Strings.Mid(strS_A, 3, 2) == ". ") // Genus is Abbr
                        {
                        }
                    //Current_Genus: Same as previous record
                    else // not Abbr.
                        {
                        Current_Genus = Strings.Left(strS_A, spcA1 - 1);
                        }
                    //determine species
                    if (spcA2 == 0) // sin spec_Aut
                        {
                        Current_Species = Strings.Mid(strS_A, spcA1 + 1);
                        Current_Spec_Author = "";
                        }
                    else // con spec_Aut
                        {
                        Current_Species = Strings.Mid(strS_A, spcA1 + 1, spcA2 - spcA1 - 1);
                        Current_Spec_Author = Strings.Mid(strS_A, spcA2 + 1);
                        }
                    }
                }
            else // ***sin Part_A
                {
                strS_A = "";
                }
            ParseLineRet = true; // OK
            }
        catch (Exception ex)
            {
            //MsgBox(ex.ToString)
            ParseLineRet = false; // Error
            }

        return ParseLineRet;
        }
    private async Task BtnUseThisSciNameManually (Species _species, DatasetData _datasetData)
        {
        var words = _species.SciName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        string _parsedGenus = words [0];
        string _parsedEpithet = words [1];
        _datasetData.SpeciesId = _species.SpeciesId;
        _datasetData.Infraspecific = _species.InfraEpithet;
        _datasetData.SciName = _species.SciName;
        _datasetData.ParsedGenus = _parsedGenus;
        _datasetData.ParsedEpithet = _parsedEpithet;
        //save to DB
        bool resultSave = await feService.Update_DatasetData(_datasetData);
        if (resultSave)
            {
            Snackbar.Add("updated", Severity.Success, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
            }
        _cmd2 = "";
        StateHasChanged();
        }

