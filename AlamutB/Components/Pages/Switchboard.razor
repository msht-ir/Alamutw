@page "/Switchboard"
@inject ProtectedSessionStorage sessionStorage
@inject NavigationManager Navman
@inject AppState appState
@implements IDisposable
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@if (appState.Cmd == "CreateNote")
    {
    <Modal_CreateNote OnClose="HandleModalClose" />
    }


    <div class="container" style="max-width:600px; margin: 0 auto;">
        <div style="text-align: center;">
            <div style="text-align: center;margin-top:50px;margin-bottom:20px;">
            <p style="font-size:large;font-style:italic;color:royalblue">@appState.UserNickname</p>
            </div>
        <hr style="color:red;margin-bottom:50px;" />
            <div class="d-flex gap-5 justify-content-center">
                <button class="btn btn-link pulse-animation" @onclick='() => GotoPage("TX")'>
                <img src="/img/icoTaxonomy.png" width="38" title="Taxonomy" />
                </button>
                <button class="btn btn-link pulse-hover" @onclick='() => GotoPage("CN")'>
                <img src="/img/icoCheckName0.png" width="44" title="CheckName" />
                </button>
                <button class="btn btn-link pulse-hover" @onclick='() => GotoPage("DS")'>
                <img src="/img/icoDatasets1.png" width="40" title="Datasets" />
                </button>
                <button class="btn btn-link pulse-hover" @onclick='() => GotoPage("SET")'>
                <img src="/img/icoSets1.png" width="44" title="Sets" />
                </button>
                <button class="btn btn-link pulse-hover" @onclick='() => GotoPage("ANL")'>
                <img src="/img/icoChartPie1.png" width="40" title="Analysis" />
                </button>
            </div>
        <br />
        <br />
            <div class="d-flex gap-5 justify-content-center">

                <button class="btn btn-link pulse-hover" @onclick='() => GotoPage("NBK")'>
                <img src="/img/icoNoteBook1.png" width="44" title="Notebooks" />
                </button>
                <button class="btn btn-link pulse-hover" @onclick='() => GotoPage("STN")'>
                <img src="/img/icoNoteSticky1.png" width="44" title="Sticky Notes" />
                </button>
                <button class="btn btn-link pulse-hover" @onclick='() => GotoPage("RGN")'>
                <img src="/img/icoReport0.png" width="36" title="Reports" />
                </button>
                <button class="btn btn-link pulse-hover" @onclick='() => GotoPage("APL")'>
                <img src="/img/icoPrompt1.png" width="38" title="APL" />
                </button>
            @if (Convert.ToInt32(appState.UserTags & 128) == 128)
                {
                    <button class="btn btn-link pulse-hover" @onclick='() => GotoPage("ADM")'>
                    <img src="/img/icoAdmin.png" width="46" title="Settings" />
                    </button>
                }
            else
                {
                    <button class="btn btn-link pulse-hover" @onclick='() => GotoPage("STT")'>
                    <img src="/img/icoSettings1.png" width="46" title="Settings" />
                    </button>
                }
            </div>
        <br />
        <br />
            <div class="d-flex gap-5 justify-content-center">
                <button class="btn btn-link pulse-hover" @onclick='() => GotoPage("SRC")'>
                <img src="/img/icoSearch.png" width="38" title="Search" />
                </button>
                <button class="btn btn-link pulse-hover" @onclick='() => GotoPage("LIB")'>
                <img src="/img/icoBooks1.png" width="42" title="Library" />
                </button>
                <button class="btn btn-link pulse-hover" @onclick='() => GotoPage("MAP")'>
                <img src="/img/icoMap.png" width="38" title="Maps" />
                </button>
                <button class="btn btn-link pulse-hover" @onclick='() => GotoPage("CLM")'>
                <img src="/img/icoMeteo1.png" width="46" title="Climatology" />
                </button>
                <button class="btn btn-link pulse-hover" @onclick='() => GotoPage("INF")'>
                <img src="/img/icoInfo.png" width="38" title="Help" />
                </button>
            </div>
        <br />
        <br />
        <hr style="color:red;margin-top:30px;" />
            <div style="text-align: center;margin-top:50px;">
                <MudButton Variant="Variant.Filled"
                       EndIcon="@Icons.Material.Filled.ArrowBack"
                       Size="Size.Small"
                       OnClick="@(() => GotoLogin())"
                       Style="color:indianred;padding-left:60px;padding-right:60px">
                Logout
                </MudButton>
                @* <br />
                <button class ="btn btn-success" @onclick="RemoveExtraLines">
                Fileprocess
                </button> *@

            </div>
        </div>
    </div>


@code
{
    private bool _firstRender = true;
    User user = new User();
    public int Spacing { get; set; } = 3;
    string _cmd = "";

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        if (Convert.ToInt32(appState.UserLoginStatus) != 1)
            {
            Navman.NavigateTo("/Login");
            }
        }
    protected async Task OnAfterRenderAsync ()
        {
        var result1 = await sessionStorage.GetAsync<string>("UserName");
        if (result1.Success)
            {
            appState.SetUsername(result1.Value);
            user.Username = appState.Username;
            StateHasChanged();
            }
        if (_firstRender)
            {
            _firstRender = false;
            var result = await sessionStorage.GetAsync<int>("UserLoginStatus");
            if (result.Success && result.Value == 1)
                {
                appState.SetUserLoginStatus(1);
                appState.SetUserLoginStatus(result.Value);
                }
            else
                {
                Navman.NavigateTo("/Login");
                }
            }
        }
    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }
    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }
    //methods
    public void GotoLogin ()
        {
        Navman.NavigateTo("/Login");
        }
    public void GotoPage (string _pageId)
        {
        string page = _pageId switch
            {
                "TX"=> "/PgListMaker",
                "CN"=> "/PgCheckName",
                "DS"=> "/PgDatasets",
                "SET"=> "/PgSets",
                "ANL"=> "/PgAnalysis",
                "STT"=> "/PgSettings",
                "ADM"=> "/PgAdmin",
                "NBK"=> "/PgNotebooks",
                "STN"=> "/PgStickyNotes",
                "RGN"=> "/PgReportGenerator",
                "APL" => "/PgAPL",
                "PRN" => "/PgPrints",
                "SRC" => "/PgSearch",
                "LIB" => "/PgLibrary",
                "MAP" => "/PgMaps",
                "CLM" => "/PgClimagraph",
                "INF" => "/PgInfo"
                };
        Navman.NavigateTo(page);
        }
    public void GotoNotebooks ()
        {
        appState.SetReturnPage("/Switchboard");
        Navman.NavigateTo("/E_NoteBooks");
        }
    public void BtnGotoAdminPage ()
        {
        appState.SetReturnPage("/Switchboard");
        Navman.NavigateTo("/T_Admin");
        }
    public async Task BtnCreateNote ()
        {
        appState.SetNoteRefId(Convert.ToInt32(appState.UserId)); //for quickNote(t): NoteReferenceId = UserId
        appState.SetNoteRefType(11);
        appState.SetCmd("CreateNote");
        StateHasChanged();
        //After the Modal_CreateNote is closed, HandleModalClose will refresh the list
        //to handel close event, I added in the Modal_CreateNote: [Parameter] public EventCallback OnClose
        }
    public void ReportUserNotes ()
        {
        user.UserId = Convert.ToInt32(appState.UserId);
        appState.SetReturnPage("/Switchboard");
        Navman.NavigateTo($"/T_ReportNotes/11/{user.UserId}");
        }
    private void BtnChangeTeacherPassword ()
        {
        if ((Convert.ToInt32(appState.UserTags) & 2) == 2)
            {
            appState.SetUserLoginStatus(1);
            Navman.NavigateTo("/ChangePassword");
            }
        else
            {
            Snackbar.Add("account limitted", Severity.Warning, opt => { opt.VisibleStateDuration = 1500; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
            }
        }
    private async Task HandleModalClose ()
        {
        StateHasChanged();
        }

    private void TempMethod_RemoveExtraLines ()
        {
        string inputPath = @"d:\CheckNameIn.txt";
        string outputPath = @"d:\CheckNameOut.txt";
        var lines = File.ReadAllLines(inputPath);
        var filteredLines = lines.Where(line => !line.StartsWith("Distr"));
        File.WriteAllLines(outputPath, filteredLines);
        }

    }
