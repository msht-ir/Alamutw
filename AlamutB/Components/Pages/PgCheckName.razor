    private async Task ReadExcelAsync ()
        {
        if (WorksheetName == "")
            {
            Snackbar.Add("select a worksheet", Severity.Warning, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
            return;
            }
        else
            {
            _hasFetched = false;
            var message = new MarkupString($"<hr><br><br>Names in the <span style='color:indianred'>selected</span><span style='color:royalblue'> Excel Worksheet</span> will be imported <br> and added to the current dataset<br><br><span style='font-weight:bold'>Duplicate names</span><br>will be  imported! <span style='color:indianred'><br><br>Continue</span>?<br><br><div style='text-align:center'><img src='/img/icoFileExcel.png' width='70'/></div><br><hr>");
            bool? confirmResult = await DialogService.ShowMessageBoxAsync(title: "Confirm", markupMessage: message, yesText: "Yes", cancelText: "No");
            if (confirmResult == true)
                {
                int datasetId = Convert.ToInt32(appState.DatasetId);
                stream.Position = 0;
                try
                    {
                    List<DatasetData> lstDatasetData = await feService.Read_DatasetData(datasetId);
                    using var wb = new XLWorkbook(stream);
                    var worksheet = wb.Worksheet($"{WorksheetName}");
                    foreach (var row in worksheet.RowsUsed().Skip(1)) //skip header (CheckName)
                        {
                        DatasetData datasetData = new DatasetData();
                        datasetData.DatasetId = _datasetId;
                        datasetData.DatasetDataId = datasetData.DatasetDataId;
                        datasetData.LineString = row.Cell(1).GetString();
                        //check lineString
                        string _lineString = await CheckLineString(datasetData.LineString);
                        //create
                        if (_lineString != "")
                            {
                            datasetData.LineString = _lineString;
                            bool result = await feService.Create_DatasetData(datasetData);
                            }
                        }
                    Snackbar.Add("data imported from excel file", Severity.Success, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    _cmd1 = "";
                    }
                catch (Exception ex)
                    {
                    Console.WriteLine($"Error in [ImportExcel]: {ex}");
                    }
                lstWorksheets.Clear();
                lstDatasetData.Clear();
                lstDatasetData = await feService.Read_DatasetData(datasetId);
                Snackbar.Add("data imported", Severity.Success, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                appState.SetCmd("");
                }
            }
        _hasFetched = true;
        }

