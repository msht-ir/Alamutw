    private async Task HandleFileSelected (InputFileChangeEventArgs e)
        {
        /*
        method 1: Save excel file to server folder
        mothod 2: Parse directly in memory
        method 3: EPPlus package (fast!)
        */
        try
            {
            _hasFetched = false;
            excelFile = e.File;
            ExcelPackage.License.SetNonCommercialPersonal("Majid SharifiTehrani"); //for non commertial use of package EPPlus
            // Copy stream (same as before)
            await excelFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(stream);
            stream.Position = 0;

            // Use EPPlus to read worksheet names
            using var package = new ExcelPackage(stream);
            lstWorksheets = package.Workbook.Worksheets
                .Select(ws => ws.Name)
                .ToList();

            StateHasChanged();
            Snackbar.Add("Excel worksheets listed", Severity.Success);
            _cmd = "ShowWorksheetNames";
            _hasFetched = true;
            }
        catch (Exception ex)
            {
            Console.WriteLine($"--------Error\n{ex}");
            appState.SetCmd("");
            _hasFetched = true;
            return;
            }
