@page "/PgNotebooks"
@using ClosedXML.Excel
@using Microsoft.Extensions.Hosting
@using ClosedXML
@using AlamutB.Service
@inject NavigationManager Navman
@inject AppState appState
@inject FeService feService
@inject IJSRuntime JS
@implements IDisposable
@using System.Globalization
@using System.Reflection
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (!_hasFetched)
    {
    <_LoadingTimer />
    }
else if (appState.Cmd == "cmdCreateNote")
    {
    <Modal_CreateNote OnClose="HandleModalClose" />
    }
else if (appState.Cmd == "cmdShowNoteInDialog")
    {
    <Modal_ShowNote OnClose="HandleModalClose" />
    }
else if (appState.Cmd == "cmdUpdateNote")
    {
    <Modal_CreateNote OnClose="HandleModalClose" />
    }
else
    {
    <div style="font-size:larger; text-align:center;color:black">@appState.UserNickname</div>
        <div style="text-align:left; max-width:500px; margin: 0 auto;">
            <button class="btn btn-link pulse-hover" @onclick="() => BtnBackToCallingPage()">
            <img src="/img/icoList.png" style="width:28px" title="back" />
            </button>
            <button class="btn btn-link pulse-hover" @onclick="() => BtnGotoStickyNotes()">
            <img src="/img/icoNoteSticky2.png" style="width:28px" title="goto: quick notes" />
            </button>
            <button class="btn btn-link pulse-hover" @onclick="CreateStickyNote">
            <img src="/img/icoNoteStickyAdd.png" width="28" title="add new quick-note" />
            </button>
        </div>
        <EditForm Model="lstNotebooks">
        @* SEARCH BOX *@
            <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0" style="max-width:500px; margin: 0 auto;">
                <MudCard Class="mx-0">
                    <MudCardContent Style="background-color:whitesmoke;">
                        <div class="mb-3" style="max-width:500px; margin:0 auto">
                            <div class="d-flex align-items-center mb-3">
                            <MudTextField T="string"
                                          @ref="refSearchNote"
                                          @bind-Value="strSearchKey"
                                          OnKeyDown="HandleKey_Searchbox"
                                          Label="Search"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          OnAdornmentClick="BtnReadNotesBySearch"
                                          style="font-family:tahoma"
                                          Class="my-textfield" />
                            @if (lstSearchedtNotes.Count > 0)
                                {
                                    <button class="btn btn-link pulse-hover" @onclick="BtnCancelSearch">
                                    <img src="/img/icoCancel.png" width="20" title="cancel search" style="margin-left:20px;margin-top:15px;" />
                                    </button>
                                }
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        @if (lstSearchedtNotes.Count > 0)
            {
            @* 1 SEARCH-RESULTS *@
            <h5 style="text-align:center; margin-top:10px;">top 20 results</h5>
            foreach (Note note in lstSearchedtNotes)
                {
                    <div class="d-flex" style=" color:indianred; font-weight:bold;font-size:small">
                        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0" style="max-width:500px; margin: 0 auto;">
                            <MudCard Class="mx-0">
                                <MudCardContent Style="background-color:whitesmoke;">
                                <span style="color:indianred; font-weight:bold;">@PersianDate(note.NoteDateTime)</span>
                                <p style="color:gray;font-weight:normal;font-style:italic">@note.RefName</p>
                                <hr />
                                @if (note.NoteText.Length > 100)
                                    {
                                        <div style="white-space: pre-wrap; font-family:Courier New, Courier, monospace;font-size:small;color:black;">
                                        @note.NoteText.Substring(0, 100) <span style="font-size:xx-small;font-weight:bold;color:indianred">[...]</span>
                                        </div>
                                    }
                                else
                                    {
                                        <div style="white-space: pre-wrap; font-family:Courier New, Courier, monospace;font-size:small;color:black;">
                                        @note.NoteText
                                        </div>
                                    }
                                <hr />
                                    <div class="d-flex align-items-center" style="color:indianred; font-weight:bold;font-size:small">
                                        <MudMenu Label="actions"
                                             Variant="Variant.Outlined"
                                             Color="Color.Tertiary"
                                             StartIcon="@Icons.Material.Filled.Menu"
                                             EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                             Size="Size.Small"
                                             Dense="true">
                                            <MudMenuItem @onclick="() => BtnEditNoteInDialog(note)">
                                                <button class="btn btn-link pulse-animation">
                                                <img src="/img/icoRename.png" width="28" />
                                                </button>
                                            edit note
                                            </MudMenuItem>
                                            <MudMenuItem @onclick="() => BtnDeleteNote(note)">
                                                <button class="btn btn-link pulse-hover">
                                                <img src="/img/icoDelete1.png" width="20" title="delete note" />
                                                </button>
                                            delete note
                                            </MudMenuItem>
                                        </MudMenu>
                                    @if (note.NoteText.Length > 100)
                                        {
                                            <button class="btn btn-link pulse-animation" @onclick="() => BtnShowNoteInDialog(note)">
                                            <img src="/img/icoNoteReport.png" width="24" title="show note expanded" />
                                            </button>
                                        }
                                    </div>
                                </MudCardContent>
                            </MudCard>
                        </MudContainer>
                    </div>
                }
            }
        else
            {
            @* due Notes *@
            var collapseId_due = $"collapse";
            _clpsP = "collapse";
                <div class="accordion-item mt-2 mb-1" style="max-width:500px; margin: 0 auto;">
                    <h4 class="accordion-header" style="background-color:rgba(252,252,252)">
                        <button class="accordion-button collapsed"
                            style="background-color:rgba(245,245,245)"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId_due"
                            aria-expanded="true"
                            aria-controls="@collapseId_due">
                            <button class="btn btn-link pulse-animation" @onclick="() => BtnReadNotesDue()">
                            <img src="img/icoClockRed.png" width="30" style="margin-right:10px;" />
                            </button>
                        <h5 style="color:mediumslateblue">Todo Notes <span style="font-size:x-small;color:indianred">@((user.UserTags & 32) == 32 ? "(\u00B1 7 days)" : "(\u00B1 3 days)")</span> </h5>
                        </button>
                    </h4>
                    <div id="@collapseId_due" class="accordion-collapse collapse" data-bs-parent="#accordionNotebooks">
                        <div class="accordion-body" style="background-color:rgba(254,254,254);">
                            <div id="T1">
                            @foreach (Note dueNotex in lstDueNotes)
                                {
                                var _noteDirection = ((dueNotex.NoteTags & 1) == 1) ? "text-end" : "text-start";
                                    <div class="mt-3 @_noteDirection">
                                        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                                            <MudCard Class="mx-0">
                                                <MudCardContent Style="background-color:whitesmoke;">
                                                    <div class="d-flex align-items-center" style="text-align:center; color:indianred; font-weight:bold;font-size:small">
                                                    @if (dueNotex.IsTodo)
                                                        {
                                                        <img class="pulse-hover" src="/img/icoClock2.png" width="20" style="margin-right:7px" />
                                                        @PersianDate(dueNotex.NoteDateTimeDue)
                                                        }
                                                    else
                                                        {
                                                        @PersianDate(dueNotex.NoteDateTime)
                                                        }
                                                    </div>
                                                <hr />
                                                    <div style="white-space: pre-wrap; font-weight:normal; font-family:'Segoe UI';font-size:small">
                                                    @if (dueNotex.NoteText.Length > 100)
                                                        {
                                                        <div> @dueNotex.NoteText.Substring(0, 100) <span style="font-size:xx-small;font-weight:bold;color:indianred">[...]</span></div>
                                                        }
                                                    else
                                                        {
                                                        <div style="font-weight:normal;font-family:'Segoe UI'"> @dueNotex.NoteText</div>
                                                        }
                                                    </div>
                                                <hr>
                                                @* dueNotes Buttons *@
                                                    <div class="d-flex align-items-center text-start" style="text-align:center; color:indianred; font-weight:bold;font-size:small">
                                                        <button class="btn btn-link pulse-hover" @onclick="() => BtnRemoveDueNoteTag(dueNotex)">
                                                        <img src="/img/icoOn.png" width="26" title="edit note" />
                                                        </button>
                                                        <button class="btn btn-link pulse-hover" @onclick="() => BtnEditNoteInDialog(dueNotex)">
                                                        <img src="/img/icoRename.png" width="28" title="edit note" />
                                                        </button>
                                                    @if (dueNotex.NoteText.Length > 100)
                                                        {
                                                            <button class="btn btn-link pulse-animation" @onclick="() => BtnShowNoteInDialog(dueNotex)">
                                                            <img src="/img/icoNoteReport.png" width="22" title="show note expanded" />
                                                            </button>
                                                        }
                                                        <button class="btn btn-link pulse-hover" @onclick="() => BtnDeleteNote(dueNotex)">
                                                        <img src="/img/icoDelete1.png" width="22" title="edit note" />
                                                        </button>
                                                    </div>
                                                </MudCardContent>
                                            </MudCard>
                                        </MudContainer>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            @* 2 NOTEBOOKS and SECTIONS *@
                <div class="d-flex justify-content-center align-items-center mb-1" style="text-align:center">
                    <button class="btn btn-link pulse-hover" @onclick="BtnToggleShowNotebooksMode">
                    <img src="/img/icoPaper.png" width="26" title="toggle: active / non-active / all-notes" />
                    </button>
                    <span style="text-align:center;color:indianred; margin:10px;">
                    @(_ShowNotebooksMode switch
                        {
                            "all" => "all notebooks",
                            "active" => "active notebooks",
                            "inactive" => "inactive notebooks",
                            _ => ""
                            })
                    </span>
                </div>
                <div class="accordion" id="accordionNotebooks" style="max-width:500px; margin: 0 auto;">
                @* 2.1 NOTEBOOKS *@
                @foreach (Notebook notebook in lstNotebooks)
                    {
                    var collapseId = $"collapse{notebook.NotebookId}";
                    _clpsP = ((appState.NotebookId) != notebook.NotebookId) ? "collapse" : "collapse show";
                        <div class="accordion-item mb-1">
                            <h4 class="accordion-header" style="background-color:rgba(252,252,252)">
                                <button class="accordion-button collapsed"
                                    style="background-color:rgba(245,245,245)"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId"
                                    aria-expanded="true"
                                    aria-controls="@collapseId">
                                    <button class="btn btn-link pulse-hover" @onclick="() => BtnReadNotebookNotes(notebook)">
                                    <img class="pulse-hover" src="img/icoNoteBook.png" width="38" style="margin-right:10px;" />
                                    </button>
                                <h3 style="color:indigo">@notebook.NotebookName</h3>
                                </button>
                            </h4>
                            <div id="@collapseId" class="accordion-collapse @_clpsP" data-bs-parent="#accordionNotebooks">
                                <div class="accordion-body" style="background-color:rgba(250,250,250)">
                                    <div id="T1">
                                    @if ((appState.Cmd == "cmdEditNotebook") && (appState.NotebookId == notebook.NotebookId))
                                        {
                                        string btnNotebookId = "btnNotebookName";
                                            <div class="d-flex mb-3">
                                            <MudTextField @ref="refNotebookName"
                                                          @bind-Value="notebook.NotebookName"
                                                          Label="notebook"
                                                          Variant="Variant.Text"
                                                          Margin="Margin.Dense"
                                                          Autocomplete="off"
                                                          Adornment="Adornment.End"
                                                          AdornmentIcon="@Icons.Material.Filled.Save"
                                                          OnAdornmentClick="() => BtnUpdateNotebook(notebook)"
                                                          Style="font-family:tahoma;"
                                                          Class="my-textfield" />
                                            </div>
                                            <div class="d-flex mb-2">
                                            <MudCheckBox @bind-Value="notebook.IsActive" Label="active" Color="Color.Primary"></MudCheckBox>
                                                <button class="btn btn-link pulse-hover" style="margin-left:15px;" @onclick="() => BtnDeleteNotebook(notebook.NotebookId)" @key="notebook.NotebookId">
                                                <img src="/img/icoDelete1.png" width="25" title="delete notebook" />
                                                </button>
                                                <button class="btn btn-link pulse-hover" style="margin-left:15px;" name="btnNewCourse" @onclick="BtnCancel">
                                                <img src="/img/icoCancel.png" width="24" title="cancel" />
                                                </button>
                                            </div>
                                        }
                                    else
                                        {
                                            <div style="text-align: center;">
                                                <button class="btn btn-link pulse-hover" @onclick="() => BtnAddNewSection(notebook.NotebookId)">
                                                <img src="/img/icoAddSection1.png" width="28" title="add new section" />
                                                </button>
                                                <button class="btn btn-link pulse-hover" type="button" @onclick="() => BtnEditNotebook(notebook.NotebookId)">
                                                <img src="/img/icoRename.png" width="34" title="edit notebook" />
                                                </button>
                                            <hr style="color:red" />
                                            </div>
                                        @if ((appState.Cmd == "AddNewSection") && (appState.NotebookId == notebook.NotebookId))
                                            {
                                                <div>
                                                    <div class="d-flex mb-3">
                                                    <MudTextField @ref="refNewSection"
                                                                  @bind-Value="txtNewSectionTitle"
                                                                  Label="new section"
                                                                  Variant="Variant.Text"
                                                                  Margin="Margin.Dense"
                                                                  Autocomplete="off"
                                                                  Adornment="Adornment.End"
                                                                  AdornmentIcon="@Icons.Material.Filled.Save"
                                                                  OnAdornmentClick="() => BtnSaveNewSection(notebook.NotebookId)"
                                                                  Style="font-family:tahoma;"
                                                                  Class="my-textfield" />
                                                        <button class="btn btn-link pulse-hover" name="btnNewCourse" style="margin-left:20px;" @onclick="BtnCancel">
                                                        <img src="/img/icoCancel.png" width="20" title="cancel" style="margin-top:15px;" />
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        else
                                            {
                                            @* 2.2 SECTIONS *@
                                                <div class="accordion" id="accordionSections-@notebook.NotebookId">
                                                @foreach (Section section in notebook.Sections)
                                                    {
                                                    var collapseId2 = $"collapse{section.SectionId}";
                                                    _clpsSP = (appState.NoteRefId != section.SectionId) ? "collapse" : "collapse show";
                                                        <div class="accordion-item mb-1">
                                                            <h4 class="accordion-header">
                                                                <button class="accordion-button collapsed"
                                                                    type="button"
                                                                    data-bs-toggle="collapse"
                                                                    data-bs-target="#@collapseId2"
                                                                    aria-expanded="true"
                                                                    aria-controls="@collapseId2" @onclick="() => BtnReadSectionNotes(section)">
                                                                    <button class="btn btn-link pulse-hover">
                                                                    <img class="pulse-animation" src="img/icoBookmark1.png" width="22" style="margin-right:5px;" />
                                                                    </button>
                                                                <h6 style="margin-left:5px;">@section.SectionName</h6>
                                                                </button>
                                                            </h4>
                                                            <div id="@collapseId2" class="accordion-collapse @_clpsSP" data-bs-parent="#accordionSections-@notebook.NotebookId">
                                                                <div class="accordion-body" style="background-color:rgba(252,252,252)">
                                                                @if ((appState.Cmd == "cmdEditSection") && (appState.SectionId == section.SectionId))
                                                                    {
                                                                    @* EDIT SECTION *@
                                                                        <div class="d-flex mb-1">
                                                                        <MudTextField @ref="refSectionName"
                                                                                      @bind-Value="section.SectionName"
                                                                                      Label="section"
                                                                                      Variant="Variant.Text"
                                                                                      Margin="Margin.Dense"
                                                                                      Autocomplete="off"
                                                                                      Adornment="Adornment.End"
                                                                                      AdornmentIcon="@Icons.Material.Filled.Save"
                                                                                      OnAdornmentClick="() => BtnUpdateSection(section)"
                                                                                      Style="font-family:tahoma;"
                                                                                      Class="my-textfield" />
                                                                            <button class="btn btn-link pulse-hover" @onclick="() => BtnDeleteSection(section)">
                                                                            <img src="/img/icoDelete1.png" width="22" style="margin-left:20px;margin-top:15px;" title="delete section" />
                                                                            </button>
                                                                            <button class="btn btn-link pulse-hover" @onclick="() => BtnCancel()">
                                                                            <img src="/img/icoCancel.png" width="20" title="cancel" style="margin-top:15px;" />
                                                                            </button>
                                                                        </div>
                                                                    }
                                                                else if ((_cmd == "MoveSectionToNotebook") & (Convert.ToInt32(appState.SectionId) == section.SectionId))
                                                                    {
                                                                    @* MOVE SECTION To A NOTEBOOK *@
                                                                        <div class="d-flex justyfy-content-center align-items-center" style="text-align: left;margin-bottom:15px;">
                                                                            <MudSelect T="int"
                                                                                   @ref="refNotebooks"
                                                                                   Label="move to"
                                                                                   Value="NotebookId"
                                                                                   ValueChanged="OnNotebookChanged"
                                                                                   Class="w-auto my-select"
                                                                                   Variant="Variant.Text"
                                                                                   Margin="Margin.Dense"
                                                                                   Adornment="Adornment.End"
                                                                                   AdornmentIcon="@Icons.Material.Filled.FolderCopy"
                                                                                   OnAdornmentClick="() => BtnSectionMoveToSelectedNotebook(NotebookId, section)"
                                                                                   Style="color:royalblue;width:140px;font-size:small;font-family:tahoma;">
                                                                            <MudSelectItem Value="0">Select a Notebook...</MudSelectItem>
                                                                            @foreach (var notebook in lstNotebooks)
                                                                                {
                                                                                <MudSelectItem Value="@notebook.NotebookId">@notebook.NotebookName</MudSelectItem>
                                                                                }
                                                                            </MudSelect>
                                                                            <button class="btn btn-link pulse-hover" Title="cancel" style="margin-left:20px;" @onclick='() => BtnCancel()'>
                                                                            <img src="/img/icoCancel.png" width="20" />
                                                                            </button>
                                                                        </div>
                                                                    }
                                                                else
                                                                    {
                                                                    @* SECTION BUTTONS *@
                                                                        <div style="text-align:center">
                                                                            <button class="btn btn-link pulse-animation" @onclick="() => BtnCreateNewSectionNote(section)">
                                                                            <img src="/img/icoNewNote3.png" width="24" title="new note" />
                                                                            </button>
                                                                            <button class="btn btn-link pulse-hover" type="button" @onclick="() => BtnEditSection(section.SectionId)">
                                                                            <img src="/img/icoRename.png" width="30" title="edit section" />
                                                                            </button>
                                                                            <button class="btn btn-link pulse-hover" type="button" @onclick="() => BtnReplaceSection(section.SectionId)">
                                                                            <img src="/img/icoMoveToNoteBook.png" width="32" title="move section to another notebook" />
                                                                            </button>
                                                                        </div>
                                                                    @* 2.3 NOTES *@
                                                                    if (section.SectionId == Convert.ToInt32(appState.NoteRefId))
                                                                        {
                                                                        @foreach (Note notex in lstSPNotes)
                                                                            {
                                                                            var _noteDirection = ((notex.NoteTags & 1) == 1) ? "text-end" : "text-start";
                                                                                <div class="mt-3 @_noteDirection">
                                                                                    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 px-0">
                                                                                        <MudCard Class="mx-0">
                                                                                            <MudCardContent Style="background-color:whitesmoke;">
                                                                                                <div class="d-flex align-items-center" style="text-align:center; color:indianred; font-weight:bold;font-size:small">
                                                                                                @if (notex.IsTodo)
                                                                                                    {
                                                                                                    <img class="pulse-hover" src="/img/icoClock2.png" width="20" style="margin-right:7px" />
                                                                                                    @PersianDate(notex.NoteDateTimeDue)
                                                                                                    }
                                                                                                else
                                                                                                    {
                                                                                                    @PersianDate(notex.NoteDateTime)
                                                                                                    }
                                                                                                </div>
                                                                                            <hr />
                                                                                            @if ((_cmd == "MoveNoteToNotebook") & (Convert.ToInt32(appState.NoteId) == notex.NoteId))
                                                                                                {
                                                                                                <h6 style="color:indianred;text-align:center;">replace to:</h6>
                                                                                                @* COMBO Notebooks *@
                                                                                                    <div class="d-flex">
                                                                                                        <MudSelect T="int"
                                                                                                               @ref="refNotebooks"
                                                                                                               Label="Notebook"
                                                                                                               Value="NotebookId"
                                                                                                               ValueChanged="OnNotebookChanged"
                                                                                                               Class="w-auto my-select"
                                                                                                               Variant="Variant.Text"
                                                                                                               Margin="Margin.Dense"
                                                                                                               Style="color:royalblue;width:140px;font-size:small;">
                                                                                                        <MudSelectItem Value="0">Select a Notebook...</MudSelectItem>
                                                                                                        @foreach (var notebook in lstNotebooks)
                                                                                                            {
                                                                                                            <MudSelectItem Value="@notebook.NotebookId">@notebook.NotebookName</MudSelectItem>
                                                                                                            }
                                                                                                        </MudSelect>
                                                                                                    </div>
                                                                                                @* COMBO Sections *@
                                                                                                    <div class="d-flex align-content-center align-items-center align-content-md-center">
                                                                                                        <MudSelect T="int"
                                                                                                               @ref="refSections"
                                                                                                               Label="Section"
                                                                                                               Value="SectionId"
                                                                                                               ValueChanged="OnSectionChanged"
                                                                                                               Class="w-auto my-select"
                                                                                                               Variant="Variant.Text"
                                                                                                               Margin="Margin.Dense"
                                                                                                               Adornment="Adornment.End"
                                                                                                               AdornmentIcon="@Icons.Material.Filled.MoveDown"
                                                                                                               OnAdornmentClick="() => BtnMoveToSelectedSection(SectionId, notex.NoteId)"
                                                                                                               Style="color:royalblue;width:140px;font-size:small;">
                                                                                                        <MudSelectItem Value="0">Select a Section...</MudSelectItem>
                                                                                                        @foreach (var section in lstSections)
                                                                                                            {
                                                                                                            <MudSelectItem Value="@section.SectionId">@section.SectionName</MudSelectItem>
                                                                                                            }
                                                                                                        </MudSelect>
                                                                                                        <button class="btn btn-link pulse-hover" Title="cancel" style="margin-left:20px;" @onclick='() => BtnCancel()'>
                                                                                                        <img src="/img/icoCancel.png" width="20" />
                                                                                                        </button>
                                                                                                    </div>
                                                                                                }
                                                                                            else
                                                                                                {
                                                                                                    <div style="white-space: pre-wrap; font-weight:normal; font-family:'Segoe UI';font-size:small">
                                                                                                    @if (notex.NoteText.Length > 100)
                                                                                                        {
                                                                                                        <div> @notex.NoteText.Substring(0, 100) <span style="font-size:xx-small;font-weight:bold;color:indianred">[...]</span></div>
                                                                                                        }
                                                                                                    else
                                                                                                        {
                                                                                                        <div style="font-weight:normal;font-family:'Segoe UI'"> @notex.NoteText</div>
                                                                                                        }
                                                                                                    </div>
                                                                                                <hr>
                                                                                                @* CMD MENU *@
                                                                                                    <div class="d-flex align-items-center text-start" style="text-align:center; color:indianred; font-weight:bold;font-size:small">
                                                                                                        <MudMenu Label="actions" Variant="Variant.Outlined" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Menu" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Dense="true">
                                                                                                            <MudMenuItem @onclick="() => BtnCopyToStickyNotes(notex, section)">
                                                                                                                <button class="btn btn-link pulse-hover">
                                                                                                                <img src="/img/icoCopyToNoteReport.png" width="26" title="copy to quick note" />
                                                                                                                </button>
                                                                                                            copy to quick notes
                                                                                                            </MudMenuItem>
                                                                                                        <MudDivider />
                                                                                                            <MudMenuItem @onclick="() => BtnReplaceNote(notex.NoteId)">
                                                                                                                <button class="btn btn-link pulse-hover">
