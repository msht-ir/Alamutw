    //methods
    public string PersianDate (DateTimeOffset? dt)
        {
        if ((Convert.ToInt32(appState.UserTags) & 2) == 2)
            {
            return feService.ToPersianDate(dt.ToString());
            }
        else
            {
            return dt?.ToString("yyyy-MM-dd HH:mm");
            }
        }
    private async Task HandleModalClose ()
        {
        _hasFetched = false;
        lstSpecies.Clear();
        //lstSpecies = await feService.Read_Species();
        _hasFetched = true;
        StateHasChanged();
        }
    private async Task RollbackListOfSelectedSpecies ()
        {
        List<Species> lstSelectedSpecies = lstSpecies
            .Where(sp => sp.IsSelected)
            .ToList();
        if (lstSelectedSpecies.Count() == 0)
            {
            Snackbar.Add("select Species from list", Severity.Warning, opt => { opt.VisibleStateDuration = 2000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });

            return;
            }
        else
            {
            await OnSelectedSpeciesReceived.InvokeAsync(lstSelectedSpecies);
            }
        }
    }
