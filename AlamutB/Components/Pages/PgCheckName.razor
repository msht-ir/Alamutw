@page "/PgCheckName"
@using System.Globalization
@using AlamutB.Service
@using System.Threading.Tasks
@inject FeService feService
@inject NavigationManager Navman
@inject AppState appState
@inject IJSRuntime JS
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using ClosedXML.Excel
@using Microsoft.Extensions.Hosting
@using ClosedXML
@using Microsoft.VisualBasic
@using OfficeOpenXml;

<h5 style="text-align:center;padding-left:15px;">CheckName - <span style="font-size:smaller;text-align:center;color:indianred">@appState.UserNickname</span></h5>
<hr style="color:red" />
@if (!_hasFetched)
    {
    <_ScanSheets />
    }
else if (appState.Cmd == "ShowNoteInDialog")
    {
    <Modal_ShowNote OnClose="HandleModalClose" />
    }
else if (appState.Cmd == "cmdCreateNote")
    {
    <Modal_CreateNote />
    }
else
    {
        <div style="text-align: left; margin:15px;">
        <MudIconButton OnClick="BtnBack"
                       Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Title="Switchboard" />
            <button class="btn btn-link pulse-hover" @onclick="BtnAddNewDatasetCN">
            <img src="/img/icoAdd1.png" width="24" />
            </button>
        </div>
        <EditForm Model="lstNotes">
        @* ADD NEW DATASET CN *@
        @if (_cmd == "cmdAddNewDataset")
            {
            <br />
                <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-1 mb-4 px-0">
                    <MudCard Class="mx-0">
                        <MudCardContent Style="background-color:rgba(240,240,240);">
                        @* SHOW COMPONENT *@
                        <CompDataset dataset="dataset" OnClose="CloseComponent" />
                        </MudCardContent>
                    </MudCard>
                </MudContainer>
            }
        <hr style="border-color:red" />
        @* FILTER *@
            <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-0">
                <MudCard Class="mx-0">
                    <MudCardContent Style="background-color:rgba(249,249,249);">
                    <h6 style="text-align:center;color:royalblue">Dataset<span style="font-size:x-small;color:indianred"> ( @lstDatasets.Count() )</span></h6>
                    <hr style="color:indianred" />
                        <div class="d-flex">
                        <MudTextField @ref="refFilterDatasets"
                                      @bind-Value="_datasetFilter"
                                      Label="filter datasets"
                                      Variant="Variant.Text"
                                      Margin="Margin.Dense"
                                      Autocomplete="off"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      OnAdornmentClick="@(() => FilterDatasets (_datasetFilter))"
                                      Class="my-textfield" />
                            <button class="btn btn-link" style="margin-left:20px;" Title="show all" @onclick="BtnShowAllDatasets">
                            <img src="/img/icoList1.png" width="20" />
                            </button>
                        </div>
                    @* LIST DataSets CN *@
                    @foreach (Dataset dataset in lstDatasets)
                        {
                            <div class="d-flex align-items-center mb-1">
                            @* Select *@
                            <input class="form-check-input"
                                   style="margin-left:1px;margin-right:1px;"
                                   type="checkbox"
                                   @bind="dataset.IsSelected" />
                            @* Import *@
                                <button class="btn btn-link" @onclick="() => BtnImportFromExcelFile(dataset.DatasetId)">
                                <img src="/img/icoFileExcel.png" width="20" title="import tests from excel" />
                                </button>
                            @* Edit *@
                                <button type="button"
                                    class="btn btn-link"
                                    style="margin-left:1px"
                                    @onclick='() => BtnEditDatasetCN(dataset)'
                                    Title=@($"edit dataset id: {dataset.DatasetId}")>
                                <img src="/img/icoRename.png" width="24" />
                                </button>
                            @* List taxa *@
                                <button type="button"
                                    class="btn btn-link"
                                    style="margin-left:1px"
                                    @onclick='() => BtnListSpeciesOfDatasetsCN(dataset.DatasetId, true)'
                                    Title=@($"show list of speciesin dataset id: {dataset.DatasetId}")>
                                <img src="/img/icoList1.png" width="22" />
                                </button>
                            @* Note *@
                                <button type="button"
                                    class="btn btn-link"
                                    style="margin-left:1px"
                                    @onclick='() => BtnCreateNoteForDataset(dataset.DatasetId)'
                                    Title=@($"note for dataset id: {dataset.DatasetId}")>
                                <img src="/img/icoNoteStickyAdd.png" width="22" />
                                </button>
                            <span style="font-size:small;font-weight:bold;margin-left:10px;">@dataset.DatasetName</span>
                            &nbsp;
                            <span style="color:indianred;font-size:x-small;font-weight:normal;"> &nbsp; (<span style="color:royalblue;font-size:x-small;font-weight:normal;"> @dataset.DatasetId </span>) </span>
                            </div>
                        @if ((_cmd == "cmdImportDatasetDataCN") && (dataset.DatasetId == _datasetCNId))
                            {
                            <br />
                                <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-1 mb-4 px-0">
                                    <MudCard Class="mx-0">
                                        <MudCardContent Style="background-color:rgba(240,240,240);">
                                            <div>
                                            <span style="font-size:smaller">Import data for: <span style="color:indianred">@dataset.DatasetName</span></span>
                                            <br />
                                            <br />
                                            <InputFile OnChange="HandleFileSelected" title="Refer to Examiner guide for correct Excel format" />
                                            </div>
                                        </MudCardContent>
                                    </MudCard>
                                </MudContainer>
                            }
                        else if (_cmd == "ShowWorksheetNames")
                            {
                            <br />
                                <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 px-0">
                                    <MudCard Class="mx-0">
                                        <MudCardContent Style="background-color:rgba(240,240,240);">
                                        <br />
                                            <div class="d-flex">
                                                <MudSelect T="string"
                                                       @ref="refWorksheets"
                                                       Label="Worksheet"
                                                       Value="WorksheetName"
                                                       ValueChanged="@((string worcksheetname) => OnWorksheetChanged(worcksheetname))"
                                                       Class="w-auto"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       Style="font-size:small;">
                                                @foreach (string ws in lstWorksheets)
                                                    {
                                                    <MudSelectItem Value="@ws">@ws</MudSelectItem>
                                                    }
                                                </MudSelect>
                                                <button class="btn btn-link" Title="import from excel" @onclick="() => ReadExcelAsync()">
                                                <img src="/img/icoGo1.png" width="36" />
                                                </button>
                                            </div>
                                        <br /><br />
                                        <hr />
                                            <div style="text-align:center">
                                                <button class="btn btn-link" style="margin-right:20px;" @onclick="BtnCancel">
                                                <img src="/img/icoCancel.png" width="24" />
                                                </button>
                                            </div>
                                        </MudCardContent>
                                    </MudCard>
                                </MudContainer>
                            }
                        else if ((_cmd == "cmdEditDatasetCN") && (dataset.DatasetId == _datasetCNId))
                            {
                            <br />
                                <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-1 mb-4 px-0">
                                    <MudCard Class="mx-0">
                                        <MudCardContent Style="background-color:rgba(240,240,240);">
                                        @* SHOW COMPONENT *@
                                        <CompDataset dataset="dataset" OnClose="CloseComponent" />
                                        </MudCardContent>
                                    </MudCard>
                                </MudContainer>
                            }

                        @if (_cmd == "cmdViewDataset")
                            {

                            }
                        else if ((_cmd == "cmdListDatasetData") && (dataset.DatasetId == _datasetId))
                            {
                            @* LIST SPECIES *@
                                <MudCard Class="mx-0">
                                    <MudCardContent Style="background-color:rgba(240,240,240);">
                                    <h6 style="text-align:center;color:royalblue">Species <span style="font-size:x-small;color:indianred"> ( @lstSpecies.Count() )</span></h6>
                                    <hr style="color:indianred" />
                                    @* Filter *@
                                        <div class="d-flex">
                                        <MudTextField @ref="refFilterSpeciesList"
                                                      @bind-Value="_speciesListFilter"
                                                      Label="filter species"
                                                      Variant="Variant.Text"
                                                      Margin="Margin.Dense"
                                                      Immediate="true"
                                                      Adornment="Adornment.End"
                                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                                      OnAdornmentClick='@(() => FilterSpeciesList(_speciesListFilter))'
                                                      Class="my-textfield" />
                                        @* Refresh List of Taxa *@
                                            <button type="button"
                                                class="btn btn-link"
                                                style="margin-left:1px"
                                                @onclick='() => BtnListSpeciesOfDatasetsCN(dataset.DatasetId, false)'
                                                Title="Show sub-Species">
                                            <img src="/img/icoList1.png" width="22" />
                                            </button>
                                        </div>
                                    @foreach (Species species in lstSpecies)
                                        {
                                            <div class="d-flex align-items-center mb-1" style=" margin-left:40px;">
                                            <input class="form-check-input"
                                                   style="margin-left:1px;margin-right:1px;"
                                                   type="checkbox"
                                                   @bind="species.IsSelected" />
                                                <button type="button"
                                                    class="btn btn-link"
                                                    style="margin-left:1px"
                                                    @onclick='() => BtnShowSubspecies(species)'
                                                    Title="Show sub-Species">
                                                <img src="/img/icoList1.png" width="24" />
                                                </button>
                                                <button type="button"
                                                    class="btn btn-link"
                                                    style="margin-left:1px"
                                                    @onclick='() => BtnCreateNoteForSpecies(species.SpeciesId)'
                                                    Title="Note for Species">
                                                <img src="/img/icoNoteStickyAdd.png" width="22" />
                                                </button>
                                            <span style="font-size:smaller">@species.SciName </span>
                                            <span style="font-size:smaller;color:forestgreen">&nbsp; @((species.NomStatus == 1) ? " -- valid " : "") </span>
                                            <span style="font-size:smaller;color:darkgoldenrod">&nbsp; @((species.TaxStatus == 1) ? " -- accepted " : "") </span>
                                            </div>
                                        }
                                    @* Close the List (BOTTOM) *@
                                        <button class="btn btn-link pulse-hover" @onclick="CloseSpeciesList">
                                        <img src="/img/icoGotoTop2.png" width="32" />
                                        </button>
                                    </MudCardContent>
                                </MudCard>
                            }
                        }
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        <br />
        <br />
        @* FOOTER *@
            <div class="gap-4" style="display: flex;  justify-content: center; align-items: center;">
            <MudIconButton OnClick="BtnBack"
                           Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Title="Switchboard" />
            <MudIconButton OnClick="BtnHelp"
                           Icon="@Icons.Material.Filled.HelpCenter"
                           Color="Color.Tertiary"
                           Size="Size.Large"
                           Title="Help" />
                <button class="btn btn-link pulse-hover" @onclick="ScrollToTop">
                <img src="/img/icoGotoTop2.png" width="32" />
                </button>
            </div>
        </EditForm>
    <br />
    <br />

        <script>
        window.scrollToTop = () => { window.scrollTo({ top: 0, behavior: 'smooth' }); };
        </script>
        <script>
        function showLoading() {
            document.getElementById("loadingOverlay").style.display = "block";
            document.querySelectorAll("button").forEach(btn => btn.disabled = true);
        }
        </script>
        <script>
        document.getElementById("txtSearch").focus();
        </script>
        <script>
        window.addEventListener('load', () => { window.scrollTo({ top: 0, behavior: 'smooth' }); });
        </script>
    }

