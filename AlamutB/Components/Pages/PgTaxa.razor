    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        appState.SetMessage("");
        if (Convert.ToInt32(appState.UserLoginStatus) != 1)
            {
            Navman.NavigateTo("/Login");
            }
        //on second rener, user.UserId will get its value
        lstApgGroups = await feService.Read_ApgGroups();
        int userId = Convert.ToInt32(appState.UserId);
        //lstDatasetsLM = await feService.Read_Datasets(userId);
        _hasFetched = true;
        }
    protected override async Task OnAfterRenderAsync (bool firstRender)
        {
        }
    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }
    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }
    //ApgGroup
    private async Task OnApgGroupChanged (int newValue)
        {
        var oldValue = _apgGroupId;
        _apgGroupId = newValue;
        if (_apgGroupId != 0)
            {
            lstOrders = await feService.Read_Orders(_apgGroupId);
            }
        StateHasChanged();
        }
