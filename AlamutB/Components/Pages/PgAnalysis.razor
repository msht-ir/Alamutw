@page "/PgAnalysis"
@using System.Globalization
@using AlamutB.Service
@using System.Threading.Tasks
@inject FeService feService
@inject NavigationManager Navman
@inject AppState appState
@inject IJSRuntime JS
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="d-flex" style="display: flex; flex-direction: column; justify-content: center; align-items: center;">
    <h2 style="color:royalblue; font-style:italic">Analyses</h2>
    <span style="font-size:smaller;text-align:center;color:indianred">@appState.UserNickname</span>
    </div>
<hr style="color:red" />
@if (!_hasFetched)
    {
    <_ScanSheets />
    }
else if (appState.Cmd == "cmdCreateNote")
    {
    <Modal_CreateNote />
    }
else
    {
        <div style="text-align: left; margin:10px;">
        <MudIconButton OnClick="BtnBack"
                       Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Title="Switchboard" />
        </div>
    <hr />
        <EditForm Model="user">
            <MudStack Row
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Start"
                  Style="width:980px;"
                  Breakpoint="Breakpoint.SmAndDown">
            @* Pannel Left *@
                <MudStack>
                <MudText Style="color:indianred;">Analyses</MudText>
                    <MudToggleGroup T="String"
                                SelectionMode="SelectionMode.SingleSelection"
                                @bind-Value="_analysis"
                                @bind-Value:after="() => BtnAnalysisSelected(_analysis)"
                                Color="Color.Primary"
                                CheckMark FixedContent Vertical>
                    <MudToggleItem Value=@("fvalue")
                                   SelectedIcon="@Icons.Material.Outlined.Functions"
                                   Text="F-Value" />
                    <MudToggleItem Value=@("diversity")
                                   SelectedIcon="@Icons.Material.Outlined.InsertChart"
                                   Text="Diversity" />
                    <MudToggleItem Value=@("floran")
                                   SelectedIcon="@Icons.Material.Outlined.Grass"
                                   Text="FlorAn" />
                    <MudToggleItem Value=@("multivarfloran")
                                   SelectedIcon="@Icons.Material.Outlined.Window"
                                   Text="MultiFlorAn" />
                    <MudToggleItem Value=@("comparesets")
                                   SelectedIcon="@Icons.Material.Outlined.JoinLeft"
                                   Text="Compare Sets" />
                    <MudToggleItem Value=@("cooccurence")
                                   SelectedIcon="@Icons.Material.Outlined.Dashboard"
                                   Text="Cooccurence" />
                    <MudToggleItem Value=@("climagraph")
                                   SelectedIcon="@Icons.Material.Outlined.Cloud"
                                   Text="ClimaGraph" />
                    <MudToggleItem Value=@("multivarcliman")
                                   SelectedIcon="@Icons.Material.Outlined.Window"
                                   Text="MultivarClimAn" />
                    <MudToggleItem Value=@("help")
                                   SelectedIcon="@Icons.Material.Filled.Search"
                                   Text="Guide" />
                    <MudToggleItem Value=@("back")
                                   Text="Back to Menu"
                                   Style="color:indianred" />
                    </MudToggleGroup>
                </MudStack>
            @* Pannel Right *@
                <MudStack Style="width:740px;margin-top:30px">
                @if (_cmd == "help")
                    {
                    <CompInfoTech />
                    }
                else if ((_cmd == "fvalue") || (_cmd == "floran") || (_cmd == "diversity") || (_cmd == "comparesets") || (_cmd == "multivarfloran"))
                    {
                    <CompAnalysisSets OnSelectedSetsReceived="GetSelectedSetsFromComponent" />
                    }
                else if (_cmd == "cooccurence")
                    {
                    }
                else if ((_cmd == "climagraph") || (_cmd == "multivarcliman"))
                    {
                    }
                else if (_cmd == "")
                    {
                        <div class="d-flex justify-content-center">
                        <img src="/img/gifUserLogin.gif" width="52" />
                        </div>
                    }
                else if (_cmd == "ShowCalcDiversityResults")
                    {
                    <CompAnalysisDiversityResults lstSelectedDatasets="lstSelectedDatasets" lstDiversities="lstDiversities" OnAnalysisDiversityResultsClosed="BtnCloseAnalysisDiversityResults" />
                    }
                else if (_cmd == "ShowFloristicValueStatsResults")
                    {
                    <CompAnalysisFVResults lstSelectedDatasets="lstSelectedDatasets" FVStats="FVStats" OnAnalysisFVResultsClosed="BtnCloseAnalysisFVResults" />
                    }
                </MudStack>
            </MudStack>
        </EditForm>
    <br />
    <hr />
        <div class="gap-4" style="display: flex;  justify-content: center; align-items: center;">
        <MudIconButton OnClick="BtnBack"
                       Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Title="Switchboard" />
            <button class="btn btn-link pulse-hover" @onclick="ScrollToTop">
            <img src="/img/icoGotoTop2.png" width="32" />
            </button>
        </div>
    }
    <script>
    window.scrollToTop = () => { window.scrollTo({ top: 0, behavior: 'smooth' }); };
    </script>


@code {
    private string _analysis = "";
    User user = new User();

    public MudTextField<string> refFilterDatasets;
    public List<Set> lstSelectedSets = new List<Set>();
    public List<Dataset> lstSelectedDatasets = new List<Dataset>();
    public List<Species> lstSelectedSpecies = new List<Species>();
    public List<Diversity> lstDiversities = new List<Diversity>();
    public FV FVStats = new FV();

    Set set = new Set();
    Dataset dataset = new Dataset();
    Species species = new Species();
    Diversity diversity = new Diversity();

    string _cmd = "";
    public bool _hasFetched = false;

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
    {
        appState.OnChange += TriggerRender;
        if (Convert.ToInt32(appState.UserLoginStatus) != 1)
        {
            Navman.NavigateTo("/Login");
        }
        appState.SetCmd("");
        user.UserId = Convert.ToInt32(appState.UserId);
        user.Username = appState.Username;
        _hasFetched = true;
    }
    private void TriggerRender ()
    {
        InvokeAsync(StateHasChanged);
    }
    public void Dispose ()
    {
        appState.OnChange -= TriggerRender;
    }

    //btns
    public void BtnAnalysisSelected (string _analysisName)
    {
        if (_analysisName == "back")
        {
            BtnBack();
        }
        else
        {
            _cmd = _analysisName;
            StateHasChanged();
        }
    }

    //rollbacks
    public async Task GetSelectedSetsFromComponent (List<Set> lstSelectedSets)
    {
        switch (_cmd)
        {
            case "diversity":
                {
                    _hasFetched = false;
                    lstDiversities.Clear();
                    lstDiversities = await feService.Calc_Diversity(lstSelectedSets [0].SetId, lstSelectedSets [0].SelectedSubset);
                    //get distinct list of Datasets from DatasetA and DatasetB
                    lstSelectedDatasets = lstDiversities
                        .Select(x => new Dataset
                            {
                            DatasetId = x.DatasetIdA,
                            DatasetName = x.DatasetNameA,
                            //set as default
                            UserId = 0,
                            DatasetType = 0,
                            DatasetAbbr = "",
                            DatasetRef = "",
                            RefYear = 0,
                            RefLang = "",
                            DatasetManager = "",
                            AreaHa = 0,
                            ProvinceId = 0,
                            Coords = "",
                            AltMax = 0,
                            AltMin = 0,
                            AltAver = 0,
                            TempMax = 0,
                            TempMin = 0,
                            TempAver = 0,
                            Precipitation = 0,
                            DatasetTags = 0,
                            IsSelected = false
                            })
                        .Union(lstDiversities.Select(x => new Dataset
                            {
                            DatasetId = x.DatasetIdB,
                            DatasetName = x.DatasetNameB,
                            //set as default
                            UserId = 0,
                            DatasetType = 0,
                            DatasetAbbr = "",
                            DatasetRef = "",
                            RefYear = 0,
                            RefLang = "",
                            DatasetManager = "",
                            AreaHa = 0,
                            ProvinceId = 0,
                            Coords = "",
                            AltMax = 0,
                            AltMin = 0,
                            AltAver = 0,
                            TempMax = 0,
                            TempMin = 0,
                            TempAver = 0,
                            Precipitation = 0,
                            DatasetTags = 0,
                            IsSelected = false
                            }))
                        .DistinctBy(x => x.DatasetId) //distinct
                        .ToList();
                    _hasFetched = true;
                    _cmd = "ShowCalcDiversityResults";
                    break;
                }
            case "fvalue":
                {
                    _hasFetched = false;
                    lstSelectedDatasets = await feService.Read_DatasetsBySubsetIndex(lstSelectedSets [0].SetId, lstSelectedSets [0].SelectedSubset);
                    FVStats = await feService.Get_FloristicValueStats(lstSelectedSets [0].SetId, lstSelectedSets [0].SelectedSubset);
                    appState.SetSetName(lstSelectedSets [0].SetName);
                    _hasFetched = true;
                    _cmd = "ShowFloristicValueStatsResults";
                    break;
                    }
            case "floran":
                    {
                    Snackbar.Add($"selcted Sets received for floran!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            case "comparesets":
                    {
                    Snackbar.Add($"selcted Sets received for comparesets!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            case "multivarfloran":
                    {
                    Snackbar.Add($"selcted Sets received for multivarfloran!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            case "cooccurence":
                    {
                    Snackbar.Add($"selcted Sets received for cooccurence!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            case "climagraph":
                    {
                    Snackbar.Add($"selcted Sets received for climagraph!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            case "multivarcliman":
                    {
                    Snackbar.Add($"selcted Sets received for multivarcliman!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            default:
                    {
                    Snackbar.Add($"selcted Sets received for ??!", Severity.Info, opt => { opt.VisibleStateDuration = 1000; opt.ShowTransitionDuration = 300; opt.HideTransitionDuration = 300; });
                    break;
                    }
            }
        }
    private void BtnCloseAnalysisDiversityResults ()
        {
        _cmd = "diversity";
        StateHasChanged();
        }
    private void BtnCloseAnalysisFVResults ()
        {
        _cmd = "fvalue";
        StateHasChanged();
        }

    //methods
    private async Task ScrollToTop ()
        {
        await JS.InvokeVoidAsync("scrollToTop");
        }
    public string PersianDate (DateTimeOffset? dt)
        {
        if ((Convert.ToInt32(appState.UserTags) & 256) == 256)
            {
            return feService.ToPersianDate(dt.ToString());
            }
        else
            {
            return dt?.ToString("yyyy-MM-dd HH:mm");
            }
        }
    public void BtnHelp ()
        {
        _cmd = _cmd == "help" ? "" : "help";
        StateHasChanged();
        }
    private void BtnCancel ()
        {
        _cmd = "";
        StateHasChanged();
        }
    public void BtnBack ()
        {
        Navman.NavigateTo("/Switchboard");
        }
    }
