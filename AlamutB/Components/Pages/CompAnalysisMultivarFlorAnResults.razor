@code {
    [Parameter]
    public List<Dataset>? lstSelectedDatasets
        {
        get; set;
        }
    [Parameter]
    public List<Occurrence>? lstOccurrenceData
        {
        get; set;
        }
    [Parameter]
    public EventCallback<bool> OnAnalysisFlorAnResultsClosed
        {
        get; set;
        }
    User user = new User();
    public bool _hasFetched = false;
    string _cmd = "";

    //LifeCycleEvents
    protected override async Task OnInitializedAsync ()
        {
        appState.OnChange += TriggerRender;
        appState.SetCmd("");
        user.UserId = Convert.ToInt32(appState.UserId);
        user.Username = appState.Username ?? "";
        _hasFetched = true;
        }
    private void TriggerRender ()
        {
        InvokeAsync(StateHasChanged);
        }
    public void Dispose ()
        {
        appState.OnChange -= TriggerRender;
        }
    //Clacs
    private async Task DownloadRScript (string _scryptType)
        {
        //1 get data: lstOccurrenceData is already passes as [parameter]
        //2 build RawMatrix - species / dataset indexing 
        var speciesIds = lstOccurrenceData
            .Select(o => o.SpeciesId)
            .Distinct(StringComparer.Ordinal)
            .OrderBy(s => s, StringComparer.Ordinal)
            .ToList();
        var datasetIds = lstOccurrenceData
            .Select(o => o.DatasetId)
            .Distinct()
            .OrderBy(id => id)
            .ToList();
        var speciesIndex = speciesIds
            .Select((id, idx) => (id, idx))
            .ToDictionary(t => t.id, t => t.idx, StringComparer.Ordinal);
        var datasetIndex = datasetIds
            .Select((id, idx) => (id, idx))
            .ToDictionary(t => t.id, t => t.idx);
        int [,] RawMatrix = new int [speciesIds.Count, datasetIds.Count];
        foreach (var occ in lstOccurrenceData)
            {
            int i = speciesIndex [occ.SpeciesId];
            int j = datasetIndex [occ.DatasetId];
            RawMatrix [i, j] = 1;
            }
        //build aligned per-dataset metadata (key=DatasetId)
        var datasetInfo = lstSelectedDatasets
            .Where(d => datasetIndex.ContainsKey(d.DatasetId))
            .OrderBy(d => d.DatasetId)
            .Select(d => new
                {
                d.DatasetId,
                DatasetName = string.IsNullOrWhiteSpace(d.DatasetName) ? "Na" : d.DatasetName,
                CountryId = d.CountryId, //int
                ProvinceName = string.IsNullOrWhiteSpace(d.ProvinceName) ? "" : d.ProvinceName
                })
            .ToList();
        //fallback: patch datasets present in occurrences but missing from lstSelectedDatasets
        if (datasetInfo.Count != datasetIds.Count)
            {
            var known = new HashSet<int>(datasetInfo.Select(d => d.DatasetId));
            foreach (var id in datasetIds.Where(id => !known.Contains(id)))
                {
                var occ = lstOccurrenceData.First(o => o.DatasetId == id);
                datasetInfo.Add(new
                    {
                    DatasetId = id,
                    DatasetName = string.IsNullOrWhiteSpace(occ.DatasetName) ? "Na" : occ.DatasetName,
                    CountryId = 0,        //sentinel for unknown
                    ProvinceName = ""     //empty string
                    });
                }
            datasetInfo = datasetInfo.OrderBy(d => d.DatasetId).ToList();
            }
        //extract aligned lists
        var datasetLabels = datasetInfo.Select(d => d.DatasetName).ToList();
        var countryIds = datasetInfo.Select(d => d.CountryId).ToList();         //List<int>
        var provinceNames = datasetInfo.Select(d => d.ProvinceName).ToList();   //List<string>
        //4 Build R-script
        string _strScript = "";
        switch (_scryptType)
            {
            case "cluster":
                    {
                    _strScript = BuildRScript_Cluster(RawMatrix, speciesIds, datasetLabels);
                    await JS.InvokeVoidAsync("downloadTextFile", "RScript_Cluster.R", "text/plain;charset=utf-8", _strScript);
                    break;
                    }
            case "kmeans":
                    {
                    break;
                    }
            case "heatmap":
                    {
                    _strScript = BuildRScript_Heatmap(RawMatrix, speciesIds, datasetLabels);
                    await JS.InvokeVoidAsync("downloadTextFile", "RScript_Heatmap.R", "text/plain;charset=utf-8", _strScript);
                    break;
                    }
            case "pca":
                    {
                    _strScript = BuildRScript_PCA(RawMatrix, speciesIds, datasetLabels, countryIds, provinceNames);
                    await JS.InvokeVoidAsync("downloadTextFile", "RScript_PCA.R", "text/plain;charset=utf-8", _strScript);
                    break;
                    }
            case "pcoa":
                    {
                    _strScript = BuildRScript_PCOA(RawMatrix, speciesIds, datasetLabels, countryIds, provinceNames);
                    await JS.InvokeVoidAsync("downloadTextFile", "RScript_PCoA.R", "text/plain;charset=utf-8", _strScript);
                    break;
                    }
            case "nmds":
                    {
                    break;
                    }
            case "fga":
                    {
                    break;
                    }
            case "speciesrichness":
                    {
                    break;
                    }
            case "speciesareacurve":
                    {
                    break;
                    }
            case "diversity":
                    {
                    break;
                    }
            default:
                    {
                    return;
                    }
            }
        }
    public static string BuildRScript_Cluster (int [,] RawMatrix, IReadOnlyList<string> speciesIds, IReadOnlyList<string> datasetLabels)
        {
        int nSpecies = RawMatrix.GetLength(0);
        int nDatasets = RawMatrix.GetLength(1);
        var sb = new StringBuilder();
        sb.AppendLine("# Auto-generated by Alamut.MultiFlorAn");
        sb.AppendLine("# Rows of RawMatrix = species, columns = datasets.");
        sb.AppendLine();
        //dataset labels (used later as row names of M)
        sb.Append("DSn = c(");
        for (int j = 0; j < nDatasets; j++)
            {
            sb.Append('"').Append(Escape(datasetLabels [j])).Append('"');
            if (j < nDatasets - 1)
                sb.Append(", ");
            }
        sb.AppendLine(")");
        sb.AppendLine();
        for (int j = 0; j < nDatasets; j++)
            {
            sb.Append("DS").Append(j + 1).Append(" = c(");
            for (int i = 0; i < nSpecies; i++)
                {
                sb.Append(RawMatrix [i, j]);
                if (i < nSpecies - 1)
                    {
                    sb.Append(", ");
                    //break line every 200 values
                    if ((i + 1) % 200 == 0)
                        {
                        sb.AppendLine();
                        }
                    }
                }
            sb.AppendLine(")");
            }
        sb.AppendLine();
        //stack datasets as rows of M
        sb.Append("M = rbind(");
        for (int j = 0; j < nDatasets; j++)
            {
            sb.Append("DS").Append(j + 1);
            if (j < nDatasets - 1)
                sb.Append(", ");
            }
        sb.AppendLine(")");
        sb.AppendLine();
        //give the rows meaningful names so the dendrogram is readable
        sb.AppendLine("rownames(M) = DSn");
        sb.AppendLine();
        //analysis
        sb.AppendLine("DF = data.frame(M)");
        sb.AppendLine("DistDF = dist(DF, method = 'binary')");
        sb.AppendLine();
        sb.AppendLine("DFClust1 <- hclust(DistDF, 'single')");
        sb.AppendLine("DFClust2 <- hclust(DistDF, 'complete')");
        sb.AppendLine("DFClust3 <- hclust(DistDF, 'average')");
        sb.AppendLine("DFClust4 <- hclust(DistDF, 'centroid')");
        sb.AppendLine();
        sb.AppendLine($"pdf('RScript_Cluster.pdf')");
        sb.AppendLine("par(mfrow = c(2, 2))");
        sb.AppendLine("plot(DFClust1, hang = -1, main = 'single', cex = 0.5)");
        sb.AppendLine("plot(DFClust2, hang = -1, main = 'complete', cex = 0.5)");
        sb.AppendLine("plot(DFClust3, hang = -1, main = 'average', cex = 0.5)");
        sb.AppendLine("plot(DFClust4, hang = -1, main = 'centroid', cex = 0.5)");
        sb.AppendLine("dev.off()");
        return sb.ToString();
        }
