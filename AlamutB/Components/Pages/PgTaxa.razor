    private async Task BtnAddSelectedSpeciesToDatasetLM (int datasetLMId)
        {
        int counter = 0;
        if (datasetLMId != 0)
            {
            foreach (Species spc in lstSpecies)
                {
                if (spc.IsSelected)
                    {
                    DatasetDataLM datasetDataLM = new DatasetDataLM()
                        {
                        DatasetDataLMId = 0,
                        DatasetId = datasetLMId,
                        SpeciesId = spc.SpeciesId
                        };
                    bool results = await feService.Create_DatasetDataLM(datasetDataLM);
                    counter++;
                    }
                }
            Snackbar.Add($"{@counter} items added to the dataset", Severity.Success);
            lstSpecies = await feService.Read_SpeciesByDatasetId(3, datasetLMId);
            _SpeciesListType = "Dataset";
            StateHasChanged();
            }
        else
            {
            Snackbar.Add("Select a Dataset", Severity.Warning);
            }
        }
